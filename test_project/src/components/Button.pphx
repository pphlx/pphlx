<template name="Button">
    <a href="{{href ?? '#'}}" class="btn btn-{{style ?? 'primary'}} {{class ?? ''}}">
        {{label ?? 'Button'}}
    </a>
</template>

<style>
    .btn {
        display: inline-block;
        padding: 8px 16px;
        font-size: 14px;
        border-radius: 4px;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
    }
    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: 1px solid #007bff;
    }
    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: 1px solid #6c757d;
    }
</style>

<script>
    console.log("Button ready!");
</script>
