@import Layout from '../components/ThemeLayout'
@import FeedbackCard from '../components/FeedbackCard'
@import TempConverter from '../components/TempConverter.vue'
@import InterestCalculator from '../components/InterestCalculator.svelte'
@import SolidStopwatch from '../components/SolidStopwatch.solid.jsx'
@import PreactCart from '../components/PreactCart.js'

{|
// Simulate database query results (Backend PHP Fuel)
$serverStartTime = date('Y-m-d H:i:s');
$reactTitle = "React Emojis Feedback (DB Fueled)";

$vueLabel = "Vue 3 Temperature Converter (DB Injected)";
$vueDefaultTemp = 28; // Injected default from DB configuration

$svelteLabel = "Svelte 4 Retirement growth (DB Principal)";
$sveltePrincipal = 4500; // Loaded from user's financial profile in DB
$svelteRate = 7.5;       // Current market interest rate in DB
$svelteYears = 12;       // Target duration from user settings

$solidLabel = "SolidJS Stopwatch (Telemetry Session)";
$preactPrice = 34.99;    // Loaded from product database pricing table

$alpineFaqQuestion = "How does PPHLX Monolithic integration work?";
$alpineFaqAnswer = "PPHLX compiles down to standard native PHP and vanilla CSS/JS. It can be dropped directly inside WHMCS, WordPress, or Laravel monoliths, consuming active database connections and sessions seamlessly.";

$angularDefaultName = "Enterprise Admin User";
$vanillaStartBg = "#1e293b";
|}

<Layout>
    <div class="info-page max-w-5xl mx-auto p-6 font-sans text-white">
        <h1 class="text-4xl font-extrabold text-blue-500 mb-2">PPHLX Ultimate Multi-Framework Showcase</h1>
        <p class="text-gray-400 mb-8">This page demonstrates the concurrent execution and client-side hydration of 11 distinct frontend and backend technologies running side-by-side on a single PHP monolithic thread.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- 1. PHP Server Card -->
            <div class="p-6 border border-blue-600 rounded-lg bg-gray-900 shadow-md">
                <h3 class="text-xl font-bold text-blue-500 mb-3">1. PHP Server-Side Card</h3>
                <p class="text-gray-300">Server startup: <strong class="text-white">{|= $serverStartTime |}</strong></p>
                <p class="text-gray-300">PHP Engine: <strong class="text-white">{|= phpversion() |}</strong></p>
                <p class="text-gray-300">Active Protocol: <strong class="text-white">{|= $_SERVER['SERVER_PROTOCOL'] |}</strong></p>
            </div>

            <!-- 2. Tailwind CSS Styled Card -->
            <div class="rounded-lg border border-purple-500 bg-gray-900 p-6 shadow-md">
                <div class="flex flex-col items-center">
                    <div class="w-16 h-16 rounded-full bg-purple-500 flex items-center justify-center text-white text-2xl font-bold mb-3 shadow-lg">
                        PX
                    </div>
                    <h5 class="text-lg font-bold text-purple-400 mb-1">2. Tailwind CSS Styling</h5>
                    <span class="text-xs text-gray-400">Pure Utility Layout Card</span>
                    <div class="flex mt-4 space-x-3">
                        <a href="#" class="px-3 py-1.5 text-xs font-semibold text-white bg-purple-600 rounded hover:bg-purple-700 transition">Docs</a>
                        <a href="#" class="px-3 py-1.5 text-xs font-semibold text-gray-300 border border-gray-600 rounded hover:bg-gray-700 transition">GitHub</a>
                    </div>
                </div>
            </div>

            <!-- 3. React Interactive Card -->
            <FeedbackCard title="{|= $reactTitle |}" client:load />

            <!-- 4. Vue 3 Converter SFC Card -->
            <TempConverter label="{|= $vueLabel |}" initialValue="{|= $vueDefaultTemp |}" client:load />

            <!-- 5. Svelte 4 Interest Calculator Card -->
            <InterestCalculator label="{|= $svelteLabel |}" principal="{|= $sveltePrincipal |}" rate="{|= $svelteRate |}" years="{|= $svelteYears |}" client:load />

            <!-- 6. SolidJS High-Fidelity Timer Card -->
            <SolidStopwatch label="{|= $solidLabel |}" client:load />

            <!-- 7. Preact Class Component Card -->
            <PreactCart price="{|= $preactPrice |}" client:load />

            <!-- 8. AlpineJS Directives Card -->
            <div class="p-6 border border-pink-600 rounded-lg bg-gray-900 shadow-md" x-data="{ open: false }">
                <h3 class="text-xl font-bold text-pink-500 mb-3">8. Alpine.js Accordion</h3>
                <button @click="open = !open" class="px-4 py-2 bg-pink-700 hover:bg-pink-800 text-white font-semibold rounded text-xs transition">
                    Toggle Panel
                </button>
                <div x-show="open" x-transition class="mt-4 p-3 border-l-4 border-pink-500 bg-gray-800 text-gray-300 text-sm">
                    <p class="font-bold text-white mb-2">{|= $alpineFaqQuestion |}</p>
                    <p>{|= $alpineFaqAnswer |}</p>
                </div>
            </div>

            <!-- 9. AngularJS Dynamic Binds Card -->
            <div class="p-6 border border-red-600 rounded-lg bg-gray-900 shadow-md" ng-app ng-init="name='{|= $angularDefaultName |}'">
                <h3 class="text-xl font-bold text-red-500 mb-3">9. AngularJS Data Binder</h3>
                <label class="text-xs text-gray-400 block mb-1">Enter your greeting name:</label>
                <input type="text" ng-model="name" class="w-full bg-gray-800 border border-gray-700 text-white p-2 rounded text-sm focus:outline-none mb-3" />
                <p class="text-sm font-semibold text-gray-300">
                    Hello, <span class="text-red-400 font-bold">{{name}}</span>! Bounded directly by AngularJS.
                </p>
            </div>

            <!-- 10. Vanilla HTML/JS/CSS Card -->
            <div id="vanilla-color-card" class="p-6 border border-yellow-500 rounded-lg bg-gray-900 shadow-md transition-colors duration-300" style="background-color: {|= $vanillaStartBg |};">
                <h3 class="text-xl font-bold text-yellow-500 mb-3">10. Vanilla JS/CSS Color Card</h3>
                <p class="text-sm text-gray-300 mb-4">Click below to change this card's background color dynamically via native browser DOM API listener.</p>
                <button id="vanilla-color-btn" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-black font-bold rounded text-xs transition">
                    Change Color
                </button>
            </div>

        </div>
    </div>

    <!-- Vanilla Javascript to support Card 10 Color changes -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const card = document.getElementById("vanilla-color-card");
            const btn = document.getElementById("vanilla-color-btn");
            if (btn && card) {
                btn.addEventListener("click", () => {
                    const randomColor = "#" + Math.floor(Math.random()*16777215).toString(16);
                    card.style.backgroundColor = randomColor;
                });
            }
        });
    </script>
</Layout>
