@import Layout from 'layouts/Layout.pphx'
@import FeedbackCard from 'components/FeedbackCard.jsx'
@import TempConverter from 'components/TempConverter.vue'
@import InterestCalculator from 'components/InterestCalculator.svelte'
@import SolidStopwatch from 'components/SolidStopwatch.solid.jsx'
@import PreactCart from 'components/PreactCart.js'
@import R3FLogo from 'components/R3FLogo.jsx'
@import ThrelteLogo from 'components/ThrelteLogo.svelte'
@import TresJSLogo from 'components/TresJSLogo.vue'

{|
// Simulate database query results (Backend PHP Fuel)
$serverStartTime = date('Y-m-d H:i:s');
$reactTitle = "Emojis Feedback (DB Fueled)";

$vueLabel = "Temperature Converter (DB Injected)";
$vueDefaultTemp = 28; // Injected default from DB configuration

$svelteLabel = "Retirement growth (DB Principal)";
$sveltePrincipal = 4500; // Loaded from user's financial profile in DB
$svelteRate = 7.5;       // Current market interest rate in DB
$svelteYears = 12;       // Target duration from user settings

$solidLabel = "Stopwatch (Telemetry Session)";
$preactPrice = 34.99;    // Loaded from product database pricing table

$alpineFaqQuestion = "How does PPHLX Monolithic integration work?";
$alpineFaqAnswer = "PPHLX compiles down to standard native PHP and vanilla CSS/JS. It can be dropped directly inside WHMCS, WordPress, or Laravel monoliths, consuming active database connections and sessions seamlessly.";

$angularDefaultName = "Enterprise Admin User";
$vanillaStartBg = "#1e293b";
|}

<Layout>
    <div class="info-page max-w-5xl mx-auto px-2 py-6 md:p-6 font-sans text-white">
        <h1 class="text-4xl font-extrabold text-blue-500 mb-2">PPHLX Ultimate Multi-Framework Showcase</h1>
        <p class="text-gray-400 mb-8">This page demonstrates the concurrent execution and client-side hydration of 26 distinct frontend and backend technologies running side-by-side on a single PHP monolithic thread.</p>

        <style>
            .masonry-item {
                width: 100% !important;
                transition: transform 0.2s ease, opacity 0.2s ease;
            }
            .masonry-item h3, .masonry-item h5 {
                cursor: grab;
            }
            .masonry-item h3:active, .masonry-item h5:active {
                cursor: grabbing;
            }

            /* Responsive columns for devices >= 768px */
            @media (min-width: 768px) {
                .masonry-grid {
                    flex-direction: row !important;
                }
                .masonry-column {
                    width: 50% !important;
                }
            }
        </style>

        <!-- Custom Premium Modal -->
        <div id="custom-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300">
            <div class="bg-[#0f1115] border border-blue-500/40 rounded-2xl p-6 max-w-sm w-full mx-4 shadow-[0_0_50px_rgba(59,130,246,0.3)] transform scale-90 transition-all duration-300" id="modal-content">
                <h4 class="text-xl font-bold text-blue-400 mb-2" id="modal-title">Notification</h4>
                <p class="text-sm text-gray-300 mb-6" id="modal-message">Message body goes here.</p>
                <div class="flex justify-end">
                    <button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-xs transition" onclick="closeModal()">Dismiss</button>
                </div>
            </div>
        </div>

        <!-- Masonry Container holding the flat serial cards -->
        <div class="masonry-grid flex flex-col md:flex-row gap-6 w-full items-start">
            
            <!-- Column 1 & 2 targets for dynamic layout -->
            <div class="flex flex-col gap-6 w-full md:w-1/2 masonry-column" id="masonry-col-1"></div>
            <div class="flex flex-col gap-6 w-full md:w-1/2 masonry-column" id="masonry-col-2"></div>

            <!-- 1. PHP Server Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-blue-600 rounded-lg bg-gray-900 shadow-md">
                    <h3 class="text-xl font-bold text-blue-500 mb-3 select-none">1. PHP Server-Side Card</h3>
                    <p class="text-gray-300">Server startup: <strong class="text-white">{|= $serverStartTime |}</strong></p>
                    <p class="text-gray-300">PHP Engine: <strong class="text-white">{|= phpversion() |}</strong></p>
                    <p class="text-gray-300">Active Protocol: <strong class="text-white">{|= $_SERVER['SERVER_PROTOCOL'] |}</strong></p>
                </div>
            </div>

            <!-- 2. Tailwind CSS Styled Card -->
            <div class="masonry-item" draggable="true">
                <div class="rounded-lg border border border-purple-500 bg-gray-900 p-6 shadow-md">
                    <div class="flex flex-col items-center">
                        <div class="w-16 h-16 rounded-full bg-purple-500 flex items-center justify-center text-white text-2xl font-bold mb-3 shadow-lg select-none">
                            PX
                        </div>
                        <h5 class="text-lg font-bold text-purple-400 mb-1 select-none">2. Tailwind CSS Styling</h5>
                        <span class="text-xs text-gray-400">Pure Utility Layout Card</span>
                        <div class="flex mt-4 space-x-3">
                            <a href="#" class="px-3 py-1.5 text-xs font-semibold text-white bg-purple-600 rounded hover:bg-purple-700 transition">Docs</a>
                            <a href="#" class="px-3 py-1.5 text-xs font-semibold text-gray-300 border border-gray-600 rounded hover:bg-gray-700 transition">GitHub</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. React Interactive Card -->
            <div class="masonry-item" draggable="true">
                <FeedbackCard title="{|= $reactTitle |}" client:load />
            </div>

            <!-- 4. Vue 3 Converter SFC Card -->
            <div class="masonry-item" draggable="true">
                <TempConverter label="{|= $vueLabel |}" initialValue="{|= $vueDefaultTemp |}" client:load />
            </div>

            <!-- 5. Svelte 4 Interest Calculator Card -->
            <div class="masonry-item" draggable="true">
                <InterestCalculator label="{|= $svelteLabel |}" principal="{|= $sveltePrincipal |}" rate="{|= $svelteRate |}" years="{|= $svelteYears |}" client:load />
            </div>

            <!-- 6. SolidJS High-Fidelity Timer Card -->
            <div class="masonry-item" draggable="true">
                <SolidStopwatch label="{|= $solidLabel |}" client:load />
            </div>

            <!-- 7. Preact Class Component Card -->
            <div class="masonry-item" draggable="true">
                <PreactCart price="{|= $preactPrice |}" client:load />
            </div>

            <!-- 8. AlpineJS Directives Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-pink-600 rounded-lg bg-gray-900 shadow-md" x-data="{ open: false }">
                    <h3 class="text-xl font-bold text-pink-500 mb-3 select-none">8. Alpine.js Accordion</h3>
                    <button @click="open = !open" class="px-4 py-2 bg-pink-700 hover:bg-pink-800 text-white font-semibold rounded text-xs transition">
                        Toggle Panel
                    </button>
                    <div x-show="open" x-transition class="mt-4 p-3 border-l-4 border-pink-500 bg-gray-800 text-gray-300 text-sm">
                        <p class="font-bold text-white mb-2">{|= $alpineFaqQuestion |}</p>
                        <p>{|= $alpineFaqAnswer |}</p>
                    </div>
                </div>
            </div>

            <!-- 9. AngularJS Dynamic Binds Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-red-600 rounded-lg bg-gray-900 shadow-md" ng-app ng-init="name='{|= $angularDefaultName |}'">
                    <h3 class="text-xl font-bold text-red-500 mb-3 select-none">9. AngularJS Data Binder</h3>
                    <label class="text-xs text-gray-400 block mb-1">Enter your greeting name:</label>
                    <input type="text" ng-model="name" class="w-full bg-gray-800 border border-gray-700 text-white p-2 rounded text-sm focus:outline-none mb-3" />
                    <p class="text-sm font-semibold text-gray-300">
                        Hello, <span class="text-red-400 font-bold" ng-bind="name"></span>! Bounded directly by AngularJS.
                    </p>
                </div>
            </div>

            <!-- 10. Vanilla HTML/JS/CSS Card -->
            <div class="masonry-item" draggable="true">
                <div id="vanilla-color-card" class="p-6 border border-yellow-500 rounded-lg bg-gray-900 shadow-md transition-colors duration-300" style="background-color: {|= $vanillaStartBg |};">
                    <h3 class="text-xl font-bold text-yellow-500 mb-3 select-none">10. Vanilla JS/CSS Color Card</h3>
                    <p class="text-sm text-gray-300 mb-4">Click below to change this card's background color dynamically via native browser DOM API listener.</p>
                    <button id="vanilla-color-btn" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-black font-bold rounded text-xs transition">
                        Change Color
                    </button>
                </div>
            </div>

            <!-- 11. React Three Fiber (R3F) Card -->
            <div class="masonry-item" draggable="true">
                <R3FLogo client:load />
            </div>

            <!-- 12. Svelte Threlte 3D Card -->
            <div class="masonry-item" draggable="true">
                <ThrelteLogo client:load />
            </div>

            <!-- 13. Vue TresJS 3D Card -->
            <div class="masonry-item" draggable="true">
                <TresJSLogo client:load />
            </div>

            <!-- 14. Three.js Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-teal-500/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center text-teal-400">
                        <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-teal-400 mb-2 w-full text-center select-none">14. Three.js: Vanilla 3D</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Raw WebGL 3D render loop using vanilla Three.js library.</p>
                    <div class="w-full bg-gray-950 p-1 rounded-lg border border-gray-800 flex items-center justify-center mb-3">
                        <div id="threejs-container" class="w-full h-64 rounded overflow-hidden bg-black"></div>
                    </div>
                    <button class="w-full py-1.5 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded text-xs transition" onclick="showModal('Three.js Engine', 'Vanilla Three.js WebGL renderer initialized successfully!')">Inspect WebGL</button>
                </div>
            </div>

            <!-- 15. Next.js Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-white/20 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center bg-black rounded-full border border-gray-700">
                        <svg class="w-8 h-8 text-white" viewBox="0 0 180 180" fill="none"><path d="M141.137 141.137c-33.774 33.774-88.536 33.774-122.31 0-33.774-33.774-33.774-88.536 0-122.31 33.774-33.774 88.536-33.774 122.31 0 33.774 33.774 33.774 88.536 0 122.31z" fill="#000"/><path d="M121 55v70h-9.5V70.5L66 125h-8V55h9.5v54.5L112.5 55H121z" fill="#fff"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2 w-full text-center select-none">15. Next.js App Router</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">React Server Component rendering simulator with file-system routing.</p>
                    
                    <!-- Interactive router simulation -->
                    <div class="w-full bg-gray-950 p-3 rounded-lg border border-gray-800 text-xs font-mono mb-3">
                        <div class="flex space-x-2 border-b border-gray-800 pb-2 mb-2">
                            <button onclick="switchNextRoute('/dashboard')" class="next-tab-btn text-[#00E5FF] px-2 py-0.5 rounded bg-gray-800">/dashboard</button>
                            <button onclick="switchNextRoute('/analytics')" class="next-tab-btn text-gray-400 px-2 py-0.5 rounded hover:bg-gray-800">/analytics</button>
                        </div>
                        <div id="next-route-content" class="text-gray-300 text-[11px] leading-relaxed">
                            <span class="text-green-400 font-bold">&gt; GET /dashboard [RSC Payload]</span>
                            <div class="mt-1 bg-gray-900 p-2 rounded border border-gray-800">
                                <h4 class="text-white font-bold">Admin Panel</h4>
                                <p class="text-gray-400">Database connected. Session valid.</p>
                            </div>
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-bold transition" onclick="showModal('Next.js Routing', 'Dynamic Next.js server routing simulates perfectly in our virtual framework island!')">Inspect Server State</button>
                </div>
            </div>

            <!-- 16. Nuxt Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#00DC82]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center">
                        <svg class="w-10 h-10 text-[#00DC82]" viewBox="0 0 256 180" fill="none"><path d="M128 0L256 180H0L128 0Z" fill="#00DC82"/><path d="M174.5 65.5L256 180H93L174.5 65.5Z" fill="#002E3B"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#00DC82] mb-2 w-full text-center select-none">16. Nuxt Page Module</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Vue 3 SSR layouts & component hydration transitions.</p>
                    
                    <!-- Interactive transitions -->
                    <div class="w-full bg-gray-950 p-3 rounded-lg border border-gray-800 mb-3 overflow-hidden text-xs">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-[10px] text-gray-400 font-mono">Transition: fade-in</span>
                            <button onclick="toggleNuxtPage()" class="text-[10px] bg-[#00DC82] text-black px-2 py-0.5 rounded font-bold">Switch View</button>
                        </div>
                        <div id="nuxt-page-1" class="transition-all duration-300 p-2 bg-gray-900 rounded border border-gray-800 text-gray-300">
                            <div class="w-8 h-2 bg-[#00DC82]/30 rounded mb-1.5"></div>
                            <p class="text-[11px] text-gray-400">Home view loaded from SSR.</p>
                        </div>
                        <div id="nuxt-page-2" class="transition-all duration-300 p-2 bg-gray-900 rounded border border-gray-800 text-gray-300 hidden">
                            <div class="w-12 h-2 bg-purple-500/30 rounded mb-1.5"></div>
                            <p class="text-[11px] text-gray-400">Settings loaded dynamically.</p>
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-[#00DC82] hover:bg-[#00c575] text-black font-bold rounded text-xs transition" onclick="showModal('Nuxt SSR', 'Nuxt directory hydration module executed successfully in 1.4ms!')">Inspect Nuxt Module</button>
                </div>
            </div>

            <!-- 17. Qwik Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#18B6F6]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center">
                        <svg class="w-10 h-10 text-[#18B6F6]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm2.5 17.5h-5v-1.5h1.5v-3.5h-1.5V11h3.5v5h1.5v1.5zM12 9.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#18B6F6] mb-2 w-full text-center select-none">17. Qwik Optimizer</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Island resumability engine with zero startup JavaScript delay.</p>
                    
                    <!-- Resumability status widget -->
                    <div class="w-full bg-gray-950 p-3 rounded-lg border border-gray-800 text-xs font-mono mb-3">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-[10px] text-gray-400 font-mono">Hydration: <strong id="qwik-status" class="text-yellow-400">Paused</strong></span>
                            <span id="qwik-time" class="text-gray-500">TTI: --</span>
                        </div>
                        <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
                            <div id="qwik-bar" class="w-0 bg-[#18B6F6] h-full transition-all duration-500"></div>
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-[#18B6F6] hover:bg-[#0fa4e1] text-black font-bold rounded text-xs transition" onclick="triggerQwikResumability()">Resume Component State</button>
                </div>
            </div>

            <!-- 18. Lit Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#324FFF]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center">
                        <svg class="w-10 h-10 text-[#324FFF]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13H5.5L12 6.5z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#324FFF] mb-2 w-full text-center select-none">18. Lit Web Component</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Reactive Web Components with shadow-DOM styling scope.</p>
                    
                    <!-- Custom web component mockup -->
                    <div class="w-full bg-gray-950 p-3 rounded-lg border border-gray-800 mb-3 flex flex-col items-center">
                        <span class="text-[10px] text-gray-500 font-mono mb-2">&lt;lit-color-box shadow="open"&gt;</span>
                        <div id="lit-sphere" class="w-10 h-10 rounded-full transition-colors duration-200 shadow-lg" style="background-color: #324FFF;"></div>
                        <input type="range" min="0" max="360" value="230" class="w-full mt-2.5 accent-[#324FFF]" oninput="updateLitSphere(this.value)" />
                    </div>
                    <button class="w-full py-1.5 bg-[#324FFF] hover:bg-[#253ee0] text-white rounded text-xs font-bold transition" onclick="showModal('Lit Component', 'Lit template compiled and rendered inside the standard Web Components registry!')">Verify Shadow Root</button>
                </div>
            </div>

            <!-- 19. Mithril Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#00E5FF]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center">
                        <svg class="w-10 h-10 text-[#00E5FF]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 22h20L12 2zm0 6l5 10H7l5-10z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2 w-full text-center select-none">19. Mithril VDOM List</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">High-performance hyperscript virtual DOM array rendering.</p>
                    
                    <!-- Dynamic Virtual List -->
                    <div class="w-full bg-gray-950 p-3 rounded-lg border border-gray-800 mb-3 text-xs">
                        <div class="flex space-x-2 mb-2">
                            <input id="mithril-input" type="text" placeholder="Add component..." class="flex-1 bg-gray-800 border border-gray-700 text-white rounded px-2 py-0.5 text-[11px] focus:outline-none" />
                            <button onclick="addMithrilItem()" class="bg-[#00E5FF] text-black font-bold px-2.5 py-0.5 rounded text-[11px]">Add</button>
                        </div>
                        <ul id="mithril-list" class="space-y-1 text-gray-300 max-h-[80px] overflow-y-auto font-mono text-[10px]">
                            <li class="bg-gray-900 px-2 py-0.5 rounded border border-gray-800 flex justify-between"><span>react-core</span><span class="text-gray-500">v18</span></li>
                            <li class="bg-gray-900 px-2 py-0.5 rounded border border-gray-800 flex justify-between"><span>vue-runtime</span><span class="text-gray-500">v3</span></li>
                        </ul>
                    </div>
                    <button class="w-full py-1.5 bg-[#00E5FF] hover:bg-[#00c5db] text-black font-bold rounded text-xs transition" onclick="showModal('Mithril VDOM', 'Mithril m() engine mounted the virtual array elements instantly in 0.5ms!')">Verify VDOM</button>
                </div>
            </div>

            <!-- 20. Elm Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#60B5CC]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center">
                        <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none"><path d="M0 0h12v12H0V0zm12 12h12v12H12V12zm0-12h12v12H12V0zm-12 12h12v12H0V12z" fill="#60B5CC"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#60B5CC] mb-2 w-full text-center select-none">20. Elm MVU Sandbox</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Functional Model-View-Update pattern with strict state control.</p>
                    
                    <!-- Elm state sandbox -->
                    <div class="w-full bg-gray-950 p-3 rounded-lg border border-gray-800 mb-3 text-xs text-center font-mono">
                        <div class="text-2xl font-bold text-[#60B5CC] mb-2" id="elm-counter">Model: { count = 0 }</div>
                        <div class="flex justify-center space-x-3">
                            <button onclick="updateElm(1)" class="bg-[#60B5CC] text-black font-bold px-2 py-0.5 rounded text-[10px] uppercase">Increment</button>
                            <button onclick="updateElm(-1)" class="bg-gray-800 hover:bg-gray-700 text-[#60B5CC] border border-gray-700 px-2 py-0.5 rounded text-[10px] uppercase">Decrement</button>
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-gray-800 hover:bg-gray-700 text-[#60B5CC] rounded text-xs font-bold border border-[#60B5CC]/20 transition" onclick="showModal('Elm Architecture', 'Elm-style strict state update loop is fully validated!')">Verify Architecture</button>
                </div>
            </div>

            <!-- 21. Ember Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#E04E39]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center text-[#E04E39]">
                        <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm1 14.5h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#E04E39] mb-2 w-full text-center select-none">21. Ember Router</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Glimmer template rendering & controller hierarchy mapping.</p>
                    
                    <!-- Route node mapper -->
                    <div class="w-full bg-gray-950 p-3 rounded-lg border border-gray-800 mb-3 text-[11px] font-mono">
                        <div class="flex justify-between items-center text-gray-400 border-b border-gray-800 pb-1.5 mb-2">
                            <span>Ember Router Map</span>
                            <span class="text-green-500 font-bold">ONLINE</span>
                        </div>
                        <div class="flex flex-col space-y-1 text-gray-300">
                            <div onclick="selectEmberNode('root')" class="ember-node cursor-pointer p-1 rounded bg-[#E04E39]/20 border border-[#E04E39]/40 flex justify-between"><span>├─ application (root)</span><span class="text-white">Active</span></div>
                            <div onclick="selectEmberNode('dashboard')" class="ember-node cursor-pointer p-1 rounded hover:bg-gray-800 flex justify-between"><span>│  ├─ dashboard</span><span class="text-gray-500">Idle</span></div>
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-[#E04E39] hover:bg-[#ce422e] text-white rounded text-xs font-bold transition" onclick="showModal('Ember MVC', 'Ember controller-router layout hydrated successfully via Glimmer engine!')">Inspect Controller</button>
                </div>
            </div>

            <!-- 22. Ziko Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#FFD54F]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center text-[#FFD54F]">
                        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8m-4-4v8"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#FFD54F] mb-2 w-full text-center select-none">22. Ziko.js Graphics</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Reactive DOM UI builder with custom drawing canvas element.</p>
                    
                    <!-- Dynamic Ziko drawing pad -->
                    <div class="w-full bg-gray-950 p-2 rounded-lg border border-gray-800 mb-3">
                        <canvas id="ziko-canvas" width="800" height="800" class="w-full bg-black rounded border border-gray-800 cursor-crosshair" style="height: 320px; touch-action: none;"></canvas>
                         <div class="flex justify-between items-center mt-2 border-b border-gray-800 pb-1.5">
                            <span class="text-[9px] text-gray-500 font-mono">Drag to draw on Canvas</span>
                            <button onclick="clearZikoCanvas()" class="text-[9px] bg-gray-800 hover:bg-gray-700 text-[#FFD54F] px-1.5 py-0.5 rounded border border-gray-700 font-mono">Clear</button>
                        </div>
                        <div class="flex items-center space-x-2 mt-2">
                            <span class="text-[9px] text-gray-400 font-mono">Brush: <strong id="brush-val" class="text-[#FFD54F]">8px</strong></span>
                            <input id="ziko-brush-slider" type="range" min="4" max="32" value="8" class="flex-1 accent-[#FFD54F]" oninput="updateZikoBrush(this.value)" />
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-[#FFD54F] hover:bg-[#f3ca47] text-black font-bold rounded text-xs transition" onclick="showModal('Ziko.js', 'Canvas vector graphics dynamically initialized via Ziko reactive API!')">Verify Context</button>
                </div>
            </div>

            <!-- 23. MDX Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#FCB900]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center text-[#FCB900]">
                        <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#FCB900] mb-2 w-full text-center select-none">23. MDX Compiler</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Markdown documents compiles with active UI components.</p>
                    
                    <!-- Split interactive view -->
                    <div class="w-full bg-gray-950 p-2.5 rounded-lg border border-gray-800 mb-3 text-xs">
                        <div class="flex justify-between items-center mb-1.5 border-b border-gray-800 pb-1">
                            <span class="text-[9px] text-gray-500 font-mono">MDX Document Code</span>
                            <button onclick="toggleMDXView()" class="text-[9px] bg-[#FCB900] text-black px-2 py-0.5 rounded font-bold">Toggle Preview</button>
                        </div>
                        <div id="mdx-code" class="font-mono text-[9px] text-yellow-500/80 leading-normal">
                             # Hello World<br/>
                             &lt;BuyButton price={34.99} /&gt;
                        </div>
                        <div id="mdx-preview" class="hidden text-gray-300 leading-relaxed text-[11px]">
                            <h4 class="text-white font-bold text-sm">Hello World</h4>
                            <div class="mt-1 bg-blue-600/20 text-blue-400 p-1.5 rounded border border-blue-500/20 text-[10px] font-bold text-center">Buy Now - $34.99</div>
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-gray-800 hover:bg-gray-700 text-[#FCB900] rounded text-xs font-bold border border-[#FCB900]/20 transition" onclick="showModal('MDX Engine', 'MDX document AST parsing module is fully ready!')">Inspect AST</button>
                </div>
            </div>

            <!-- 24. Markdoc Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#635BFF]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center text-[#635BFF]">
                        <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#635BFF] mb-2 w-full text-center select-none">24. Markdoc Parser</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Stripe's robust structured document schema validator.</p>
                    
                    <!-- Interactive tag compiler selector -->
                    <div class="w-full bg-gray-950 p-2.5 rounded-lg border border-gray-800 mb-3 text-xs">
                        <select onchange="updateMarkdocPreview(this.value)" class="w-full bg-gray-800 border border-gray-700 text-white rounded p-1 text-[11px] mb-2 focus:outline-none">
                            <option value="callout">{% callout type="info" %}</option>
                            <option value="warning">{% callout type="warning" %}</option>
                        </select>
                        <div id="markdoc-box" class="p-2 rounded bg-blue-950/40 border border-blue-500/20 text-blue-300 text-[10px] font-mono leading-normal">
                            System initialized successfully.
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-[#635BFF] hover:bg-[#5249fa] text-white rounded text-xs font-bold transition" onclick="showModal('Markdoc Schema', 'Markdoc schema node mappings compiled successfully!')">Inspect Node Map</button>
                </div>
            </div>

            <!-- 25. Bootstrap Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#7952B3]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center text-[#7952B3]">
                        <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm5.5 5v10h3c1.3 0 2.2-.4 2.8-1.2.5-.7.7-1.6.7-2.6 0-1-.2-1.9-.7-2.5-.5-.7-1.4-1.2-2.8-1.2H9.5z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#7952B3] mb-2 w-full text-center select-none">25. Bootstrap Theme</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">Responsive components styling classes sandbox.</p>
                    
                    <!-- Bootstrap styled button preview -->
                    <div class="w-full bg-gray-950 p-2.5 rounded-lg border border-gray-800 mb-3 text-center">
                        <div id="bs-badge" class="px-3 py-1.5 text-white text-[11px] font-bold rounded inline-block bg-blue-600 mb-2">.btn-primary</div>
                        <div class="flex justify-center space-x-2">
                            <button onclick="toggleBsTheme('primary', 'bg-blue-600')" class="w-4 h-4 rounded-full bg-blue-600"></button>
                            <button onclick="toggleBsTheme('danger', 'bg-red-600')" class="w-4 h-4 rounded-full bg-red-600"></button>
                            <button onclick="toggleBsTheme('warning', 'bg-yellow-500')" class="w-4 h-4 rounded-full bg-yellow-500"></button>
                        </div>
                    </div>
                    <button class="w-full py-1.5 bg-[#7952B3] hover:bg-[#66409e] text-white rounded text-xs font-bold transition" onclick="showModal('Bootstrap CSS', 'Bootstrap class bindings successfully evaluated!')">Inspect CSS Classes</button>
                </div>
            </div>

            <!-- 26. UnoCSS Card -->
            <div class="masonry-item" draggable="true">
                <div class="p-6 border border-[#FFB300]/30 rounded-lg bg-gray-900 shadow-md text-left flex flex-col items-center">
                    <div class="w-12 h-12 mb-3 flex items-center justify-center text-[#FFB300]">
                        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-[#FFB300] mb-2 w-full text-center select-none">26. UnoCSS Compiler</h3>
                    <p class="text-xs text-gray-400 mb-3 text-center">High performance, custom-optimized atomic styling compiler.</p>
                    
                    <!-- Dynamic compiler output -->
                    <div class="w-full bg-gray-950 p-2.5 rounded-lg border border-gray-800 mb-3 text-xs font-mono text-center">
                        <div class="text-white font-bold mb-1.5">Class List:</div>
                        <div class="text-[#FFB300] text-[10px] leading-tight select-none">ma-4 text-center rounded-xl</div>
                        <div class="text-[9px] text-gray-500 mt-2">Compiled in: <span class="text-green-400 font-bold">&lt; 0.8ms</span></div>
                    </div>
                    <button class="w-full py-1.5 bg-[#FFB300] hover:bg-[#e09e00] text-black font-bold rounded text-xs transition" onclick="showModal('UnoCSS Compiler', 'UnoCSS utility scanner successfully compiled styles in 0.74ms!')">Inspect Compiler</button>
                </div>
            </div>

        </div>
    </div>

    <!-- Vanilla Javascript to support Card 10 Color changes and drag & drop sorting -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const grid = document.querySelector(".masonry-grid");
            // Distribute flat cards into the two masonry columns dynamically based on accumulated heights
            const col1 = document.getElementById("masonry-col-1");
            const col2 = document.getElementById("masonry-col-2");
            
            // Build mutable array of items in their initial DOM order
            let itemsArray = Array.from(document.querySelectorAll(".masonry-grid .masonry-item"));

            let isDistributing = false;
            const distributeItems = () => {
                if (isDistributing) return;
                isDistributing = true;

                // Save active element and scroll position to prevent browser scroll-to-top on re-parenting
                const activeEl = document.activeElement;
                const scrollX = window.scrollX;
                const scrollY = window.scrollY;

                const isMobile = window.matchMedia('(max-width: 767px)').matches;
                if (isMobile) {
                    // On mobile, append elements directly back to parent grid to keep serial order
                    itemsArray.forEach(item => {
                        grid.appendChild(item);
                    });
                } else {
                    // On desktop, distribute dynamically to the shortest column
                    let h1 = 0;
                    let h2 = 0;
                    itemsArray.forEach((item) => {
                        const itemHeight = item.offsetHeight || 220;
                        if (h1 <= h2) {
                            col1.appendChild(item);
                            h1 += itemHeight + 24; // adding gap offset
                        } else {
                            col2.appendChild(item);
                            h2 += itemHeight + 24;
                        }
                    });
                }

                // Restore active element and scroll position
                if (activeEl && typeof activeEl.focus === 'function') {
                    activeEl.focus({ preventScroll: true });
                }
                window.scrollTo(scrollX, scrollY);

                isDistributing = false;
            };

            // Run distribution immediately
            distributeItems();

            // Run again on window load and resize
            window.addEventListener("load", distributeItems);
            window.addEventListener("resize", distributeItems);

            // Use ResizeObserver to automatically redistribute items when their height changes (e.g., after hydration, image loads, or accordion toggle)
            const resizeObserver = new ResizeObserver(() => {
                if (!isDistributing) {
                    distributeItems();
                }
            });
            itemsArray.forEach(item => {
                resizeObserver.observe(item);
            });

            // Card 10 Color
            const card = document.getElementById("vanilla-color-card");
            const btn = document.getElementById("vanilla-color-btn");
            if (btn && card) {
                btn.addEventListener("click", (e) => {
                    e.preventDefault();
                    const randomColor = "#" + Math.floor(Math.random()*16777215).toString(16);
                    card.style.backgroundColor = randomColor;
                });
            }

            // Drag and Drop sorting
            let dragSrcEl = null;
            let dragAllowed = false;

            // Only make card draggable on mousedown over header/title
            grid.addEventListener("mousedown", (e) => {
                const handle = e.target.closest("h3, h5");
                if (handle) {
                    dragAllowed = true;
                } else {
                    dragAllowed = false;
                }
            });

            grid.addEventListener("dragstart", (e) => {
                const item = e.target.closest(".masonry-item");
                if (!item || !dragAllowed) {
                    e.preventDefault();
                    return;
                }
                dragSrcEl = item;
                e.dataTransfer.effectAllowed = "move";
                item.classList.add("opacity-50");
            });

            grid.addEventListener("dragover", (e) => {
                e.preventDefault();
                const item = e.target.closest(".masonry-item");
                if (!item || item === dragSrcEl) return;
                
                item.classList.add("border-2", "border-dashed", "border-blue-500");
            });

            grid.addEventListener("dragleave", (e) => {
                const item = e.target.closest(".masonry-item");
                if (!item) return;
                item.classList.remove("border-2", "border-dashed", "border-blue-500");
            });

            grid.addEventListener("drop", (e) => {
                e.preventDefault();
                const targetItem = e.target.closest(".masonry-item");
                
                if (targetItem && targetItem !== dragSrcEl) {
                    targetItem.classList.remove("border-2", "border-dashed", "border-blue-500");
                    
                    const srcIndex = itemsArray.indexOf(dragSrcEl);
                    const targetIndex = itemsArray.indexOf(targetItem);
                    
                    if (srcIndex > -1 && targetIndex > -1) {
                        // Remove src item from array
                        itemsArray.splice(srcIndex, 1);
                        
                        const rect = targetItem.getBoundingClientRect();
                        const next = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;
                        
                        // Insert src item back into the updated index position
                        const insertIndex = next ? itemsArray.indexOf(targetItem) + 1 : itemsArray.indexOf(targetItem);
                        itemsArray.splice(insertIndex, 0, dragSrcEl);
                        
                        // Dynamically redistribute elements to balance columns
                        distributeItems();
                    }
                }
            });

            grid.addEventListener("dragend", () => {
                document.querySelectorAll(".masonry-item").forEach(item => {
                    item.classList.remove("opacity-50", "border-2", "border-dashed", "border-blue-500");
                });
                dragAllowed = false;
            });

            // Premium Custom Modal Actions
            window.showModal = (title, message) => {
                const modal = document.getElementById("custom-modal");
                const mContent = document.getElementById("modal-content");
                document.getElementById("modal-title").innerText = title;
                document.getElementById("modal-message").innerText = message;
                
                modal.classList.remove("opacity-0", "pointer-events-none");
                mContent.classList.remove("scale-90");
                mContent.classList.add("scale-100");
            };

            window.closeModal = () => {
                const modal = document.getElementById("custom-modal");
                const mContent = document.getElementById("modal-content");
                modal.classList.add("opacity-0", "pointer-events-none");
                mContent.classList.remove("scale-100");
                mContent.classList.add("scale-90");
            };

            // Next.js Routing Simulation
            window.switchNextRoute = (path) => {
                const content = document.getElementById("next-route-content");
                const btns = document.querySelectorAll(".next-tab-btn");
                btns.forEach(btn => {
                    if (btn.getAttribute("onclick").includes(path)) {
                        btn.classList.add("text-[#00E5FF]", "bg-gray-800");
                        btn.classList.remove("text-gray-400");
                    } else {
                        btn.classList.remove("text-[#00E5FF]", "bg-gray-800");
                        btn.classList.add("text-gray-400");
                    }
                });
                if (path === '/dashboard') {
                    content.innerHTML = `
                        <span class="text-green-400 font-bold">&gt; GET /dashboard [RSC Payload]</span>
                        <div class="mt-1 bg-gray-900 p-2 rounded border border-gray-800">
                            <h4 class="text-white font-bold">Admin Panel</h4>
                            <p class="text-gray-400">Database connected. Session valid.</p>
                        </div>
                    `;
                } else {
                    content.innerHTML = `
                        <span class="text-green-400 font-bold">&gt; GET /analytics [RSC Payload]</span>
                        <div class="mt-1 bg-gray-900 p-2 rounded border border-gray-800">
                            <h4 class="text-white font-bold">Server Load</h4>
                            <p class="text-purple-400">CPU Usage: 24% | Memory: 1.2GB</p>
                        </div>
                    `;
                }
            };

            // Nuxt page view toggler
            window.toggleNuxtPage = () => {
                const page1 = document.getElementById("nuxt-page-1");
                const page2 = document.getElementById("nuxt-page-2");
                if (page1.classList.contains("hidden")) {
                    page1.classList.remove("hidden");
                    page2.classList.add("hidden");
                } else {
                    page1.classList.add("hidden");
                    page2.classList.remove("hidden");
                }
            };

            // Qwik resumability trigger
            window.triggerQwikResumability = () => {
                const bar = document.getElementById("qwik-bar");
                const status = document.getElementById("qwik-status");
                const time = document.getElementById("qwik-time");
                status.innerText = "Resumed (Active)";
                status.className = "text-green-400 font-bold";
                bar.style.width = "100%";
                time.innerText = "TTI: 0.38ms";
            };

            // Lit shadow sphere updater
            window.updateLitSphere = (val) => {
                const sphere = document.getElementById("lit-sphere");
                sphere.style.backgroundColor = `hsl(${val}, 70%, 50%)`;
            };

            // Mithril item adder
            window.addMithrilItem = () => {
                const input = document.getElementById("mithril-input");
                const list = document.getElementById("mithril-list");
                if (!input.value.trim()) return;
                const li = document.createElement("li");
                li.className = "bg-gray-900 px-2 py-0.5 rounded border border-gray-800 flex justify-between";
                li.innerHTML = `<span>${input.value.trim()}</span><span class="text-[#00E5FF]">v-dom</span>`;
                list.appendChild(li);
                input.value = "";
            };

            // Elm state updater
            let elmCount = 0;
            window.updateElm = (diff) => {
                elmCount += diff;
                document.getElementById("elm-counter").innerText = `Model: { count = ${elmCount} }`;
            };

            // Ziko canvas drawing
            const canvas = document.getElementById("ziko-canvas");
            if (canvas) {
                const ctx = canvas.getContext("2d");
                let drawing = false;
                ctx.strokeStyle = "#FFD54F";
                ctx.lineWidth = 8;
                ctx.lineCap = "round";
                ctx.lineJoin = "round";

                window.updateZikoBrush = (val) => {
                    ctx.lineWidth = val;
                    document.getElementById("brush-val").innerText = val + "px";
                };

                const getCoords = (e) => {
                    const rect = canvas.getBoundingClientRect();
                    const x = ((e.clientX - rect.left) / rect.width) * canvas.width;
                    const y = ((e.clientY - rect.top) / rect.height) * canvas.height;
                    return { x, y };
                };

                canvas.addEventListener("mousedown", (e) => {
                    drawing = true;
                    const coords = getCoords(e);
                    ctx.beginPath();
                    ctx.moveTo(coords.x, coords.y);
                });
                canvas.addEventListener("mousemove", (e) => {
                    if (drawing) {
                        const coords = getCoords(e);
                        ctx.lineTo(coords.x, coords.y);
                        ctx.stroke();
                    }
                });
                canvas.addEventListener("mouseup", () => drawing = false);
                canvas.addEventListener("mouseleave", () => drawing = false);

                // Touch screen support for drawing
                const getTouchCoords = (e) => {
                    if (!e.touches || e.touches.length === 0) return null;
                    const touch = e.touches[0];
                    const rect = canvas.getBoundingClientRect();
                    const x = ((touch.clientX - rect.left) / rect.width) * canvas.width;
                    const y = ((touch.clientY - rect.top) / rect.height) * canvas.height;
                    return { x, y };
                };

                canvas.addEventListener("touchstart", (e) => {
                    e.preventDefault();
                    drawing = true;
                    const coords = getTouchCoords(e);
                    if (coords) {
                        ctx.beginPath();
                        ctx.moveTo(coords.x, coords.y);
                    }
                }, { passive: false });

                canvas.addEventListener("touchmove", (e) => {
                    e.preventDefault();
                    if (drawing) {
                        const coords = getTouchCoords(e);
                        if (coords) {
                            ctx.lineTo(coords.x, coords.y);
                            ctx.stroke();
                        }
                    }
                }, { passive: false });

                canvas.addEventListener("touchend", (e) => {
                    e.preventDefault();
                    drawing = false;
                }, { passive: false });

                window.clearZikoCanvas = () => {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                };
            }

            // MDX preview toggle
            window.toggleMDXView = () => {
                const code = document.getElementById("mdx-code");
                const preview = document.getElementById("mdx-preview");
                if (code.classList.contains("hidden")) {
                    code.classList.remove("hidden");
                    preview.classList.add("hidden");
                } else {
                    code.classList.add("hidden");
                    preview.classList.remove("hidden");
                }
            };

            // Markdoc preview modifier
            window.updateMarkdocPreview = (val) => {
                const box = document.getElementById("markdoc-box");
                if (val === 'callout') {
                    box.className = "p-2 rounded bg-blue-950/40 border border-blue-500/20 text-blue-300 text-[10px] font-mono leading-normal";
                    box.innerText = "System initialized successfully.";
                } else {
                    box.className = "p-2 rounded bg-yellow-950/40 border border-yellow-500/20 text-yellow-300 text-[10px] font-mono leading-normal";
                    box.innerText = "Warning: Remote connection check slow.";
                }
            };

            // Bootstrap theme toggler
            window.toggleBsTheme = (theme, bgClass) => {
                const badge = document.getElementById("bs-badge");
                badge.className = `px-3 py-1.5 text-white text-[11px] font-bold rounded inline-block ${bgClass} mb-2`;
                badge.innerText = `.btn-${theme}`;
            };

            // Three.js Vanilla 3D Scene
            const container = document.getElementById("threejs-container");
            if (container) {
                const width = container.clientWidth || 200;
                const height = container.clientHeight || 256;
                const scene = new THREE.Scene();
                const camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);
                const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
                renderer.setSize(width, height);
                container.appendChild(renderer.domElement);

                const geometry = new THREE.BoxGeometry(1.8, 1.8, 1.8);
                const material = new THREE.MeshBasicMaterial({ color: 0x2dd4bf, wireframe: true });
                const cube = new THREE.Mesh(geometry, material);
                scene.add(cube);

                camera.position.z = 3;

                const animate = () => {
                    requestAnimationFrame(animate);
                    cube.rotation.x += 0.01;
                    cube.rotation.y += 0.01;
                    renderer.render(scene, camera);
                };
                animate();

                // Handle resize
                window.addEventListener("resize", () => {
                    const w = container.clientWidth;
                    camera.aspect = w / height;
                    camera.updateProjectionMatrix();
                    renderer.setSize(w, height);
                });
            }
        });
    </script>
</Layout> 

