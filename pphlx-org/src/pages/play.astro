---
import PlayLayout from '~/layouts/PlayLayout.astro';
import PPHLXLogo from '~/components/PPHLXLogo.astro';
import fs from 'node:fs';
import path from 'node:path';

// Find latest vsix version dynamically from public/extensions
let version = '1.0.6'; // fallback
try {
	const extensionsDir = path.join(process.cwd(), 'public', 'extensions');
	if (fs.existsSync(extensionsDir)) {
		const files = fs.readdirSync(extensionsDir);
		const vsixFile = files.find(f => f.startsWith('pphlx-') && f.endsWith('.vsix'));
		if (vsixFile) {
			const match = vsixFile.match(/pphlx-(\d+\.\d+\.\d+(?:-\d+)?)\.vsix/);
			if (match) {
				version = match[1];
			}
		}
	}
} catch (e) {
	console.error("Failed to read extensions version dynamically:", e);
}
---

<PlayLayout title="Playground">
	<div id="playground-config" data-version={version} class="hidden"></div>
	<Fragment slot="head">
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
		
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs/loader.min.js"></script>
		
		<style is:global>
			/* Track Styling: Solid #2c2c2c background and exactly 15px wide/high */
			.monaco-editor .scrollbar,
			.monaco-scrollable-element .scrollbar {
				background: #2c2c2c !important;
			}
			.monaco-editor .scrollbar.vertical,
			.monaco-scrollable-element .scrollbar.vertical {
				width: 15px !important;
			}
			.monaco-editor .scrollbar.horizontal,
			.monaco-scrollable-element .scrollbar.horizontal {
				height: 15px !important;
			}

			/* Vertical Scrollbar Thumb: 9px wide centered in 15px track (3px gap left/right) */
			.monaco-editor .scrollbar.vertical .slider,
			.monaco-scrollable-element .scrollbar.vertical .slider {
				background: #9f9f9f !important;
				border-radius: 9999px !important;
				width: 9px !important;
				left: 3px !important;
				border: none !important;
				transition: background-color 0.2s !important;
			}
			.monaco-editor .scrollbar.vertical .slider:hover,
			.monaco-scrollable-element .scrollbar.vertical .slider:hover,
			.monaco-editor .scrollbar.vertical .slider:active,
			.monaco-scrollable-element .scrollbar.vertical .slider:active {
				background: #d1d1d1 !important;
				width: 9px !important;
				left: 3px !important;
			}

			/* Horizontal Scrollbar Thumb: 9px high centered in 15px track (3px gap top/bottom) */
			.monaco-editor .scrollbar.horizontal .slider,
			.monaco-scrollable-element .scrollbar.horizontal .slider {
				background: #9f9f9f !important;
				border-radius: 9999px !important;
				height: 9px !important;
				top: 3px !important;
				border: none !important;
				transition: background-color 0.2s !important;
			}
			.monaco-editor .scrollbar.horizontal .slider:hover,
			.monaco-scrollable-element .scrollbar.horizontal .slider:hover,
			.monaco-editor .scrollbar.horizontal .slider:active,
			.monaco-scrollable-element .scrollbar.horizontal .slider:active {
				background: #d1d1d1 !important;
				height: 9px !important;
				top: 3px !important;
			}

			/* Style Monaco Scrollbar Arrows */
			.monaco-editor .scrollbar .arrow-up,
			.monaco-editor .scrollbar .arrow-down,
			.monaco-editor .scrollbar .arrow-left,
			.monaco-editor .scrollbar .arrow-right {
				background-color: #2c2c2c !important;
				background-repeat: no-repeat !important;
				background-position: center !important;
				background-size: contain !important;
				border: none !important; /* No border needed as SVG handles centering and sizing */
			}
			
			.monaco-editor .scrollbar .arrow-up {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f' stroke='%239f9f9f' stroke-width='14' stroke-linejoin='round'><polygon points='50,20 20,80 80,80'/></svg>") !important;
			}
			.monaco-editor .scrollbar .arrow-up:hover {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1' stroke='%23d1d1d1' stroke-width='14' stroke-linejoin='round'><polygon points='50,20 20,80 80,80'/></svg>") !important;
			}
			
			.monaco-editor .scrollbar .arrow-down {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f' stroke='%239f9f9f' stroke-width='14' stroke-linejoin='round'><polygon points='50,80 20,20 80,20'/></svg>") !important;
			}
			.monaco-editor .scrollbar .arrow-down:hover {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1' stroke='%23d1d1d1' stroke-width='14' stroke-linejoin='round'><polygon points='50,80 20,20 80,20'/></svg>") !important;
			}

			.monaco-editor .scrollbar .arrow-left {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f' stroke='%239f9f9f' stroke-width='14' stroke-linejoin='round'><polygon points='20,50 80,20 80,80'/></svg>") !important;
			}
			.monaco-editor .scrollbar .arrow-left:hover {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1' stroke='%23d1d1d1' stroke-width='14' stroke-linejoin='round'><polygon points='20,50 80,20 80,80'/></svg>") !important;
			}

			.monaco-editor .scrollbar .arrow-right {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f' stroke='%239f9f9f' stroke-width='14' stroke-linejoin='round'><polygon points='80,50 20,20 20,80'/></svg>") !important;
			}
			.monaco-editor .scrollbar .arrow-right:hover {
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1' stroke='%23d1d1d1' stroke-width='14' stroke-linejoin='round'><polygon points='80,50 20,20 20,80'/></svg>") !important;
			}

			/* Styles when live preview is detached/popout */
			.is-detached-preview #ide-header,
			.is-detached-preview #activity-bar-parent,
			.is-detached-preview #explorer-sidebar,
			.is-detached-preview #sidebar-resizer,
			.is-detached-preview #editor-workspace,
			.is-detached-preview #workspace-resizer,
			.is-detached-preview #preview-pane > div:first-child {
				display: none !important;
			}
			.is-detached-preview #preview-pane {
				width: 100% !important;
				height: 100% !important;
				max-width: none !important;
				flex: 1 !important;
			}
			.is-detached-preview #output-container-preview {
				position: relative !important;
				width: 100% !important;
				height: 100% !important;
			}
		</style>
	</Fragment>

	<!-- Header Bar (Integrated Minimal IDE Title Bar) -->
	<header id="ide-header" class="flex items-center justify-between px-6 py-2 border-b border-[#1b1f27] bg-[#0c0e12] select-none h-12">
		<div class="flex items-center gap-3">
			<a href="/" class="flex items-center hover:opacity-85 transition-opacity text-white">
				<PPHLXLogo class="h-8 w-auto" />
			</a>
			<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#1b1f27] text-astro-gray-400 border border-[#2e3440] font-mono">REPL Playground</span>
		</div>
		<div class="flex items-center gap-4">
			<!-- Reset Example Code -->
			<div class="flex items-center gap-2">
				<button id="btn-reset-code" class="text-xs font-semibold px-3 py-1 rounded bg-[#1b1f27] hover:bg-[#de4343] border border-[#2e3440] text-astro-gray-200 hover:text-white transition-all flex items-center gap-1.5" title="Reset all files to default example code">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18" />
					</svg>
					Reset Code
				</button>
			</div>

			<!-- VSIX Installation Trigger -->
			<button id="btn-install-vsix" class="text-xs font-semibold px-3 py-1 rounded bg-[#1b1f27] hover:bg-[#282d38] border border-[#2e3440] text-astro-gray-200 hover:text-white transition-all flex items-center gap-1.5">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
				</svg>
				Install VSIX Extension
			</button>
			<input type="file" id="vsix-uploader" class="hidden" accept=".vsix" />

			<a href="/blog/PPHLX-live-database-queries-deep-dive/" class="text-xs font-semibold text-[#acafff] hover:text-white transition-colors">
				Back to Blog
			</a>
		</div>
	</header>

	<!-- Main Workspace -->
	<div class="w-full flex-1 min-h-0 flex flex-row overflow-hidden bg-[#0c0e12]">
		<!-- VS Code Activity Bar (Leftmost) -->
		<div id="activity-bar-parent" class="w-12 bg-[#090b0e] border-r border-[#1b1f27] flex flex-col items-center py-3 gap-4 flex-shrink-0 select-none">
			<!-- Explorer Icon Button -->
			<button id="activity-btn-explorer" class="p-2 rounded-lg text-[#4bf3c8] hover:text-white transition-colors bg-[#111318] border border-[#1b1f27]" title="Toggle Explorer Sidebar">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
				</svg>
			</button>
		</div>

		<!-- Sidebar File Explorer (Left) -->
		<div id="explorer-sidebar" class="w-60 flex flex-col border-r border-[#1b1f27] bg-[#0c0e12] h-full flex-shrink-0 select-none">
			<div class="flex items-center justify-between px-4 py-2 border-b border-[#1b1f27] h-10 bg-[#0c0e12]">
				<span class="text-[10px] font-bold tracking-wider text-astro-gray-400 uppercase">Explorer</span>
				<div class="flex gap-1">
					<button id="btn-root-upload-file" title="Upload Files" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-300 hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
						</svg>
					</button>
					<button id="btn-root-new-file" title="New File" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-300 hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
						</svg>
					</button>
					<button id="btn-root-new-folder" title="New Folder" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-300 hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
						</svg>
					</button>
				</div>
			</div>
			
			<!-- Playbook Selector Pane -->
			<div class="px-4 py-2.5 border-b border-[#1b1f27] bg-[#090b0e] flex flex-col gap-1.5 select-none">
				<div class="flex justify-between items-center">
					<label class="text-[9px] font-bold text-astro-gray-400 uppercase tracking-wider">Playbook Project</label>
					<button id="btn-playbook-menu" title="More Actions..." class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-300 hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
						</svg>
					</button>
				</div>
				<div class="relative">
					<select id="playbook-select" class="w-full bg-[#111318] border border-[#1b1f27] text-white text-xs rounded px-2.5 py-1.5 focus:outline-none focus:border-[#4bf3c8] appearance-none font-sans font-medium cursor-pointer transition-colors hover:border-gray-700">
						<!-- Dynamically populated from VFS manifest.json -->
					</select>
					<input id="playbook-select-input" type="text" class="hidden w-full bg-[#111318] border border-[#4bf3c8] text-white text-xs rounded px-2.5 py-1.5 focus:outline-none font-sans font-medium font-mono" placeholder="workspace-name..." />
					<div id="playbook-select-arrow" class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-astro-gray-400">
						<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
				</div>
			</div>
			
			<!-- Collapsible Pane Header (VS Code style) -->
			<div class="flex items-center gap-1.5 px-4 py-1.5 bg-[#111318] border-b border-[#1b1f27] cursor-pointer hover:bg-[#17191e] select-none text-astro-gray-300 hover:text-white transition-colors" id="btn-toggle-tree-pane">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-150" id="chevron-tree-pane" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
				</svg>
				<span class="text-[9px] font-bold tracking-wider uppercase font-mono">WORKSPACE</span>
			</div>
			
			<!-- File List Container -->
			<div id="file-list" class="flex-1 overflow-y-auto py-2 px-1 flex flex-col gap-0.5">
				<!-- Dynamically filled by JS -->
			</div>
		</div>

		<!-- Sidebar Resizer (Vertical Drag Handle) -->
		<div id="sidebar-resizer" class="w-[3px] hover:w-[6px] bg-[#1b1f27] hover:bg-[#54b9ff]/40 active:bg-[#54b9ff] transition-all cursor-col-resize h-full select-none z-50 flex-shrink-0"></div>

		<!-- Editor & Preview Available Workspace (Subtracts left sidebar Explorer width) -->
		<div class="flex-1 flex flex-row min-h-0 h-full relative" id="workspace-splitter-parent">
			<!-- Editor Workspace (Left) -->
			<div id="editor-workspace" class="flex flex-col border-r border-[#1b1f27] h-full" style="width: 50%;">
				<div class="flex items-center justify-between px-4 py-2 bg-[#0c0e12] border-b border-[#1b1f27] h-10">
					<div class="flex items-center gap-2">
						<button id="btn-toggle-sidebar" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-400 hover:text-white transition-colors" title="Toggle Explorer Sidebar">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
						<span id="active-file-title" class="text-xs font-semibold tracking-wider text-astro-gray-300 font-mono">index.pphx</span>
					</div>
					<div class="flex items-center gap-2">
						<span class="text-[10px] text-[#4bf3c8] font-mono flex items-center gap-1.5 font-semibold">
							<span class="w-1.5 h-1.5 rounded-full bg-[#4bf3c8] animate-pulse"></span> LOCAL SANDBOX
						</span>
						<button id="btn-copy-input" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-400 hover:text-white transition-colors" title="Copy code to clipboard">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-input-normal">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
							</svg>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-green-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-input-success">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
						</button>
					</div>
				</div>
				<div id="input-editor" class="flex-1 w-full bg-[#0c0e12]"></div>
				<div id="image-preview-container" class="flex-1 w-full bg-[#0c0e12] flex flex-col items-center justify-center p-6 text-astro-gray-400 hidden select-none">
					<div class="max-w-md w-full flex flex-col items-center gap-4 bg-[#111318] p-6 border border-[#1b1f27] rounded-xl">
						<img id="image-preview-element" class="max-h-64 object-contain rounded-lg border border-[#232731] bg-grid-pattern p-2" src="" alt="Selected Preview" />
						<div class="w-full text-center space-y-1.5 font-mono text-xs text-astro-gray-300">
							<p>File Path: <span id="image-preview-path" class="text-white"></span></p>
							<p>Dimensions: <span id="image-preview-dimensions" class="text-[#4bf3c8]">-</span></p>
							<p>File Size: <span id="image-preview-size" class="text-[#54b9ff]">-</span></p>
						</div>
					</div>
				</div>
			</div>

			<!-- Col Resize Splitter Bar -->
			<div id="workspace-resizer" class="w-1 bg-[#1b1f27] hover:bg-[#54b9ff] cursor-col-resize transition-colors h-full select-none z-[100]" title="Drag to resize editor and preview pane"></div>

			<!-- Preview Pane (Right) -->
			<div id="preview-pane" class="flex flex-col h-full bg-[#0f1115]" style="width: 50%;">
				<!-- Output Tabs -->
				<div class="flex items-center justify-between px-2 bg-[#0c0e12] border-b border-[#1b1f27] h-10">
					<div class="flex gap-1">
						<button id="tab-php" class="px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-[#54b9ff] text-white bg-[#0f1115] transition-all rounded-t-md">
							Compiled PHP
						</button>
						<button id="tab-preview" class="px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-transparent text-[#858B98] hover:text-white transition-all rounded-t-md">
							HTML Preview
						</button>
					</div>
					<div class="flex items-center gap-2 mr-2">
						<span class="text-[10px] text-astro-gray-300 font-mono font-semibold animate-pulse" id="compile-time">Compiled in 0ms</span>
						<button id="btn-copy-output" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-400 hover:text-white transition-colors" title="Copy output to clipboard">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-output-normal">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
							</svg>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-green-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-output-success">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
						</button>
						<button id="btn-download-output" class="p-1 hover:bg-[#1b1f27] rounded text-[#4bf3c8] hover:text-white transition-colors" title="Download compiled standalone PHP page">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
							</svg>
						</button>
					</div>
				</div>
				
				<!-- Tab Content Areas -->
				<div class="flex-1 relative overflow-hidden h-full">
					<!-- PHP Output Area -->
					<div id="output-container-php" class="absolute inset-0 w-full h-full">
