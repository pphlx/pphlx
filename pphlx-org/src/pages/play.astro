						}
					}
					if (e.data.phpCode !== undefined) lastPhpCode = e.data.phpCode;
					if (e.data.activeCode !== undefined) lastActiveCode = e.data.activeCode;
					if (e.data.files !== undefined) lastFiles = e.data.files;
					if (e.data.activeFile !== undefined) lastActiveFile = e.data.activeFile;
					if (e.data.activePlaybookId !== undefined) lastActivePlaybookId = e.data.activePlaybookId;
				}
			};

			// Request initial sync once loaded
			window.addEventListener('DOMContentLoaded', () => {
				previewChannel.postMessage({ requestSync: true });
			});
		} else {
			// Main window: listen for synchronization requests
			previewChannel.onmessage = (e) => {
				if (e.data && e.data.requestSync) {
					broadcastIframeContent();
				}
			};
		}

		function broadcastIframeContent() {
			if (lastCompiledHtml) {
				previewChannel.postMessage({
					html: lastCompiledHtml,
					phpCode: typeof outputEditor !== 'undefined' && outputEditor ? outputEditor.getValue() : '',
					activeCode: typeof inputEditor !== 'undefined' && inputEditor ? inputEditor.getValue() : '',
					files: typeof files !== 'undefined' ? files : {},
					activeFile: typeof activeFile !== 'undefined' ? activeFile : 'index.pphx',
					activePlaybookId: typeof activePlaybookId !== 'undefined' ? activePlaybookId : 'ecommerce'
				});
			}
		}
	</script>
</PlayLayout>

