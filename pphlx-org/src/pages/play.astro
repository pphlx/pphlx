	<!-- Monaco Editor & Virtual File System Script -->
	<script is:inline>
		// Setup Monaco loader path safely
		if (typeof require !== 'undefined') {
			require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs' } });
		}

		// State Variables
		const isDetached = typeof window !== 'undefined' && new URLSearchParams(window.location.search).has('detached');
		const STORAGE_KEY = 'pphlx_playground_vfs';
		const CUSTOM_LANGS_KEY = 'pphlx_playground_custom_langs';

		const configEl = document.getElementById('playground-config');
		const latestVersion = configEl ? configEl.getAttribute('data-version') : '1.0.4-1';
		console.log(`%c PPHLX %c v${latestVersion} Play IDE Initialized `, "background:#4bf3c8;color:#000;font-weight:bold;padding:1px 4px;border-radius:3px 0 0 3px;", "background:#0f1115;color:#fff;padding:1px 4px;border-radius:0 3px 3px 0;");

		// Premium IDE Modal Helper System
		const modalOverlay = document.getElementById('ide-modal-overlay');
		const modalCard = document.getElementById('ide-modal-card');
		const modalTitle = document.getElementById('ide-modal-title');
		const modalMessage = document.getElementById('ide-modal-message');
		const modalInputContainer = document.getElementById('ide-modal-input-container');
		const modalInput = document.getElementById('ide-modal-input');
		const modalBtnCancel = document.getElementById('ide-modal-btn-cancel');
		const modalBtnConfirm = document.getElementById('ide-modal-btn-confirm');

		let activeModalCallback = null;
		let lastCompiledHtml = '';

		function showIdeModal({ title, message, showInput, placeholder, confirmText, cancelText, onConfirm }) {
			modalTitle.textContent = title;
			modalMessage.textContent = message || '';
			
			if (showInput) {
				modalInputContainer.classList.remove('hidden');
				modalInput.value = '';
				modalInput.placeholder = placeholder || '';
				setTimeout(() => modalInput.focus(), 50);
			} else {
				modalInputContainer.classList.add('hidden');
			}

			modalBtnConfirm.textContent = confirmText || 'Confirm';
			modalBtnConfirm.className = (confirmText === 'Delete' || confirmText === 'Reset')
				? 'px-3.5 py-1.5 rounded text-xs font-semibold text-white bg-[#de4343] hover:bg-[#c93232] transition-all'
				: 'px-3.5 py-1.5 rounded text-xs font-semibold text-white bg-[#54b9ff] hover:bg-[#45a4eb] transition-all';
			
			modalBtnCancel.textContent = cancelText || 'Cancel';
			if (cancelText === 'hidden') {
				modalBtnCancel.classList.add('hidden');
			} else {
				modalBtnCancel.classList.remove('hidden');
			}

			// Show overlay and card with animation transition
			modalOverlay.classList.remove('hidden');
			setTimeout(() => {
				modalCard.classList.remove('scale-95', 'opacity-0');
				modalCard.classList.add('scale-100', 'opacity-100');
			}, 10);

			activeModalCallback = (confirmed) => {
				const value = modalInput.value.trim();
				// Hide card and overlay
				modalCard.classList.remove('scale-100', 'opacity-100');
				modalCard.classList.add('scale-95', 'opacity-0');
				setTimeout(() => {
					modalOverlay.classList.add('hidden');
				}, 150);

				if (confirmed && onConfirm) {
					onConfirm(showInput ? value : true);
				}
			};
		}

		modalBtnCancel.onclick = () => {
			if (activeModalCallback) activeModalCallback(false);
		};

		modalBtnConfirm.onclick = () => {
			if (activeModalCallback) activeModalCallback(true);
		};

		modalInput.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				modalBtnConfirm.click();
			} else if (e.key === 'Escape') {
				modalBtnCancel.click();
			}
		});

		let files = {};
		let activeFile = 'index.pphx';
		let selectedPath = 'index.pphx';
		let selectedType = 'file';
		let inlineEditingPath = null;
		let inlineCreating = null;
		let inputEditor = null;
		let outputEditor = null;
		const collapsedDirs = new Set();

		let isSwitchingPlaybook = false;
		let activePlaybookId = localStorage.getItem('pphlx_active_playbook_id') || 'ecommerce';
		let playbooks = [];

		// Local client-side workspaces manifest
		let localWorkspaces = [];
		try {
			const storedLocal = localStorage.getItem('pphlx_local_workspaces');
			if (storedLocal) {
				localWorkspaces = JSON.parse(storedLocal);
			}
		} catch (e) {
			console.error("Failed to parse local workspaces manifest:", e);
		}

		function saveLocalWorkspaces() {
			localStorage.setItem('pphlx_local_workspaces', JSON.stringify(localWorkspaces));
		}

		function updateWorkspaceDeleteButton() {
			const btnDelete = document.getElementById('pb-ctx-delete');
			if (btnDelete) {
				const isLocal = localWorkspaces.some(ws => ws.id === activePlaybookId);
				if (isLocal) {
					btnDelete.classList.remove('hidden');
				} else {
					btnDelete.classList.add('hidden');
				}
			}
			const btnDeleteAll = document.getElementById('pb-ctx-delete-all');
			if (btnDeleteAll) {
				if (localWorkspaces.length > 0) {
					btnDeleteAll.classList.remove('hidden');
				} else {
					btnDeleteAll.classList.add('hidden');
				}
			}
		}

		function createLocalWorkspace(name) {
			const id = 'custom_ws_' + Date.now();
			const newWs = {
				id: id,
				name: name,
				files: ['index.pphx', 'Layout.pphx'],
				defaultFile: 'index.pphx'
			};

			const defaultLayoutContent = `[!DOCTYPE html]
[html]
[head]
    [title]PPHLX Preview[/title]
    <!-- Load required libraries for hydrated component islands -->
    [script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin][/script]
    [script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin][/script]
    [script src="https://unpkg.com/solid-js@1.8.0/dist/solid.js"][/script]
    [script src="https://cdn.tailwindcss.com"][/script]
    {{PPHLX_CSS}}
[/head]
[body class="bg-[#080a0d] min-h-screen flex flex-col items-center p-0"]
    [div class="w-full my-auto flex flex-col items-center py-8"]
        {{slot}}
    [/div]
    {{PPHLX_JS}}
[/body]
[/html]
`.replace(/\[/g, '<').replace(/\]/g, '>');

			const defaultIndexContent = `@import Layout from './Layout.pphx'

[Layout]
  [div class="w-full max-w-md bg-[#0f1115] border border-[#1b1f27] rounded-3xl p-8 text-center shadow-2xl"]
    [h1 class="text-2xl font-bold text-[#4bf3c8] mb-2">\${name}[/h1]
    [p class="text-sm text-gray-400 mb-6 font-sans">Your client-side local workspace is ready![/p]
    
    <!-- Try adding component imports or custom logic here -->
    [div class="text-[10px] text-gray-500 font-mono"]
      Edit index.pphx to get started.
    [/div]
  [/div]
[/Layout]
`.replace(/\[/g, '<').replace(/\]/g, '>');

			const workspaceVfs = {
				'index.pphx': defaultIndexContent,
				'Layout.pphx': defaultLayoutContent
			};

			localStorage.setItem(STORAGE_KEY + '_' + id, JSON.stringify(workspaceVfs));
			localWorkspaces.push(newWs);
			saveLocalWorkspaces();

			activePlaybookId = id;
			localStorage.setItem('pphlx_active_playbook_id', id);
			
			initPlaybooks();
		}

		function deleteLocalWorkspace(id) {
			showIdeModal({
				title: 'Delete Local Workspace',
				message: 'Are you sure you want to delete this local workspace? This action is permanent and cannot be undone.',
				confirmText: 'Delete',
				onConfirm: () => {
					localStorage.removeItem(STORAGE_KEY + '_' + id);
					localWorkspaces = localWorkspaces.filter(ws => ws.id !== id);
					saveLocalWorkspaces();

					activePlaybookId = 'ecommerce';
					localStorage.setItem('pphlx_active_playbook_id', activePlaybookId);
					initPlaybooks();
				}
			});
		}

		function deleteAllLocalWorkspaces() {
			showIdeModal({
				title: 'Delete All Local Workspaces',
				message: 'Are you sure you want to delete ALL local workspaces? This action is permanent and cannot be undone.',
				confirmText: 'Delete',
				onConfirm: () => {
					localWorkspaces.forEach(ws => {
						localStorage.removeItem(STORAGE_KEY + '_' + ws.id);
					});
					localWorkspaces = [];
					saveLocalWorkspaces();

					activePlaybookId = 'ecommerce';
					localStorage.setItem('pphlx_active_playbook_id', activePlaybookId);
					initPlaybooks();
				}
			});
		}

		// Wire playbook menu and context menu items
		const playbookCtxMenu = document.getElementById('playbook-context-menu');
		const playbookSelect = document.getElementById('playbook-select');
		const playbookSelectInput = document.getElementById('playbook-select-input');
		const playbookSelectArrow = document.getElementById('playbook-select-arrow');

		function showPlaybookContextMenu(x, y) {
			if (playbookCtxMenu) {
				playbookCtxMenu.style.left = `${x}px`;
				playbookCtxMenu.style.top = `${y}px`;
				playbookCtxMenu.classList.remove('hidden');
			}
		}
		function hidePlaybookContextMenu() {
			if (playbookCtxMenu) {
				playbookCtxMenu.classList.add('hidden');
			}
		}

		function showInlineWorkspaceInput() {
			if (playbookSelect && playbookSelectInput && playbookSelectArrow) {
				playbookSelect.classList.add('hidden');
				playbookSelectArrow.classList.add('hidden');
				playbookSelectInput.classList.remove('hidden');
				playbookSelectInput.value = '';
				playbookSelectInput.focus();
			}
		}

		function hideInlineWorkspaceInput() {
			if (playbookSelect && playbookSelectInput && playbookSelectArrow) {
				playbookSelect.classList.remove('hidden');
				playbookSelectArrow.classList.remove('hidden');
				playbookSelectInput.classList.add('hidden');
			}
		}

		if (playbookSelectInput) {
			playbookSelectInput.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					const name = playbookSelectInput.value.trim();
					if (name) {
						createLocalWorkspace(name);
					}
					hideInlineWorkspaceInput();
				} else if (e.key === 'Escape') {
					hideInlineWorkspaceInput();
				}
			});
			playbookSelectInput.addEventListener('blur', () => {
				setTimeout(() => {
					hideInlineWorkspaceInput();
				}, 150);
			});
		}

		// Bind Playbook Context Menu Items
		const pbCtxNew = document.getElementById('pb-ctx-new');
		if (pbCtxNew) {
			pbCtxNew.onclick = () => {
				hidePlaybookContextMenu();
				showInlineWorkspaceInput();
			};
		}

		const pbCtxDelete = document.getElementById('pb-ctx-delete');
		if (pbCtxDelete) {
			pbCtxDelete.onclick = () => {
				hidePlaybookContextMenu();
				deleteLocalWorkspace(activePlaybookId);
			};
		}

		const pbCtxDeleteAll = document.getElementById('pb-ctx-delete-all');
		if (pbCtxDeleteAll) {
			pbCtxDeleteAll.onclick = () => {
				hidePlaybookContextMenu();
				deleteAllLocalWorkspaces();
			};
		}

		const btnPlaybookMenu = document.getElementById('btn-playbook-menu');
		if (btnPlaybookMenu) {
			btnPlaybookMenu.addEventListener('click', (e) => {
				e.stopPropagation();
				const rect = btnPlaybookMenu.getBoundingClientRect();
				showPlaybookContextMenu(rect.left, rect.bottom + window.scrollY);
			});
		}

		async function initPlaybooks() {
			try {
				const response = await fetch('/playbooks/manifest.json?t=' + Date.now());
				if (response.ok) {
					const data = await response.json();
					playbooks = data.playbooks || [];
				}
			} catch (e) {
				console.error("Failed to load playbooks manifest:", e);
			}

			if (playbooks.length === 0) {
				console.error("Fatal: No playbooks loaded from manifest.");
				showIdeModal({
					title: 'Fatal Error',
					message: 'Failed to load playbooks from manifest.json. Please ensure public/playbooks/manifest.json is available on the server.',
					confirmText: 'OK',
					cancelText: 'hidden'
				});
				return;
			}

			const select = document.getElementById('playbook-select');
			if (select) {
				select.innerHTML = '';
				
				// 1. Group built-in playbooks
				const defaultGroup = document.createElement('optgroup');
				defaultGroup.label = 'Default Playbooks';
				playbooks.forEach(pb => {
					const opt = document.createElement('option');
					opt.value = pb.id;
					opt.textContent = pb.name;
					if (pb.id === activePlaybookId) {
						opt.selected = true;
					}
					defaultGroup.appendChild(opt);
				});
				select.appendChild(defaultGroup);

				// 2. Group local workspaces
				if (localWorkspaces.length > 0) {
					const localGroup = document.createElement('optgroup');
					localGroup.label = 'Local Workspaces';
					localWorkspaces.forEach(ws => {
						const opt = document.createElement('option');
						opt.value = ws.id;
						opt.textContent = ws.name;
						if (ws.id === activePlaybookId) {
							opt.selected = true;
						}
						localGroup.appendChild(opt);
					});
					select.appendChild(localGroup);
				}

				// Make sure activePlaybookId exists in either default or local list, fallback if deleted
				const isValidPlaybook = playbooks.some(p => p.id === activePlaybookId) || localWorkspaces.some(w => w.id === activePlaybookId);
				if (!isValidPlaybook) {
					activePlaybookId = playbooks[0].id;
					localStorage.setItem('pphlx_active_playbook_id', activePlaybookId);
					// Re-select option
					select.value = activePlaybookId;
				}

				updateWorkspaceDeleteButton();

				// Reconnect change listener only once
				select.onchange = async (e) => {
					activePlaybookId = e.target.value;
					localStorage.setItem('pphlx_active_playbook_id', activePlaybookId);
					updateWorkspaceDeleteButton();
					await loadPlaybookVfs(activePlaybookId);
				};
			}

			await loadPlaybookVfs(activePlaybookId);
		}

		async function loadPlaybookVfs(playbookId) {
			isSwitchingPlaybook = true;
			const storageKey = STORAGE_KEY + '_' + playbookId;
			const stored = localStorage.getItem(storageKey);
			
			if (stored) {
				try {
					files = JSON.parse(stored);
				} catch (e) {
					files = null;
				}
			}

			const isLocal = localWorkspaces.some(ws => ws.id === playbookId);

			if (isLocal) {
				const ws = localWorkspaces.find(w => w.id === playbookId);
				if (!files || Object.keys(files).length === 0) {
					files = {
						'index.pphx': `@import Layout from './Layout.pphx'\n\n[Layout]\n  [div class="w-full max-w-md bg-[#0f1115] border border-[#1b1f27] rounded-3xl p-8 text-center shadow-2xl"]\n    [h1 class="text-2xl font-bold text-[#4bf3c8] mb-2">${ws ? ws.name : 'Local App'}[/h1]\n    [p class="text-sm text-gray-400 mb-6 font-sans"]Your client-side local workspace is ready![/p]\n    [div class="text-[10px] text-gray-500 font-mono"]\n      Edit index.pphx to get started.\n    [/div]\n  [/div]\n[/Layout]`.replace(/\[/g, '<').replace(/\]/g, '>'),
						'Layout.pphx': [
							"<!DOCTYPE html>",
							"<html>",
							"<head>",
							"    <title>PPHLX Preview</title>",
							'    <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></s' + 'cript>',
							'    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></s' + 'cript>',
							'    <script src="https://unpkg.com/solid-js@1.8.0/dist/solid.js"></s' + 'cript>',
							'    <script src="https://cdn.tailwindcss.com"></s' + 'cript>',
							"    {{PPHLX_CSS}}",
							"</head>",
							'<body class="bg-[#080a0d] min-h-screen flex flex-col items-center p-0">',
							'    <div class="w-full my-auto flex flex-col items-center py-8">',
							"        {{slot}}",
							"    </div>",
							"    {{PPHLX_JS}}",
							"</body>",
							"</html>"
						].join('\n')
					};
					localStorage.setItem(storageKey, JSON.stringify(files));
				}
				activeFile = ws ? ws.defaultFile || 'index.pphx' : 'index.pphx';
				selectedPath = activeFile;
				document.getElementById('active-file-title').textContent = activeFile;
				
				if (inputEditor) {
					inputEditor.setValue(files[activeFile] || '');
					const ext = activeFile.split('.').pop();
					monaco.editor.setModelLanguage(inputEditor.getModel(), ext === 'pphx' ? 'pphlx' : (ext === 'js' ? 'javascript' : ext));
				}
				
				renderExplorer();
				triggerCompile();
				setTimeout(() => {
					isSwitchingPlaybook = false;
				}, 50);
				return;
			}

			const pb = playbooks.find(p => p.id === playbookId) || playbooks[0];
			if (!pb) {
				console.error("Fatal: Selected playbook was not found in manifest.");
				return;
			}

			const hasAllFiles = pb.files.every(f => files[f] !== undefined);

			if (!files || Object.keys(files).length === 0 || !hasAllFiles) {
				files = {};
				
				const fetchPromises = pb.files.map(async (filePath) => {
					try {
						const res = await fetch(`/playbooks/${playbookId}/${filePath}?t=${Date.now()}`);
						if (res.ok) {
							files[filePath] = await res.text();
						} else {
							console.error(`Fatal: Playbook file not found on server: /playbooks/${playbookId}/${filePath}`);
						}
					} catch (err) {
						console.error(`Fatal error loading file: ${filePath}`, err);
					}
				});

				await Promise.all(fetchPromises);
				const rawStorageKey = STORAGE_KEY + '_' + playbookId;
				localStorage.setItem(rawStorageKey, JSON.stringify(files));
			}

			activeFile = pb.defaultFile || 'index.pphx';
			selectedPath = activeFile;

			document.getElementById('active-file-title').textContent = activeFile;

			if (inputEditor) {
				inputEditor.setValue(files[activeFile] || '');
				const ext = activeFile.split('.').pop();
				monaco.editor.setModelLanguage(inputEditor.getModel(), ext === 'pphx' ? 'pphlx' : (ext === 'js' ? 'javascript' : ext));
			}

			renderExplorer();
			triggerCompile();
			
			// Small timeout to allow Monaco input/value events to fire completely before allowing edits to save
			setTimeout(() => {
				isSwitchingPlaybook = false;
			}, 50);
		}

		// Save Vfs state
		function saveVfs() {
			if (isSwitchingPlaybook) return;
			if (inputEditor) {
				files[activeFile] = inputEditor.getValue();
			}
			const storageKey = STORAGE_KEY + '_' + activePlaybookId;
			localStorage.setItem(storageKey, JSON.stringify(files));
		}

		// Convert flat file list to nested folder tree
		function buildTree(files) {
			const root = { name: 'root', type: 'directory', path: '', children: {} };
			
			for (let filePath in files) {
				const parts = filePath.split('/');
				let current = root;
				let accumulatedPath = '';
				
				for (let i = 0; i < parts.length; i++) {
					const part = parts[i];
					accumulatedPath = accumulatedPath ? `${accumulatedPath}/${part}` : part;
					const isLast = i === parts.length - 1;
					
					if (isLast) {
						current.children[part] = {
							name: part,
							type: 'file',
							path: filePath
						};
					} else {
						if (!current.children[part]) {
							current.children[part] = {
								name: part,
								type: 'directory',
								path: accumulatedPath,
								children: {}
							};
						}
						current = current.children[part];
					}
				}
			}
			if (inlineCreating) {
				let current = root;
				if (inlineCreating.parentPath) {
					const parts = inlineCreating.parentPath.split('/');
					for (let part of parts) {
						if (current.children[part]) {
							current = current.children[part];
						}
					}
				}
				current.children['__creating__'] = {
					name: '',
					type: inlineCreating.type === 'file' ? 'file' : 'directory',
					path: inlineCreating.parentPath ? `${inlineCreating.parentPath}/` : '',
					isCreating: true
				};
			}
			return root;
		}

		// Render Explorer File List
		function renderExplorer() {
			const container = document.getElementById('file-list');
			container.innerHTML = '';
			const tree = buildTree(files);
			
			// Sort children and render root level items
			Object.keys(tree.children).sort((a, b) => {
				const typeA = tree.children[a].type;
				const typeB = tree.children[b].type;
				if (typeA !== typeB) {
					return typeA === 'directory' ? -1 : 1;
				}
				return a.localeCompare(b);
			}).forEach(childName => {
				renderTreeNode(tree.children[childName], 0, container);
			});
		}

		// Recursive tree node renderer
		function renderTreeNode(node, depth, container) {
			if (node.type === 'directory') {
				const isCollapsed = collapsedDirs.has(node.path);
				const isSelected = node.path === selectedPath;
				const isEditing = node.path === inlineEditingPath;
				const isCreating = node.isCreating;
				
				const div = document.createElement('div');
				div.className = `flex items-center justify-between px-3 py-1 rounded text-xs font-medium cursor-pointer transition-colors group ${
					isSelected ? 'bg-[#1b1f27]/70 text-white border-l-2 border-[#54b9ff]' : 'text-astro-gray-300 hover:bg-[#151821] hover:text-white'
				}`;
				div.style.paddingLeft = `${(depth * 12) + 8}px`;
				
				const leftSide = document.createElement('div');
				leftSide.className = 'flex items-center gap-1.5 w-full truncate';
				
				if (!isCreating && !isEditing) {
					const chevron = document.createElement('span');
					chevron.className = 'flex items-center text-[10px] text-astro-gray-400';
					chevron.innerHTML = isCollapsed 
						? `<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>`
						: `<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>`;
					leftSide.appendChild(chevron);
				} else {
					const chevronDummy = document.createElement('span');
					chevronDummy.className = 'w-3';
					leftSide.appendChild(chevronDummy);
				}
				
				const folderIcon = document.createElement('span');
				folderIcon.className = 'text-[#87a5e6] flex items-center';
				folderIcon.innerHTML = isCollapsed
					? `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" /></svg>`
					: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4l2 2h4a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2Vzm10 4a1 1 0 100-2h-3a1 1 0 000 2h3z" clip-rule="evenodd" /></svg>`;
				leftSide.appendChild(folderIcon);
				
				if (isCreating || isEditing) {
					const input = document.createElement('input');
					input.type = 'text';
					input.className = 'w-full px-1 py-0.5 text-[11px] rounded bg-[#171a21] border border-[#232731] text-white focus:outline-none focus:border-[#54b9ff] font-mono';
					input.value = isEditing ? node.name : '';
					
					const finishAction = () => {
						const val = input.value.trim();
						if (!val) {
							inlineCreating = null;
							inlineEditingPath = null;
							renderExplorer();
							return;
						}
						if (isCreating) {
							const newPath = node.path ? `${node.path}${val}/.gitkeep` : `${val}/.gitkeep`;
							files[newPath] = '';
							saveVfs();
							inlineCreating = null;
							selectedPath = node.path ? `${node.path}${val}` : val;
							selectedType = 'directory';
							renderExplorer();
						} else {
							const parentParts = node.path.split('/');
							parentParts.pop();
							const parentPath = parentParts.join('/');
							const newPath = parentPath ? `${parentPath}/${val}` : val;
							renameVfsPath(node.path, newPath);
							inlineEditingPath = null;
						}
					};

					input.onkeydown = (e) => {
						if (e.key === 'Enter') {
							finishAction();
						} else if (e.key === 'Escape') {
							inlineCreating = null;
							inlineEditingPath = null;
							renderExplorer();
						}
					};
					input.onblur = finishAction;
					leftSide.appendChild(input);
					div.appendChild(leftSide);
					container.appendChild(div);
					setTimeout(() => input.focus(), 50);
				} else {
					const nameLabel = document.createElement('span');
					nameLabel.className = 'font-sans font-medium tracking-wide';
					nameLabel.textContent = node.name;
					leftSide.appendChild(nameLabel);
					div.appendChild(leftSide);
					
					div.onclick = (e) => {
						e.stopPropagation();
						selectedPath = node.path;
						selectedType = 'directory';
						if (isCollapsed) {
							collapsedDirs.delete(node.path);
						} else {
							collapsedDirs.add(node.path);
						}
						renderExplorer();
					};

					div.oncontextmenu = (e) => {
						e.preventDefault();
						e.stopPropagation();
						selectedPath = node.path;
						selectedType = 'directory';
						showContextMenu(e.clientX, e.clientY);
					};
					
					const actions = document.createElement('div');
					actions.className = 'flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity';
					
					const addFileBtn = document.createElement('button');
					addFileBtn.className = 'hover:text-[#4bf3c8] p-0.5';
					addFileBtn.title = 'New File';
					addFileBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`;
					addFileBtn.onclick = (e) => {
						e.stopPropagation();
						selectedPath = node.path;
						selectedType = 'directory';
						startInlineCreation('file');
					};
					actions.appendChild(addFileBtn);

					const menuBtn = document.createElement('button');
					menuBtn.className = 'hover:text-[#54b9ff] p-0.5';
					menuBtn.title = 'More Actions';
					menuBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" /></svg>`;
					menuBtn.onclick = (e) => {
						e.stopPropagation();
						showContextMenuAtElement(menuBtn, node.path, 'directory');
					};
					actions.appendChild(menuBtn);
					
					div.appendChild(actions);
					container.appendChild(div);
					
					if (!isCollapsed) {
						Object.keys(node.children).sort((a, b) => {
							const typeA = node.children[a].type;
							const typeB = node.children[b].type;
							if (typeA !== typeB) {
								return typeA === 'directory' ? -1 : 1;
							}
							return a.localeCompare(b);
						}).forEach(childName => {
							renderTreeNode(node.children[childName], depth + 1, container);
						});
					}
				}
			} else {
				const isSelected = node.path === selectedPath;
				const isActive = node.path === activeFile;
				const isEditing = node.path === inlineEditingPath;
				const isCreating = node.isCreating;
				
				const div = document.createElement('div');
				div.className = `flex items-center justify-between px-3 py-1 rounded text-xs font-medium cursor-pointer transition-colors group ${
					isActive ? 'bg-[#1b1f27] text-white border-l-2 border-[#54b9ff]' : isSelected ? 'bg-[#171a21]/50 border-l border-[#54b9ff]/30 text-white' : 'text-astro-gray-300 hover:bg-[#151821] hover:text-white'
				}`;
				div.style.paddingLeft = `${(depth * 12) + 22}px`;
				
				const leftSide = document.createElement('div');
				leftSide.className = 'flex items-center gap-1.5 w-full truncate';
				
				const ext = (isCreating || !node.name) ? 'pphx' : node.name.split('.').pop();
				let fileIconHtml = '';
				let fileIconColor = 'text-astro-gray-400';
				
				if (ext === 'svelte') {
					fileIconHtml = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>`;
					fileIconColor = 'text-[#ff3e00]';
				} else if (ext === 'js' || ext === 'jsx') {
					fileIconHtml = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h18v18H3V3zm12.54 11.23c-.34-.58-.84-.96-1.53-1.11-.47-.11-.96-.16-1.44-.22v1.92c.38.05.74.19 1.05.41.25.18.42.44.49.74.07.31.06.63-.03.93-.15.42-.48.74-.91.88-.41.13-.85.12-1.25-.03-.32-.12-.6-.33-.79-.61-.26-.39-.37-.87-.31-1.34l-1.92.36c-.08.77.16 1.54.67 2.12.51.58 1.22.95 1.99 1.02.82.08 1.65-.12 2.33-.56.68-.45 1.15-1.15 1.28-1.96.14-.85-.16-1.72-.81-2.3z"/></svg>`;
					fileIconColor = 'text-[#f7df1e]';
				} else if (ext === 'pphx' || ext === 'php') {
					fileIconHtml = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`;
					fileIconColor = 'text-[#4bf3c8]';
				} else {
					fileIconHtml = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`;
				}
				
				const iconSpan = document.createElement('span');
				iconSpan.className = fileIconColor + ' flex items-center';
				iconSpan.innerHTML = fileIconHtml;
				leftSide.appendChild(iconSpan);
				
				if (isCreating || isEditing) {
					const input = document.createElement('input');
					input.type = 'text';
					input.className = 'w-full px-1 py-0.5 text-[11px] rounded bg-[#171a21] border border-[#232731] text-white focus:outline-none focus:border-[#54b9ff] font-mono';
					input.value = isEditing ? node.name : '';
					
					const finishAction = () => {
						const val = input.value.trim();
						if (!val) {
							inlineCreating = null;
							inlineEditingPath = null;
							renderExplorer();
							return;
						}
						if (isCreating) {
							const newPath = node.path ? `${node.path}${val}` : val;
							files[newPath] = '';
							saveVfs();
							inlineCreating = null;
							activeFile = newPath;
							selectedPath = newPath;
							selectedType = 'file';
							switchFile(newPath);
						} else {
							const parentParts = node.path.split('/');
							parentParts.pop();
							const parentPath = parentParts.join('/');
							const newPath = parentPath ? `${parentPath}/${val}` : val;
							renameVfsPath(node.path, newPath);
							inlineEditingPath = null;
						}
					};

					input.onkeydown = (e) => {
						if (e.key === 'Enter') {
							finishAction();
						} else if (e.key === 'Escape') {
							inlineCreating = null;
							inlineEditingPath = null;
							renderExplorer();
						}
					};
					input.onblur = finishAction;
					leftSide.appendChild(input);
					div.appendChild(leftSide);
					container.appendChild(div);
					setTimeout(() => input.focus(), 50);
				} else {
					const nameLabel = document.createElement('span');
					nameLabel.className = 'font-mono truncate';
					nameLabel.textContent = node.name;
					leftSide.appendChild(nameLabel);
					div.appendChild(leftSide);
					
					div.onclick = (e) => {
						e.stopPropagation();
						selectedPath = node.path;
						selectedType = 'file';
						switchFile(node.path);
					};

					div.oncontextmenu = (e) => {
						e.preventDefault();
						e.stopPropagation();
						selectedPath = node.path;
						selectedType = 'file';
						showContextMenu(e.clientX, e.clientY);
					};
					
					const menuBtn = document.createElement('button');
					menuBtn.className = 'opacity-0 group-hover:opacity-100 hover:text-[#54b9ff] p-0.5 transition-opacity';
					menuBtn.title = 'More Actions';
					menuBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" /></svg>`;
					menuBtn.onclick = (e) => {
						e.stopPropagation();
						showContextMenuAtElement(menuBtn, node.path, 'file');
					};
					div.appendChild(menuBtn);
					container.appendChild(div);
				}
			}
		}

		// Helper to create and activate a new VFS file
		function createVfsFile(filePath) {
			const cleanPath = filePath.trim();
			if (!cleanPath) return;
			if (files[cleanPath]) {
				alert('File already exists!');
				return;
			}
			files[cleanPath] = '';
			saveVfs();
			switchFile(cleanPath);
		}

		// Switch Active File
		function switchFile(filePath) {
			if (filePath === activeFile) return;
			saveVfs();
			activeFile = filePath;
			document.getElementById('active-file-title').textContent = filePath;
			
			const ext = filePath.split('.').pop().toLowerCase();
			const isImage = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg'].includes(ext);
			const isBinary = isImage && ext !== 'svg' && files[filePath] && files[filePath].startsWith('data:image/');

			const inputEditorEl = document.getElementById('input-editor');
			const imagePreviewContainer = document.getElementById('image-preview-container');
			const imagePreviewElement = document.getElementById('image-preview-element');
			const imagePreviewPath = document.getElementById('image-preview-path');
			const imagePreviewDimensions = document.getElementById('image-preview-dimensions');
			const imagePreviewLevelSize = document.getElementById('image-preview-size');

			if (isBinary) {
				inputEditorEl.style.display = 'none';
				imagePreviewContainer.classList.remove('hidden');
				imagePreviewContainer.style.display = 'flex';
				
				imagePreviewPath.textContent = filePath;
				imagePreviewElement.src = files[filePath];
				
				const img = new Image();
				img.onload = () => {
					imagePreviewDimensions.textContent = `${img.width} x ${img.height} pixels`;
				};
				img.src = files[filePath];
				
				const base64Str = files[filePath].split(',')[1] || '';
				const decodedLength = atob(base64Str).length;
				let sizeStr = `${decodedLength} B`;
				if (decodedLength > 1024 * 1024) {
					sizeStr = `${(decodedLength / (1024 * 1024)).toFixed(2)} MB`;
				} else if (decodedLength > 1024) {
					sizeStr = `${(decodedLength / 1024).toFixed(2)} KB`;
				}
				imagePreviewLevelSize.textContent = sizeStr;
			} else {
				inputEditorEl.style.display = 'block';
				imagePreviewContainer.classList.add('hidden');
				imagePreviewContainer.style.display = 'none';

				if (inputEditor) {
					inputEditor.setValue(files[activeFile]);
					let lang = 'html';
					if (ext === 'js' || ext === 'jsx') lang = 'javascript';
					else if (ext === 'ts' || ext === 'tsx') lang = 'typescript';
					else if (ext === 'svelte') lang = 'html';
					else if (ext === 'pphx') lang = 'pphlx';
					
					monaco.editor.setModelLanguage(inputEditor.getModel(), lang);
				}
			}
			
			renderExplorer();
			triggerCompile();
		}

		// Sidebar Header Action Buttons (Root level creation)
		const btnRootUploadFile = document.getElementById('btn-root-upload-file');
		const fileUploader = document.getElementById('file-uploader');
		if (btnRootUploadFile && fileUploader) {
			btnRootUploadFile.onclick = () => {
				fileUploader.click();
			};
			fileUploader.onchange = (e) => {
				const filesList = e.target.files;
				if (!filesList || filesList.length === 0) return;
				
				let parent = '';
				if (selectedPath) {
					if (selectedType === 'directory') {
						parent = selectedPath + '/';
					} else {
						const parts = selectedPath.split('/');
						parts.pop();
						parent = parts.length > 0 ? parts.join('/') + '/' : '';
					}
				}

				for (let i = 0; i < filesList.length; i++) {
					const file = filesList[i];
					const reader = new FileReader();
					const targetPath = `${parent}${file.name}`;
					
					if (file.name.endsWith('.svg')) {
						reader.onload = (event) => {
							files[targetPath] = event.target.result;
							saveVfs();
							renderExplorer();
							triggerCompile();
						};
						reader.readAsText(file);
					} else {
						reader.onload = (event) => {
							files[targetPath] = event.target.result;
							saveVfs();
							renderExplorer();
							triggerCompile();
						};
						reader.readAsDataURL(file);
					}
				}
			};
		}

