		// Delete File or Directory
		function deleteFile(filePath) {
			showIdeModal({
				title: 'Delete Item',
				message: `Are you sure you want to delete ${filePath}? This action cannot be undone.`,
				confirmText: 'Delete',
				onConfirm: () => {
					if (files[filePath] !== undefined) {
						delete files[filePath];
					} else {
						const prefix = filePath + '/';
						for (let p in files) {
							if (p.startsWith(prefix)) {
								delete files[p];
							}
						}
					}
					saveVfs();
					
					if (activeFile === filePath || !files[activeFile]) {
						activeFile = Object.keys(files)[0] || 'index.pphx';
					}
					
					document.getElementById('active-file-title').textContent = activeFile;
					if (inputEditor && files[activeFile]) {
						inputEditor.setValue(files[activeFile]);
					}
					renderExplorer();
					doCompile();
				}
			});
		}

		// TextMate-to-Monarch runtime compiler
		function compileTextMateToMonarch(tmGrammar) {
			const isPphlx = tmGrammar && (
				(tmGrammar.name && tmGrammar.name.toLowerCase().includes('pphlx')) ||
				(tmGrammar.scopeName && tmGrammar.scopeName.toLowerCase().includes('pphlx'))
			);
			
			if (isPphlx) {
				return {
					defaultToken: '',
					tokenPostfix: '.pphlx',
					keywords: [
						'abstract', 'and', 'array', 'as', 'break', 'callable', 'case', 'catch', 
						'class', 'clone', 'const', 'continue', 'declare', 'default', 'die', 
						'do', 'echo', 'else', 'elseif', 'empty', 'enddeclare', 'endfor', 
						'endforeach', 'endif', 'endswitch', 'endwhile', 'eval', 'exit', 
						'extends', 'final', 'finally', 'for', 'foreach', 'function', 'global', 
						'goto', 'if', 'implements', 'include', 'include_once', 'instanceof', 
						'insteadof', 'interface', 'isset', 'list', 'namespace', 'new', 'or', 
						'print', 'private', 'protected', 'public', 'require', 'require_once', 
						'return', 'static', 'switch', 'throw', 'trait', 'try', 'unset', 'use', 
						'var', 'while', 'xor', 'yield', 'import', 'from'
					],
					tokenizer: {
						root: [
							// Import directives: @import BuyButton from '../components/BuyButton.jsx'
							[/^\s*@@import\s+[A-Z]\w*\s+from\s+['"][^'"]+['"]/, 'keyword'],
							
							// Match embedded PPHLX/PHP code
							[/\{\|=?/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
							[/<\?php/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
							
							// Match HTML comments
							[/<!--/, 'comment', '@htmlComment'],
							
							// Match HTML tag openings & declarations
							[/Metatag/, 'metatag', '@doctype'],
							[/<\/[a-zA-Z0-9\-:]+>/, 'tag'],
							[/<[a-zA-Z0-9\-:]+/, 'tag', '@htmlTag'],
							
							// Fallback text
							[/[^<{]+/, ''],
							[/./, '']
						],
						doctype: [
							[/[^>]+/, 'metatag'],
							[/>/, 'metatag', '@pop']
						],
						htmlComment: [
							[/-->/, 'comment', '@pop'],
							[/[^-->]+/, 'comment'],
							[/./, 'comment']
						],
						htmlTag: [
							[/>/, 'tag', '@pop'],
							[/\/>/, 'tag', '@pop'],
							[/[a-zA-Z0-9\-:]+\s*=/, 'attribute.name'],
							[/"([^"\\]|\\.)*"/, 'string'],
							[/'([^'\\]|\\.)*'/, 'string'],
							[/[a-zA-Z0-9\-:]+/, 'attribute.value'],
							[/[ \t\r\n]+/, '']
						],
						phpEmbedded: [
							[/\|\}/, { token: 'delimiter.embedded', next: '@pop' }],
							[/\?>/, { token: 'delimiter.embedded', next: '@pop' }],
							
							// PHP Variables
							[/\$[a-zA-Z_]\w*/, 'variable'],
							
							// PHP Keywords
							[/[a-zA-Z_]\w*/, {
								cases: {
									'@keywords': 'keyword',
									'@default': 'identifier'
								}
							}],
							
							// PHP Strings
							[/"([^"\\]|\\.)*"/, 'string'],
							[/'([^'\\]|\\.)*'/, 'string'],
							
							// PHP Numbers
							[/\d+/, 'number'],
							
							// PHP Comments
							[/\/\/(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
							[/#(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
							[/\/\*/, 'comment', '@phpComment'],
							
							// Delimiters & operators
							[/[{}()\[\],;+\-*\/%=&|^!<>]/, 'delimiter'],
							[/[ \t\r\n]+/, '']
						],
						phpComment: [
							[/\*\//, 'comment', '@pop'],
							[/[^*]+/, 'comment'],
							[/./, 'comment']
						]
					}
				};
			}

			const scopeMap = {
				'comment': 'comment',
				'keyword': 'keyword',
				'string': 'string',
				'variable': 'variable',
				'constant.numeric': 'number',
				'storage': 'keyword',
				'entity.name.tag': 'tag',
				'entity.other.attribute-name': 'attribute.name',
				'punctuation': 'delimiter',
				'support': 'keyword'
			};

			function mapScope(scope) {
				if (!scope) return 'identifier';
				for (let key in scopeMap) {
					if (scope.includes(key)) return scopeMap[key];
				}
				return 'identifier';
			}

			const monarch = {
				tokenizer: {
					root: []
				}
			};

			if (tmGrammar && Array.isArray(tmGrammar.patterns)) {
				tmGrammar.patterns.forEach((pattern, index) => {
					// 1. Convert simple matches
					if (pattern.match) {
						let jsRegex;
						try {
							jsRegex = new RegExp(pattern.match.replace(/\\4/g, '').replace(/\\1/g, ''));
						} catch (e) {
							return; // Skip invalid JS regular expressions
						}

						if (pattern.captures) {
							const tokens = [];
							const maxGroup = Math.max(...Object.keys(pattern.captures).map(Number));
							for (let i = 1; i <= maxGroup; i++) {
								const capture = pattern.captures[i];
								tokens.push(mapScope(capture ? capture.name : ''));
							}
							monarch.tokenizer.root.push([jsRegex, tokens]);
						} else {
							monarch.tokenizer.root.push([jsRegex, mapScope(pattern.name)]);
						}
					}

					// 2. Convert begin/end block scopes (e.g. PHP brackets)
					if (pattern.begin && pattern.end) {
						const stateName = `state_${index}`;
						let beginRegex, endRegex;
						try {
							beginRegex = new RegExp(pattern.begin);
							endRegex = new RegExp(pattern.end);
						} catch (e) {
							return;
						}

						// Root transition
						monarch.tokenizer.root.push([beginRegex, { token: 'delimiter.embedded', next: '@' + stateName }]);

						// State definition
						monarch.tokenizer[stateName] = [
							[endRegex, { token: 'delimiter.embedded', next: '@pop' }]
						];

						// Inject inner patterns
						if (Array.isArray(pattern.patterns)) {
							pattern.patterns.forEach(inner => {
								if (inner.match) {
									try {
										monarch.tokenizer[stateName].push([new RegExp(inner.match), mapScope(inner.name)]);
									} catch (e) {}
								}
							});
						}

						// Default fallback for embedded code (e.g. PHP syntax fallback highlights)
						monarch.tokenizer[stateName].push([/[^|]+/, 'variable']);
					}
				});
			}

			// Add basic defaults for standard tags/words
			monarch.tokenizer.root.push([/[a-zA-Z_]\w*/, 'identifier']);

			return monarch;
		}

		// VS Code VSIX file unpacker and language contributor
		async function loadExtensionFromVsix(fileDataOrUrl) {
			try {
				const zip = new JSZip();
				let loadedZip;
				
				if (typeof fileDataOrUrl === 'string') {
					const response = await fetch(fileDataOrUrl);
					const blob = await response.blob();
					loadedZip = await zip.loadAsync(blob);
				} else {
					loadedZip = await zip.loadAsync(fileDataOrUrl);
				}

				// Find package.json
				const packageJsonFile = loadedZip.file("extension/package.json");
				if (!packageJsonFile) return null;
				
				const packageJsonText = await packageJsonFile.async("string");
				const manifest = JSON.parse(packageJsonText);

				if (!manifest.contributes || !manifest.contributes.languages) return null;

				const results = [];

				for (let lang of manifest.contributes.languages) {
					// Find grammar definition
					const grammarContrib = manifest.contributes.grammars.find(g => g.language === lang.id);
					if (!grammarContrib) continue;

					// Load grammar file
					const grammarPath = grammarContrib.path.replace(/^\.\//, 'extension/');
					const grammarFile = loadedZip.file(grammarPath);
					if (!grammarFile) continue;

					const grammarText = await grammarFile.async("string");
					const tmGrammar = JSON.parse(grammarText);

					// Compile TextMate to Monarch
					const monarchGrammar = compileTextMateToMonarch(tmGrammar);

					// Register language in Monaco if not already registered
					const isRegistered = monaco.languages.getLanguages().some(l => l.id === lang.id);
					if (!isRegistered) {
						monaco.languages.register({ id: lang.id, extensions: lang.extensions });
					}
					monaco.languages.setMonarchTokensProvider(lang.id, monarchGrammar);

					results.push({
						id: lang.id,
						extensions: lang.extensions,
						monarch: monarchGrammar
					});
				}

				// Save custom language definition to local storage to persist custom uploaded extensions
				if (results.length > 0) {
					const savedLangs = JSON.parse(localStorage.getItem(CUSTOM_LANGS_KEY) || '[]');
					results.forEach(res => {
						const existingIdx = savedLangs.findIndex(l => l.id === res.id);
						if (existingIdx > -1) {
							savedLangs[existingIdx] = res;
						} else {
							savedLangs.push(res);
						}
					});
					localStorage.setItem(CUSTOM_LANGS_KEY, JSON.stringify(savedLangs));
				}

				return results;

			} catch (e) {
				console.error("Failed to load extension:", e);
				return null;
			}
		}

		// Simple compiler implementation for template parsing
		function compilePphlx(code) {
			const start = performance.now();
			let imports = [];
			
			// 1. Process @import statements
			const lines = code.split('\n');
			const cleanLines = [];
			
			for (let line of lines) {
				const importMatch = line.match(/^\s*@import\s+(\w+)\s+from\s+['"]([^'"]+)['"]/);
				if (importMatch) {
					imports.push({
						name: importMatch[1],
						path: importMatch[2]
					});
				} else {
					cleanLines.push(line);
				}
			}
			
			let outputCode = cleanLines.join('\n');
			
			// 2. Parse brackets {|= ... |} -> <?php echo ...; ?>
			outputCode = outputCode.replace(/\{\|=\s*([\s\S]*?)\s*\|\}/g, (match, expression) => {
				const cleanExpr = expression.trim().replace(/;$/, '');
				return `<?php echo ${cleanExpr}; ?>`;
			});
			
			// 3. Parse brackets {| ... |} -> <?php ... ?>
			outputCode = outputCode.replace(/\{\|\s*([\s\S]*?)\s*\|\}/g, (match, block) => {
				return `<?php\n${block.trim()}\n?>`;
			});
			
			// 4. Parse components
			for (let item of imports) {
				const tagRegex = new RegExp(`<${item.name}\\s*([^>]*?)\\s*\\/>`, 'g');
				outputCode = outputCode.replace(tagRegex, (match, attributes) => {
					const attrMatches = attributes.matchAll(/(\w+[\w:-]*)(?:=["']([^"']*)["']|=\{([\s\S]*?)\})?/g);
					
					let isClient = false;
					let clientMode = 'load';
					let phpProps = [];
					
					for (let am of attrMatches) {
						const name = am[1];
						const staticVal = am[2];
						const dynamicVal = am[3];
						
						if (name === 'client:load') {
							isClient = true;
							clientMode = 'load';
						} else if (name.startsWith('client:')) {
							isClient = true;
							clientMode = name.replace('client:', '');
						} else {
							if (dynamicVal !== undefined) {
								phpProps.push(`"${name}" => ${dynamicVal}`);
							} else {
								phpProps.push(`"${name}" => "${staticVal || ''}"`);
							}
						}
					}
					
					const uniqueId = `pphlx-${item.name.toLowerCase()}-\${uniqid()}`;
					
					if (isClient) {
						return `<div id="<?php echo "${uniqueId}"; ?>" class="pphlx-island" data-component="${item.name}" data-hydrate="${clientMode}"></div>
<script>
  window.__PPHLX_DATA__ = window.__PPHLX_DATA__ || {};
  window.__PPHLX_DATA__["<?php echo "${uniqueId}"; ?>"] = <?php echo json_encode([${phpProps.join(', ')}]); ?>;
<\/script>`;
					} else {
						return `<div class="pphlx-component" data-component="${item.name}"></div>`;
					}
				});
			}
			
			const elapsed = (performance.now() - start).toFixed(1);
			return {
				php: outputCode.trimStart(),
				time: elapsed
			};
		}

		// Perform compilation of active file and refresh HTML iframe sandbox
		function doCompile() {
			if (!inputEditor || !outputEditor) return;
			
			const code = inputEditor.getValue();
			const result = compilePphlx(code);
			outputEditor.setValue(result.php);
			document.getElementById('compile-time').textContent = `Compiled in ${result.time}ms`;
			
			// Update iframe preview
			const iframe = document.getElementById('preview-iframe');
			const doc = iframe.contentDocument || iframe.contentWindow.document;
			doc.open();
			
			const mockCss = `
				body { margin: 0; padding: 24px; font-family: 'Inter', sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #080a0d; }
				.pphlx-island { border: 2px dashed #3a3f50; padding: 12px; border-radius: 8px; text-align: center; color: #858b98; font-family: monospace; background: #111318; margin: 8px 0; font-size: 11px; }
				
				/* Custom Scrollbar for Preview Iframe */
				::-webkit-scrollbar {
					width: 8px;
					height: 8px;
				}
				::-webkit-scrollbar-track {
					background: #0c0e12;
				}
				::-webkit-scrollbar-thumb {
					background: #23262d;
					border-radius: 4px;
				}
				::-webkit-scrollbar-thumb:hover {
					background: #343841;
				}
			`;
			
			const phpState = {};
			const varMatches = result.php.matchAll(/\$(\w+)\s*=\s*([^;]+);/g);
			for (let vm of varMatches) {
				const name = vm[1];
				let valStr = vm[2].trim();
				if ((valStr.startsWith('"') && valStr.endsWith('"')) || (valStr.startsWith("'") && valStr.endsWith("'"))) {
					valStr = valStr.substring(1, valStr.length - 1);
				}
				phpState[name] = valStr;
			}

			let previewHtml = result.php.replace(/<\?php[\s\S]*?\?>/g, (match) => {
				if (match.includes('echo "PPHLX-')) {
					const idMatch = match.match(/echo\s+['"](pphlx-[a-zA-Z0-9_-]+)/);
					return idMatch ? idMatch[1] : 'pphlx-comp';
				}
				if (match.includes('echo json_encode')) {
					return '{}';
				}
				const echoVarMatch = match.match(/echo\s+\$(\w+)/);
				if (echoVarMatch && phpState[echoVarMatch[1]] !== undefined) {
					return phpState[echoVarMatch[1]];
				}
				if (match.includes('number_format')) {
					const numMatch = match.match(/number_format\(\$(\w+)/);
					if (numMatch && phpState[numMatch[1]] !== undefined) {
						return Number(phpState[numMatch[1]]).toFixed(2);
					}
				}
				return '';
			});

			// Substitute local file path references with actual virtual base64/SVG sources
			for (let path in files) {
				const isDataUrl = typeof files[path] === 'string' && files[path].startsWith('data:image/');
				const isSvg = path.endsWith('.svg');
				let replacement = '';
				
				if (isSvg) {
					replacement = `data:image/svg+xml;utf8,${encodeURIComponent(files[path])}`;
				} else if (isDataUrl) {
					replacement = files[path];
				}
				
				if (replacement) {
					const regex = new RegExp(`(['"])${path}(['"])`, 'g');
					previewHtml = previewHtml.replace(regex, `$1${replacement}$2`);
				}
			}

			const hydrationScript = `
				<script>
					(function() {
						document.querySelectorAll('.pphlx-island').forEach(island => {
							const component = island.getAttribute('data-component');
							
							if (component === 'ProductImage') {
								const data = window.__PPHLX_DATA__[island.id] || {};
								const url = data.url || '/assets/mac-macbook-pro.webp';
								const badge = data.badge || 'Pro Choice';
								island.innerHTML = \`
									<div style="position: relative; overflow: hidden; border-radius: 24px 24px 0 0; background: linear-gradient(to bottom, #1b202e, #0d0f14); height: 208px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid #1f2430;">
										<img src="\${url}" style="object-fit: cover; width: 80%; height: auto; transition: transform 0.5s;" />
										<span style="position: absolute; top: 16px; left: 16px; background: rgba(75, 243, 200, 0.15); border: 1px solid rgba(75, 243, 200, 0.3); color: #4bf3c8; backdrop-filter: blur(8px); text-shadow: 0 0 4px rgba(75,243,200,0.2); font-size: 9px; font-weight: bold; padding: 4px 10px; border-radius: 8px; box-shadow: 0 0 15px rgba(75, 243, 200, 0.15); text-transform: uppercase; letter-spacing: 0.05em;">\${badge}</span>
									</div>
								\`;
								island.style.border = 'none';
								island.style.background = 'transparent';
								island.style.padding = '0';
								island.style.margin = '0';
							}
							
							if (component === 'StarRating') {
								const data = window.__PPHLX_DATA__[island.id] || {};
								let rating = data.initialRating || 5;
								const renderStars = () => {
									let stars = '';
									for (let i = 1; i <= 5; i++) {
										stars += \`
											<button class="star-btn" data-star="\${i}" style="background: none; border: none; cursor: pointer; padding: 0; outline: none; transition: transform 0.2s;">
												<svg style="width: 16px; height: 16px; fill: \${i <= rating ? '#4bf3c8' : 'none'}; stroke: #4bf3c8; stroke-width: 1.8px; filter: \${i <= rating ? 'drop-shadow(0 0 4px rgba(75, 243, 200, 0.45))' : ''}; transition: all 0.15s;" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.969 0 1.371 1.24.588 1.81l-3.97 2.883a1 1 0 00-.364 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.971-2.883a1 1 0 00-1.18 0l-3.97 2.883c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.364-1.118l-3.97-2.883c-.783-.57-.38-1.81.588-1.81h4.906a1 1 0 00.95-.69l1.519-4.674z" />
												</svg>
											</button>
										\`;
									}
									island.innerHTML = \`
										<div style="display: flex; align-items: center; gap: 6px; margin: 12px 0;">
											\${stars}
											<span style="color: rgba(75, 243, 200, 0.8); font-size: 10px; font-family: monospace; margin-left: 6px; background: rgba(75, 243, 200, 0.1); border: 1px solid rgba(75, 243, 200, 0.2); padding: 2px 6px; border-radius: 4px;">(\${rating}/5)</span>
										</div>
									\`;
									island.querySelectorAll('.star-btn').forEach(btn => {
										btn.onclick = (e) => {
											e.stopPropagation();
											rating = parseInt(btn.getAttribute('data-star'));
											renderStars();
										};
									});
								};
								renderStars();
								island.style.border = 'none';
								island.style.background = 'transparent';
								island.style.padding = '0';
								island.style.margin = '0';
							}
							
							if (component === 'BuyButton') {
								const data = window.__PPHLX_DATA__[island.id] || {};
								const stock = data.stock || 3;
								let count = 0;
								const renderButton = () => {
									island.innerHTML = \`
										<div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
											<button class="buy-btn" style="background: linear-gradient(135deg, #4bf3c8, #00d2a0); border: none; color: #080a0d; font-size: 11px; font-weight: 800; padding: 8px 16px; border-radius: 12px; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 20px rgba(75, 243, 200, 0.35); outline: none;">
												<svg style="width: 14px; height: 14px; stroke: #080a0d;" fill="none" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
												Add \${count > 0 ? \`(\${count})\` : ''}
											</button>
											\${count >= stock ? \`<span style="color: #ef4444; font-size: 9px; font-weight: bold; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); padding: 2px 8px; border-radius: 6px; box-shadow: 0 0 8px rgba(239,68,68,0.15);">Max stock reached</span>\` : ''}
										</div>
									\`;
									island.querySelector('.buy-btn').onclick = (e) => {
										e.stopPropagation();
										if (count < stock) {
											count++;
											renderButton();
										}
									};
								};
								renderButton();
								island.style.border = 'none';
								island.style.background = 'transparent';
								island.style.padding = '0';
								island.style.margin = '0';
							}
						});
					})();
				<\/script>
			`;
			
			doc.write(`
				<!DOCTYPE html>
				<html>
				<` + `head>
					<style>${mockCss}</style>
					<script src="https://cdn.tailwindcss.com"><` + `/script>
				</` + `head>
				<` + `body>
					${previewHtml}
					${hydrationScript}
				</` + `body>
				</html>
			`);
			doc.close();
		}

		// Initialize Monaco safely
		function initMonaco() {
			if (typeof require === 'undefined') {
				setTimeout(initMonaco, 100);
				return;
			}
			try {
				require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs' } });
			} catch (e) {}

			require(['vs/editor/editor.main'], function () {
			loadVfs();
			renderExplorer();

			// Themes Setup
			monaco.editor.defineTheme('pphlxDark', {
				base: 'vs-dark',
				inherit: true,
				rules: [
					{ token: 'comment', foreground: '545864', fontStyle: 'italic' },
					{ token: 'keyword', foreground: '54b9ff' },
					{ token: 'string', foreground: 'ffd493' },
					{ token: 'variable', foreground: '4bf3c8' },
					{ token: 'tag', foreground: '54b9ff' },
					{ token: 'attribute.name', foreground: 'acafff' },
					{ token: 'attribute.value', foreground: 'ffd493' },
					{ token: 'type.identifier', foreground: 'ffd493' },
					{ token: 'identifier', foreground: 'eef0f9' },
					{ token: 'delimiter.embedded', foreground: '4bf3c8', fontStyle: 'bold' } // Style for pphx brackets
				],
				colors: {
					'editor.background': '#0c0e12',
					'editor.lineHighlightBackground': '#17191e',
					'editorLineNumber.foreground': '#545864',
					'editorLineNumber.activeForeground': '#eef0f9',
					'scrollbarSlider.background': '#23262d',
					'scrollbarSlider.hoverBackground': '#343841',
					'scrollbarSlider.activeBackground': '#54b9ff'
				}
			});

			monaco.editor.defineTheme('pphlxPHPTheme', {
				base: 'vs-dark',
				inherit: true,
				rules: [],
				colors: {
					'editor.background': '#0f1115',
					'editor.lineHighlightBackground': '#1c1f26',
					'editorLineNumber.foreground': '#545864',
					'editorLineNumber.activeForeground': '#eef0f9'
				}
			});

			// Register pphlx language statically so it is always available immediately
			const isPphlxRegistered = monaco.languages.getLanguages().some(l => l.id === 'pphlx');
			if (!isPphlxRegistered) {
				monaco.languages.register({
					id: 'pphlx',
					extensions: ['.pphx']
				});
			}
			
			// Define the Monarch tokens provider statically for 'pphlx' using high-fidelity HTML/PHP hybrid definitions
			monaco.languages.setMonarchTokensProvider('pphlx', {
				defaultToken: '',
				tokenPostfix: '.pphlx',
				keywords: [
					'abstract', 'and', 'array', 'as', 'break', 'callable', 'case', 'catch', 
					'class', 'clone', 'const', 'continue', 'declare', 'default', 'die', 
					'do', 'echo', 'else', 'elseif', 'empty', 'enddeclare', 'endfor', 
					'endforeach', 'endif', 'endswitch', 'endwhile', 'eval', 'exit', 
					'extends', 'final', 'finally', 'for', 'foreach', 'function', 'global', 
					'goto', 'if', 'implements', 'include', 'include_once', 'instanceof', 
					'insteadof', 'interface', 'isset', 'list', 'namespace', 'new', 'or', 
					'print', 'private', 'protected', 'public', 'require', 'require_once', 
					'return', 'static', 'switch', 'throw', 'trait', 'try', 'unset', 'use', 
					'var', 'while', 'xor', 'yield', 'import', 'from'
				],
				tokenizer: {
					root: [
						// Import directives: @import BuyButton from '../components/BuyButton.jsx'
						[/^\s*@@import\s+[A-Z]\w*\s+from\s+['"][^'"]+['"]/, 'keyword'],
						
						// Match embedded PPHLX/PHP code
						[/\{\|=?/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
						[/<\?php/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
						
						// Match HTML comments
						[/<!--/, 'comment', '@htmlComment'],
						
						// Match HTML tag openings & declarations
						[/<!DOCTYPE/, 'metatag', '@doctype'],
						[/<\/[a-zA-Z0-9\-:]+>/, 'tag'],
						[/<[a-zA-Z0-9\-:]+/, 'tag', '@htmlTag'],
						
						// Fallback text
						[/[^<{]+/, ''],
						[/./, '']
					],
					doctype: [
						[/[^>]+/, 'metatag'],
						[/>/, 'metatag', '@pop']
					],
					htmlComment: [
						[/-->/, 'comment', '@pop'],
						[/[^-->]+/, 'comment'],
						[/./, 'comment']
					],
					htmlTag: [
						[/>/, 'tag', '@pop'],
						[/\/>/, 'tag', '@pop'],
						[/[a-zA-Z0-9\-:]+\s*=/, 'attribute.name'],
						[/"([^"\\]|\\.)*"/, 'string'],
						[/'([^'\\]|\\.)*'/, 'string'],
						[/[a-zA-Z0-9\-:]+/, 'attribute.value'],
						[/[ \t\r\n]+/, '']
					],
					phpEmbedded: [
						[/\|\}/, { token: 'delimiter.embedded', next: '@pop' }],
						[/\?>/, { token: 'delimiter.embedded', next: '@pop' }],
						
						// PHP Variables
						[/\$[a-zA-Z_]\w*/, 'variable'],
						
						// PHP Keywords
						[/[a-zA-Z_]\w*/, {
							cases: {
								'@keywords': 'keyword',
								'@default': 'identifier'
							}
						}],
						
						// PHP Strings
						[/"([^"\\]|\\.)*"/, 'string'],
						[/'([^'\\]|\\.)*'/, 'string'],
						
						// PHP Numbers
						[/\d+/, 'number'],
						
						// PHP Comments
						[/\/\/(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
						[/#(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
						[/\/\*/, 'comment', '@phpComment'],
						
						// Delimiters & operators
						[/[{}()\[\],;+\-*\/%=&|^!<>]/, 'delimiter'],
						[/[ \t\r\n]+/, '']
					],
					phpComment: [
						[/\*\//, 'comment', '@pop'],
						[/[^*]+/, 'comment'],
						[/./, 'comment']
					]
				}
			});

			// Re-register any custom extensions cached in local storage
			let cachedLangs = JSON.parse(localStorage.getItem(CUSTOM_LANGS_KEY) || '[]');
			
			// Clear any old cached definitions to force compilation of the updated Monarch grammar
			cachedLangs = cachedLangs.filter(l => l.id !== 'pphx' && l.id !== 'pphlx');
			localStorage.setItem(CUSTOM_LANGS_KEY, JSON.stringify(cachedLangs));

			cachedLangs.forEach(lang => {
				const isRegistered = monaco.languages.getLanguages().some(l => l.id === lang.id);
				if (!isRegistered) {
					monaco.languages.register({ id: lang.id, extensions: lang.extensions });
				}
				monaco.languages.setMonarchTokensProvider(lang.id, lang.monarch);
			});

			// Automatically preload/preinstall PPHLX vsix extension if not already present
			if (!cachedLangs.some(l => l.id === 'pphlx')) {
				loadExtensionFromVsix('/extensions/pphlx-1.0.0.vsix').then(res => {
					if (res && res.length > 0) {
						console.log("PPHLX vsix extension preinstalled successfully.");
						// Force theme re-render of active file using the actual registered language ID
						if (activeFile.endsWith('.pphx')) {
							const matched = res.find(r => r.extensions && r.extensions.includes('.pphx'));
							const langId = matched ? matched.id : 'pphlx';
							monaco.editor.setModelLanguage(inputEditor.getModel(), 'plaintext');
							monaco.editor.setModelLanguage(inputEditor.getModel(), langId);
						}
					}
				});
			}

			// Left Input Editor
			inputEditor = monaco.editor.create(document.getElementById('input-editor'), {
				value: files[activeFile],
				language: activeFile.endsWith('.pphx') ? 'pphlx' : 'html',
				theme: 'pphlxDark',
				fontSize: 14,
				fontFamily: 'Fira Code, monospace',
				minimap: { enabled: false },
				automaticLayout: true,
				lineHeight: 22,
				scrollbar: {
					verticalScrollbarSize: 10,
					horizontalScrollbarSize: 10
				}
			});

			// Right Output Editor
			outputEditor = monaco.editor.create(document.getElementById('output-editor'), {
				value: '',
				language: 'php',
				theme: 'pphlxPHPTheme',
				readOnly: true,
				fontSize: 14,
				fontFamily: 'Fira Code, monospace',
				minimap: { enabled: false },
				automaticLayout: true,
				lineHeight: 22,
				scrollbar: {
					verticalScrollbarSize: 10,
					horizontalScrollbarSize: 10
				}
			});

			// Compile on content change and save to Vfs
			inputEditor.onDidChangeModelContent(() => {
				saveVfs();
				doCompile();
			});

			doCompile();
		});
		}
		initMonaco();

		// Trigger file picker for user VSIX upload
		const btnInstallVsix = document.getElementById('btn-install-vsix');
		const vsixUploader = document.getElementById('vsix-uploader');

		if (btnInstallVsix && vsixUploader) {
			btnInstallVsix.addEventListener('click', () => {
				vsixUploader.click();
			});

			vsixUploader.addEventListener('change', (e) => {
				const file = e.target.files[0];
				if (!file) return;

				const reader = new FileReader();
				reader.onload = async function(evt) {
					const buffer = evt.target.result;
					const langs = await loadExtensionFromVsix(buffer);
					if (langs && langs.length > 0) {
						showIdeModal({
							title: 'Extension Installed',
							message: `Successfully installed extension supporting: ${langs.map(l => l.id).join(', ')}`,
							confirmText: 'OK',
							cancelText: 'hidden',
							onConfirm: () => {
								const ext = activeFile.split('.').pop();
								const matchedLang = langs.find(l => l.extensions.some(e => e.endsWith(ext)));
								if (matchedLang && inputEditor) {
									monaco.editor.setModelLanguage(inputEditor.getModel(), 'plaintext');
									monaco.editor.setModelLanguage(inputEditor.getModel(), matchedLang.id);
								}
							}
						});
					} else {
						showIdeModal({
							title: 'Installation Failed',
							message: 'Failed to install extension. Make sure it is a valid .vsix package containing a TextMate JSON grammar.',
							confirmText: 'OK',
							cancelText: 'hidden'
						});
					}
				};
				reader.readAsArrayBuffer(file);
			});
		}

		// Tab Switching Logic
		const tabPhp = document.getElementById('tab-php');
		const tabPreview = document.getElementById('tab-preview');
		const containerPhp = document.getElementById('output-container-php');
		const containerPreview = document.getElementById('output-container-preview');

		if (tabPhp && tabPreview && containerPhp && containerPreview) {
			tabPhp.addEventListener('click', () => {
				tabPhp.className = "px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-[#54b9ff] text-white bg-[#0f1115] transition-all rounded-t-md";
				tabPreview.className = "px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-transparent text-[#858B98] hover:text-white transition-all rounded-t-md";
				containerPhp.classList.remove('hidden');
				containerPreview.classList.add('hidden');
			});

			tabPreview.addEventListener('click', () => {
				tabPreview.className = "px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-[#54b9ff] text-white bg-[#0f1115] transition-all rounded-t-md";
				tabPhp.className = "px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-transparent text-[#858B98] hover:text-white transition-all rounded-t-md";
				containerPreview.classList.remove('hidden');
				containerPhp.classList.add('hidden');
			});
		}

		// Reset Code to Default Example Code
		const btnResetCode = document.getElementById('btn-reset-code');
		if (btnResetCode) {
			btnResetCode.addEventListener('click', () => {
				showIdeModal({
					title: 'Reset Code Workspace',
					message: 'Are you sure you want to reset all files to the default example code? This will discard your current edits.',
					confirmText: 'Reset',
					onConfirm: () => {
						localStorage.removeItem(STORAGE_KEY);
						window.location.reload();
					}
				});
			});
		}

		// Copy Input Editor to Clipboard
		const btnCopyInput = document.getElementById('btn-copy-input');
		const svgCopyInputNormal = document.getElementById('svg-copy-input-normal');
		const svgCopyInputSuccess = document.getElementById('svg-copy-input-success');
		if (btnCopyInput && svgCopyInputNormal && svgCopyInputSuccess) {
			btnCopyInput.addEventListener('click', () => {
				if (!inputEditor) return;
				const text = inputEditor.getValue();
				navigator.clipboard.writeText(text).then(() => {
					svgCopyInputNormal.classList.add('hidden');
					svgCopyInputSuccess.classList.remove('hidden');
					setTimeout(() => {
						svgCopyInputNormal.classList.remove('hidden');
						svgCopyInputSuccess.classList.add('hidden');
					}, 1500);
				});
			});
		}

		// Copy Output Editor or Preview HTML to Clipboard
		const btnCopyOutput = document.getElementById('btn-copy-output');
		const svgCopyOutputNormal = document.getElementById('svg-copy-output-normal');
		const svgCopyOutputSuccess = document.getElementById('svg-copy-output-success');
		if (btnCopyOutput && svgCopyOutputNormal && svgCopyOutputSuccess && containerPreview) {
			btnCopyOutput.addEventListener('click', () => {
				let text = "";
				const isPreviewActive = !containerPreview.classList.contains('hidden');
				if (isPreviewActive) {
					const iframe = document.getElementById('preview-iframe');
					if (iframe) {
						const doc = iframe.contentDocument || iframe.contentWindow.document;
						text = doc.documentElement.outerHTML;
					}
				} else {
					if (outputEditor) {
						text = outputEditor.getValue();
					}
				}
				
				navigator.clipboard.writeText(text).then(() => {
					svgCopyOutputNormal.classList.add('hidden');
					svgCopyOutputSuccess.classList.remove('hidden');
					setTimeout(() => {
						svgCopyOutputNormal.classList.remove('hidden');
						svgCopyOutputSuccess.classList.add('hidden');
					}, 1500);
				});
			});
		}

		// Download compiled output as index.php
		const btnDownloadOutput = document.getElementById('btn-download-output');
		if (btnDownloadOutput) {
			btnDownloadOutput.addEventListener('click', async () => {
				if (!outputEditor) return;
				
				try {
					const zip = new JSZip();
					
					// 1. Add compiled index.php
					const phpCode = outputEditor.getValue();
					zip.file("index.php", phpCode);
					
					// Parse active code to find imported components to exclude from VFS zipping
					const activeCode = inputEditor ? inputEditor.getValue() : '';
					const lines = activeCode.split('\n');
					const excludedPaths = new Set();
					excludedPaths.add(activeFile);
					
					const codeExtensions = ['js', 'jsx', 'ts', 'tsx', 'svelte', 'vue'];
					
					for (let line of lines) {
						const importMatch = line.match(/^\s*@import\s+(\w+)\s+from\s+['"]([^'"]+)['"]/);
						if (importMatch) {
							const importPath = importMatch[2];
							const cleanImportPath = importPath.replace(/^\.\.\//, '').replace(/^\.\//, '');
							const ext = cleanImportPath.split('.').pop().toLowerCase();
							if (codeExtensions.includes(ext)) {
								excludedPaths.add(cleanImportPath);
							}
						}
					}
					
					// 2. Add only assets and non-component files to ZIP
					for (let path in files) {
						// Skip active source page and imported development code components
						if (excludedPaths.has(path)) continue;
						
						const ext = path.split('.').pop().toLowerCase();
						if (codeExtensions.includes(ext)) continue;
						
						const content = files[path];
						if (typeof content === 'string' && content.startsWith('data:image/')) {
							const base64Content = content.split(',')[1];
							zip.file(path, base64Content, { base64: true });
						} else {
							zip.file(path, content);
						}
					}
					
					// 3. Fetch pre-compiled styling stylesheet and bundle it
					const tailwindCssResponse = await fetch('/styles/tailwind.css');
					if (tailwindCssResponse.ok) {
						const cssContent = await tailwindCssResponse.text();
						zip.file("assets/css/tailwind.css", cssContent);
					}
					
					// Generate zip blob and trigger download
					const contentBlob = await zip.generateAsync({ type: "blob" });
					const url = URL.createObjectURL(contentBlob);
					const a = document.createElement('a');
					a.href = url;
					a.download = "PPHLX-project.zip";
					document.body.appendChild(a);
					a.click();
					document.body.removeChild(a);
					URL.revokeObjectURL(url);
				} catch (err) {
					console.error("ZIP Generation failed: ", err);
					const phpCode = outputEditor.getValue();
					const blob = new Blob([phpCode], { type: 'text/plain' });
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = activeFile.endsWith('.pphx') ? activeFile.replace('.pphx', '.php') : activeFile + '.php';
					document.body.appendChild(a);
					a.click();
					document.body.removeChild(a);
					URL.revokeObjectURL(url);
				}
			});
		}

		// Toggle Left Sidebar File Explorer Panel
		const btnToggleSidebar = document.getElementById('btn-toggle-sidebar');
		const activityBtnExplorer = document.getElementById('activity-btn-explorer');
		const explorerSidebar = document.getElementById('explorer-sidebar');
		
		function toggleExplorerSidebar() {
			if (!explorerSidebar) return;
			const isHidden = explorerSidebar.classList.contains('hidden');
			if (isHidden) {
				explorerSidebar.classList.remove('hidden');
				if (btnToggleSidebar) btnToggleSidebar.classList.remove('text-[#4bf3c8]');
				if (activityBtnExplorer) {
					activityBtnExplorer.classList.add('bg-[#111318]', 'text-[#4bf3c8]', 'border-[#1b1f27]');
					activityBtnExplorer.classList.remove('text-astro-gray-400');
				}
			} else {
				explorerSidebar.classList.add('hidden');
				if (btnToggleSidebar) btnToggleSidebar.classList.add('text-[#4bf3c8]');
				if (activityBtnExplorer) {
					activityBtnExplorer.classList.remove('bg-[#111318]', 'text-[#4bf3c8]', 'border-[#1b1f27]');
					activityBtnExplorer.classList.add('text-astro-gray-400');
				}
			}
			// Force Monaco editors to redraw/layout to fit new width
			if (inputEditor) inputEditor.layout();
			if (outputEditor) outputEditor.layout();
		}

		if (btnToggleSidebar) {
			btnToggleSidebar.addEventListener('click', toggleExplorerSidebar);
		}
		if (activityBtnExplorer) {
			activityBtnExplorer.addEventListener('click', toggleExplorerSidebar);
		}

		// Toggle Collapsible Tree Pane (VS Code Workspace section style)
		const btnToggleTreePane = document.getElementById('btn-toggle-tree-pane');
		const fileList = document.getElementById('file-list');
		const chevronTreePane = document.getElementById('chevron-tree-pane');
		if (btnToggleTreePane && fileList && chevronTreePane) {
			btnToggleTreePane.addEventListener('click', () => {
				if (fileList.classList.contains('hidden')) {
					fileList.classList.remove('hidden');
					chevronTreePane.classList.remove('-rotate-90');
				} else {
					fileList.classList.add('hidden');
					chevronTreePane.classList.add('-rotate-90');
				}
			});
		}
	</script>
</body>
</html>

