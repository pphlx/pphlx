		// Helper to start inline file/folder creation
		function startInlineCreation(type) {
			let parent = '';
			if (selectedPath) {
				if (selectedType === 'directory') {
					parent = selectedPath;
				} else {
					const parts = selectedPath.split('/');
					parts.pop();
					parent = parts.join('/');
				}
			}
			inlineCreating = { parentPath: parent, type: type };
			if (parent) {
				collapsedDirs.delete(parent);
			}
			renderExplorer();
		}

		// Helper to rename a file/folder path in virtual file system
		function renameVfsPath(oldPath, newPath) {
			if (oldPath === newPath) return;
			if (!newPath) return;
			
			if (files[newPath]) {
				showIdeModal({
					title: 'Error',
					message: 'A file or folder with that name already exists.',
					confirmText: 'OK',
					cancelText: 'hidden'
				});
				return;
			}
			
			if (files[oldPath] !== undefined) {
				files[newPath] = files[oldPath];
				delete files[oldPath];
				if (activeFile === oldPath) {
					activeFile = newPath;
				}
				if (selectedPath === oldPath) {
					selectedPath = newPath;
				}
			} else {
				const prefix = oldPath + '/';
				const newPrefix = newPath + '/';
				const updatedFiles = {};
				
				for (let p in files) {
					if (p.startsWith(prefix)) {
						const relativePart = p.substring(prefix.length);
						updatedFiles[newPrefix + relativePart] = files[p];
					} else {
						updatedFiles[p] = files[p];
					}
				}
				files = updatedFiles;
				if (activeFile.startsWith(prefix)) {
					activeFile = newPrefix + activeFile.substring(prefix.length);
				}
				if (selectedPath.startsWith(prefix)) {
					selectedPath = newPrefix + selectedPath.substring(prefix.length);
				}
			}
			saveVfs();
			renderExplorer();
			doCompile();
		}

		// Helper to duplicate a file in the virtual file system
		function duplicateVfsPath(path) {
			if (!files[path]) return;
			const parts = path.split('.');
			const ext = parts.pop();
			const base = parts.join('.');
			
			let suffix = 1;
			let newPath = `${base}_copy.${ext}`;
			while (files[newPath]) {
				newPath = `${base}_copy_${suffix}.${ext}`;
				suffix++;
			}
			
			files[newPath] = files[path];
			saveVfs();
			renderExplorer();
			doCompile();
		}

