		// Delete File or Directory
		function deleteFile(filePath) {
			showIdeModal({
				title: 'Delete Item',
				message: `Are you sure you want to delete ${filePath}? This action cannot be undone.`,
				confirmText: 'Delete',
				onConfirm: () => {
					if (files[filePath] !== undefined) {
						delete files[filePath];
					} else {
						const prefix = filePath + '/';
						for (let p in files) {
							if (p.startsWith(prefix)) {
								delete files[p];
							}
						}
					}
					saveVfs();
					
					if (activeFile === filePath || !files[activeFile]) {
						activeFile = Object.keys(files)[0] || 'index.pphx';
					}
					
					document.getElementById('active-file-title').textContent = activeFile;
					if (inputEditor && files[activeFile]) {
						inputEditor.setValue(files[activeFile]);
					}
					renderExplorer();
					triggerCompile();
				}
			});
		}

		// TextMate-to-Monarch runtime compiler
		function compileTextMateToMonarch(tmGrammar) {
			const isPphlx = tmGrammar && (
				(tmGrammar.name && tmGrammar.name.toLowerCase().includes('pphlx')) ||
				(tmGrammar.scopeName && tmGrammar.scopeName.toLowerCase().includes('pphlx'))
			);
			
			if (isPphlx) {
				return {
					defaultToken: '',
					tokenPostfix: '.pphlx',
					keywords: [
						'abstract', 'and', 'array', 'as', 'break', 'callable', 'case', 'catch', 
						'class', 'clone', 'const', 'continue', 'declare', 'default', 'die', 
						'do', 'echo', 'else', 'elseif', 'empty', 'enddeclare', 'endfor', 
						'endforeach', 'endif', 'endswitch', 'endwhile', 'eval', 'exit', 
						'extends', 'final', 'finally', 'for', 'foreach', 'function', 'global', 
						'goto', 'if', 'implements', 'include', 'include_once', 'instanceof', 
						'insteadof', 'interface', 'isset', 'list', 'namespace', 'new', 'or', 
						'print', 'private', 'protected', 'public', 'require', 'require_once', 
						'return', 'static', 'switch', 'throw', 'trait', 'try', 'unset', 'use', 
						'var', 'while', 'xor', 'yield', 'import', 'from'
					],
					tokenizer: {
						root: [
							// Import directives: @import BuyButton from '../components/BuyButton.jsx'
							[/^\s*@@import\s+[A-Z]\w*\s+from\s+['"][^'"]+['"]/, 'keyword'],
							
							// Match embedded PPHLX/PHP code
							[/\{\|=?/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
							[/<\?php/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
							
							// Match HTML comments
							[/<!--/, 'comment', '@htmlComment'],
							
							// Match HTML tag openings & declarations
							[/Metatag/, 'metatag', '@doctype'],
							[/<\/[a-zA-Z0-9\-:]+>/, 'tag'],
							[/<[a-zA-Z0-9\-:]+/, 'tag', '@htmlTag'],
							
							// Fallback text
							[/[^<{]+/, ''],
							[/./, '']
						],
						doctype: [
							[/[^>]+/, 'metatag'],
							[/>/, 'metatag', '@pop']
						],
						htmlComment: [
							[/-->/, 'comment', '@pop'],
							[/[^-->]+/, 'comment'],
							[/./, 'comment']
						],
						htmlTag: [
							[/>/, 'tag', '@pop'],
							[/\/>/, 'tag', '@pop'],
							[/[a-zA-Z0-9\-:]+\s*=/, 'attribute.name'],
							[/"([^"\\]|\\.)*"/, 'string'],
							[/'([^'\\]|\\.)*'/, 'string'],
							[/[a-zA-Z0-9\-:]+/, 'attribute.value'],
							[/[ \t\r\n]+/, '']
						],
						phpEmbedded: [
							[/\|\}/, { token: 'delimiter.embedded', next: '@pop' }],
							[/\?>/, { token: 'delimiter.embedded', next: '@pop' }],
							
							// PHP Variables
							[/\$[a-zA-Z_]\w*/, 'variable'],
							
							// PHP Keywords
							[/[a-zA-Z_]\w*/, {
								cases: {
									'@keywords': 'keyword',
									'@default': 'identifier'
								}
							}],
							
							// PHP Strings
							[/"([^"\\]|\\.)*"/, 'string'],
							[/'([^'\\]|\\.)*'/, 'string'],
							
							// PHP Numbers
							[/\d+/, 'number'],
							
							// PHP Comments
							[/\/\/(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
							[/#(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
							[/\/\*/, 'comment', '@phpComment'],
							
							// Delimiters & operators
							[/[{}()\[\],;+\-*\/%=&|^!<>]/, 'delimiter'],
							[/[ \t\r\n]+/, '']
						],
						phpComment: [
							[/\*\//, 'comment', '@pop'],
							[/[^*]+/, 'comment'],
							[/./, 'comment']
						]
					}
				};
			}

			const scopeMap = {
				'comment': 'comment',
				'keyword': 'keyword',
				'string': 'string',
				'variable': 'variable',
				'constant.numeric': 'number',
				'storage': 'keyword',
				'entity.name.tag': 'tag',
				'entity.other.attribute-name': 'attribute.name',
				'punctuation': 'delimiter',
				'support': 'keyword'
			};

			function mapScope(scope) {
				if (!scope) return 'identifier';
				for (let key in scopeMap) {
					if (scope.includes(key)) return scopeMap[key];
				}
				return 'identifier';
			}

			const monarch = {
				tokenizer: {
					root: []
				}
			};

			if (tmGrammar && Array.isArray(tmGrammar.patterns)) {
				tmGrammar.patterns.forEach((pattern, index) => {
					// 1. Convert simple matches
					if (pattern.match) {
						let jsRegex;
						try {
							jsRegex = new RegExp(pattern.match.replace(/\\4/g, '').replace(/\\1/g, ''));
						} catch (e) {
							return; // Skip invalid JS regular expressions
						}

						if (pattern.captures) {
							const tokens = [];
							const maxGroup = Math.max(...Object.keys(pattern.captures).map(Number));
							for (let i = 1; i <= maxGroup; i++) {
								const capture = pattern.captures[i];
								tokens.push(mapScope(capture ? capture.name : ''));
							}
							monarch.tokenizer.root.push([jsRegex, tokens]);
						} else {
							monarch.tokenizer.root.push([jsRegex, mapScope(pattern.name)]);
						}
					}

					// 2. Convert begin/end block scopes (e.g. PHP brackets)
					if (pattern.begin && pattern.end) {
						const stateName = `state_${index}`;
						let beginRegex, endRegex;
						try {
							beginRegex = new RegExp(pattern.begin);
							endRegex = new RegExp(pattern.end);
						} catch (e) {
							return;
						}

						// Root transition
						monarch.tokenizer.root.push([beginRegex, { token: 'delimiter.embedded', next: '@' + stateName }]);

						// State definition
						monarch.tokenizer[stateName] = [
							[endRegex, { token: 'delimiter.embedded', next: '@pop' }]
						];

						// Inject inner patterns
						if (Array.isArray(pattern.patterns)) {
							pattern.patterns.forEach(inner => {
								if (inner.match) {
									try {
										monarch.tokenizer[stateName].push([new RegExp(inner.match), mapScope(inner.name)]);
									} catch (e) {}
								}
							});
						}

						// Default fallback for embedded code (e.g. PHP syntax fallback highlights)
						monarch.tokenizer[stateName].push([/[^|]+/, 'variable']);
					}
				});
			}

			// Add basic defaults for standard tags/words
			monarch.tokenizer.root.push([/[a-zA-Z_]\w*/, 'identifier']);

			return monarch;
		}

		// VS Code VSIX file unpacker and language contributor
		async function loadExtensionFromVsix(fileDataOrUrl) {
			try {
				const zip = new JSZip();
				let loadedZip;
				
				if (typeof fileDataOrUrl === 'string') {
					const response = await fetch(fileDataOrUrl);
					const blob = await response.blob();
					loadedZip = await zip.loadAsync(blob);
				} else {
					loadedZip = await zip.loadAsync(fileDataOrUrl);
				}

				// Find package.json
				const packageJsonFile = loadedZip.file("extension/package.json");
				if (!packageJsonFile) return null;
				
				const packageJsonText = await packageJsonFile.async("string");
				const manifest = JSON.parse(packageJsonText);

				if (!manifest.contributes || !manifest.contributes.languages) return null;

				const results = [];

				for (let lang of manifest.contributes.languages) {
					// Find grammar definition
					const grammarContrib = manifest.contributes.grammars.find(g => g.language === lang.id);
					if (!grammarContrib) continue;

					// Load grammar file
					const grammarPath = grammarContrib.path.replace(/^\.\//, 'extension/');
					const grammarFile = loadedZip.file(grammarPath);
					if (!grammarFile) continue;

					const grammarText = await grammarFile.async("string");
					const tmGrammar = JSON.parse(grammarText);

					// Compile TextMate to Monarch
					const monarchGrammar = compileTextMateToMonarch(tmGrammar);

					// Register language in Monaco if not already registered
					const isRegistered = monaco.languages.getLanguages().some(l => l.id === lang.id);
					if (!isRegistered) {
						monaco.languages.register({ id: lang.id, extensions: lang.extensions });
					}
					monaco.languages.setMonarchTokensProvider(lang.id, monarchGrammar);

					results.push({
						id: lang.id,
						extensions: lang.extensions,
						monarch: monarchGrammar
					});
				}

				// Save custom language definition to local storage to persist custom uploaded extensions
				if (results.length > 0) {
					const savedLangs = JSON.parse(localStorage.getItem(CUSTOM_LANGS_KEY) || '[]');
					results.forEach(res => {
						const existingIdx = savedLangs.findIndex(l => l.id === res.id);
						if (existingIdx > -1) {
							savedLangs[existingIdx] = res;
						} else {
							savedLangs.push(res);
						}
					});
					localStorage.setItem(CUSTOM_LANGS_KEY, JSON.stringify(savedLangs));
				}

				return results;

			} catch (e) {
				console.error("Failed to load extension:", e);
				return null;
			}
		}

		// Simple compiler implementation for template parsing
		function compilePphlx(code) {
			const start = performance.now();
			let imports = [];
			
			// 1. Process @import statements
			const lines = code.split('\n');
			const cleanLines = [];
			
			for (let line of lines) {
				const importMatch = line.match(/^\s*@import\s+(\w+)\s+from\s+['"]([^'"]+)['"]/);
				if (importMatch) {
					imports.push({
						name: importMatch[1],
						path: importMatch[2]
					});
				} else {
					cleanLines.push(line);
				}
			}
			
			let outputCode = cleanLines.join('\n');
			
			// 2. Parse brackets {|= ... |} -> <?php echo ...; ?>
			outputCode = outputCode.replace(/\{\|=\s*([\s\S]*?)\s*\|\}/g, (match, expression) => {
				const cleanExpr = expression.trim().replace(/;$/, '');
				return `<?php echo ${cleanExpr}; ?>`;
			});
			
			// 3. Parse brackets {| ... |} -> <?php ... ?>
			outputCode = outputCode.replace(/\{\|\s*([\s\S]*?)\s*\|\}/g, (match, block) => {
				return `<?php\n${block.trim()}\n?>`;
			});
			
			// 4. Parse components and layouts (resolving dynamically from VFS)
			for (let item of imports) {
				let vfsPath = item.path;
				if (!files[vfsPath]) {
					const cleanPath = vfsPath.replace(/^\.\//, '').replace(/^\.\.\//, '');
					if (files[cleanPath]) {
						vfsPath = cleanPath;
					} else if (files['src/' + cleanPath]) {
						vfsPath = 'src/' + cleanPath;
					} else if (files['src/components/' + cleanPath]) {
						vfsPath = 'src/components/' + cleanPath;
					} else {
						vfsPath = cleanPath;
					}
				}

				const compContent = files[vfsPath] || '';

				const attrPattern = '(?:[^>"]|"[^"]*"|\'[^\']*\'|<\\?php[\\s\\S]*?\\?>)*';
				const selfClosingRegex = new RegExp(`<${item.name}\\s*(${attrPattern})\\s*\\/>`, 'g');
				const pairedRegex = new RegExp(`<${item.name}\\s*(${attrPattern})>([\\s\\S]*?)<\\/${item.name}>`, 'g');

				const ext = vfsPath.split('.').pop();
				let framework = 'react';
				if (ext === 'vue') framework = 'vue';
				else if (ext === 'svelte') framework = 'svelte';
				else if (vfsPath.includes('.solid.')) framework = 'solid';
				else {
					if (compContent.toLowerCase().includes('preact')) {
						framework = 'preact';
					}
				}

				const expandTag = (attributes, children) => {
					let isClient = false;
					let clientMode = 'load';
					let phpProps = [];
					
					const attrMatches = attributes.matchAll(/(\w+[\w:-]*)(?:=["']([^"']*)["']|=\{([\s\S]*?)\})?/g);
					for (let am of attrMatches) {
						const name = am[1];
						const staticVal = am[2];
						const dynamicVal = am[3];
						
						if (name === 'client:load') {
							isClient = true;
							clientMode = 'load';
						} else if (name.startsWith('client:')) {
							isClient = true;
							clientMode = name.replace('client:', '');
						} else {
							if (dynamicVal !== undefined) {
								phpProps.push(`"${name}" => ${dynamicVal}`);
							} else {
								const phpMatch = staticVal ? staticVal.match(/<\?php\s+echo\s+([\s\S]*?);\s*\?>/) : null;
								if (phpMatch) {
									phpProps.push(`"${name}" => ${phpMatch[1].trim()}`);
								} else {
									phpProps.push(`"${name}" => "${staticVal || ''}"`);
								}
							}
						}
					}
					
					const uniqueId = `pphlx-${item.name.toLowerCase()}-\${uniqid()}`;
					
					if (isClient) {
						return `<div id="<?php echo "${uniqueId}"; ?>" class="pphlx-island" data-component="${item.name}" data-framework="${framework}" data-hydrate="${clientMode}"></div>
<script>
  window.pphlxProps = window.pphlxProps || {};
  window.pphlxProps["<?php echo "${uniqueId}"; ?>"] = <?php echo json_encode([${phpProps.join(', ')}]); ?>;
<\/script>`;
					} else {
						if (compContent) {
							let innerTpl = compContent;
							// Replace {{slot}} inside the component template with children content
							innerTpl = innerTpl.replace(/\{\{\s*slot\s*\}\}/g, children || '');
							return innerTpl;
						}
						return `<div class="pphlx-component" data-component="${item.name}">${children || ''}</div>`;
					}
				};

				outputCode = outputCode.replace(pairedRegex, (match, attributes, children) => {
					return expandTag(attributes, children);
				});

				outputCode = outputCode.replace(selfClosingRegex, (match, attributes) => {
					return expandTag(attributes, '');
				});
			}
			
			// 5. Inject CSS & JS Assets (matching Go compiler behaviour)
			let hasCssPlaceholder = outputCode.includes("{{PPHLX_CSS}}");
			let hasJsPlaceholder = outputCode.includes("{{PPHLX_JS}}");

			const cssTag = '<link rel="stylesheet" href="/assets/css/app.css">';
			const jsTag = '<script src="/assets/js/app.js"><\/script>';

			if (hasCssPlaceholder) {
				outputCode = outputCode.replaceAll("{{PPHLX_CSS}}", cssTag);
			}
			if (hasJsPlaceholder) {
				outputCode = outputCode.replaceAll("{{PPHLX_JS}}", jsTag);
			}

			// Fallback: Inject before </head> if no explicit placeholders were used
			if (outputCode.includes("</head>")) {
				if (!hasCssPlaceholder) {
					outputCode = outputCode.replace("</head>", cssTag + "\n</head>");
				}
				if (!hasJsPlaceholder) {
					outputCode = outputCode.replace("</head>", jsTag + "\n</head>");
				}
			}
			
			const elapsed = (performance.now() - start).toFixed(1);
			return {
				php: outputCode.trimStart(),
				time: elapsed
			};
		}

		// Helper to safely write HTML to dynamic iframe
		function writeToIframe(iframe, html) {
			if (!iframe) return;
			try {
				const doc = iframe.contentDocument || iframe.contentWindow.document;
				doc.open();
				doc.write(html);
				doc.close();
			} catch (e) {
				console.error("Iframe write error:", e);
			}
		}

		// Perform compilation of active file and refresh HTML iframe sandbox
		function doCompile() {
			const code = (typeof inputEditor !== 'undefined' && inputEditor) ? inputEditor.getValue() : (typeof files !== 'undefined' && files && typeof activeFile !== 'undefined' && activeFile ? files[activeFile] : '');
			if (!code) return;
			
			const result = compilePphlx(code);
			if (typeof outputEditor !== 'undefined' && outputEditor) {
				outputEditor.setValue(result.php);
			}
			document.getElementById('compile-time').textContent = `Compiled in ${result.time}ms`;
			
			// Update iframe preview
			const mockCss = `
				html {
					color-scheme: dark;
					height: auto !important;
					min-height: 100% !important;
					overflow-y: auto !important;
				}
				body {
					justify-content: safe center !important;
					align-items: safe center !important;
					height: auto !important;
					min-height: 100% !important;
					overflow-y: auto !important;
				}
			`;
			
			const phpState = {};
			const varMatches = result.php.matchAll(/\$(\w+)\s*=\s*([^;]+);/g);
			for (let vm of varMatches) {
				const name = vm[1];
				let valStr = vm[2].trim();
				if ((valStr.startsWith('"') && valStr.endsWith('"')) || (valStr.startsWith("'") && valStr.endsWith("'"))) {
					valStr = valStr.substring(1, valStr.length - 1);
				}
				phpState[name] = valStr;
			}

			const uniqCounter = {};
			const idMap = {};

			let previewHtml = result.php.replace(/<\?php[\s\S]*?\?>/g, (match) => {
				if (match.includes('echo "PPHLX-') || match.includes('echo "pphlx-') || match.includes('uniqid()')) {
					if (idMap[match]) return idMap[match];
					const compMatch = match.match(/pphlx-([a-zA-Z0-9_-]+)/i);
					const compName = compMatch ? compMatch[1] : 'comp';
					uniqCounter[compName] = (uniqCounter[compName] || 0) + 1;
					const generatedId = `pphlx-${compName}-${uniqCounter[compName]}`;
					idMap[match] = generatedId;
					return generatedId;
				}
				if (match.includes('echo json_encode')) {
					// Check if it's the array format: json_encode(["url" => $imageUrl, ...])
					const arrayMatch = match.match(/json_encode\(\[([\s\S]*?)\]\)/);
					if (arrayMatch) {
						const itemsStr = arrayMatch[1];
						const propsObj = {};
						const pairMatches = itemsStr.matchAll(/['"](\w+)['"]\s*=>\s*([^,]+)/g);
						for (let pm of pairMatches) {
							const key = pm[1];
							let valExpr = pm[2].trim();
							// Check if it is a PHP variable
							if (valExpr.startsWith('$')) {
								const varName = valExpr.substring(1);
								propsObj[key] = phpState[varName] !== undefined ? phpState[varName] : '';
							} else {
								// Static string
								if ((valExpr.startsWith('"') && valExpr.endsWith('"')) || (valExpr.startsWith("'") && valExpr.endsWith("'"))) {
									valExpr = valExpr.substring(1, valExpr.length - 1);
								}
								propsObj[key] = valExpr;
							}
						}
						return JSON.stringify(propsObj);
					}
					// Check if it's the single variable format: json_encode($var)
					const varMatch = match.match(/json_encode\(\$(\w+)\)/);
					if (varMatch && phpState[varMatch[1]] !== undefined) {
						return JSON.stringify(phpState[varMatch[1]]);
					}
					return '{}';
				}
				const echoVarMatch = match.match(/echo\s+\$(\w+)/);
				if (echoVarMatch && phpState[echoVarMatch[1]] !== undefined) {
					return phpState[echoVarMatch[1]];
				}
				if (match.includes('number_format')) {
					const numMatch = match.match(/number_format\(\$(\w+)/);
					if (numMatch && phpState[numMatch[1]] !== undefined) {
						return Number(phpState[numMatch[1]]).toFixed(2);
					}
				}
				return '';
			});

			// Substitute local file path references with actual virtual base64/SVG sources
			for (let path in files) {
				const isDataUrl = typeof files[path] === 'string' && files[path].startsWith('data:image/');
				const isSvg = path.endsWith('.svg');
				let replacement = '';
				
				if (isSvg) {
					replacement = `data:image/svg+xml;utf8,${encodeURIComponent(files[path])}`;
				} else if (isDataUrl) {
					replacement = files[path];
				}
				
				if (replacement) {
					const regex = new RegExp(`(['"])${path}(['"])`, 'g');
					previewHtml = previewHtml.replace(regex, `$1${replacement}$2`);
				}
			}

			// Rewrite relative/absolute assets paths to map to the playbook's dist folder
			const playbookAssetBase = `/playbooks/${activePlaybookId}/dist/assets/`;
			previewHtml = previewHtml.replace(/(['"])\/?assets\//g, `$1${playbookAssetBase}`);
			const hydrationScript = "";
			const overrideScript = `
				<script>
					(function() {
						const originalAddEventListener = document.addEventListener;
						document.addEventListener = function(type, listener, options) {
							if (type === 'DOMContentLoaded') {
								if (document.readyState === 'loading') {
									originalAddEventListener.call(this, type, listener, options);
								} else {
									setTimeout(listener, 0);
								}
							} else {
								originalAddEventListener.call(this, type, listener, options);
							}
						};
					})();
				<\/script>
			`;
			
			const htmlOpen = '<' + 'html>';
			const htmlClose = '</' + 'html>';
			const headOpen = '<' + 'head>';
			const headClose = '</' + 'head>';
			const bodyOpen = '<' + 'body>';
			const bodyClose = '</' + 'body>';

			let iframeDocContent = '';
			if (previewHtml.includes('<' + 'html') || previewHtml.includes('<!' + 'DOCTYPE')) {
				let withCss = previewHtml;
				if (previewHtml.includes('<head>')) {
					withCss = previewHtml.replace('<head>', `<head>\n${overrideScript}\n<style>${mockCss}</style>`);
				} else if (previewHtml.includes('</head>')) {
					withCss = previewHtml.replace('</head>', `${overrideScript}\n<style>${mockCss}</style>\n</head>`);
				} else {
					withCss = `${overrideScript}\n<style>${mockCss}</style>\n` + previewHtml;
				}

				if (withCss.includes('</' + 'body>')) {
					iframeDocContent = withCss.replace('</' + 'body>', hydrationScript + '\n</' + 'body>');
				} else {
					iframeDocContent = withCss + hydrationScript;
				}
			} else {
				iframeDocContent = `
					<!DOCTYPE html>
					${htmlOpen}
					${headOpen}
						${overrideScript}
						<style>${mockCss}</style>
						<script src="https://cdn.tailwindcss.com"><\/script>
					${headClose}
					${bodyOpen}
						${previewHtml}
						${hydrationScript}
					${bodyClose}
					${htmlClose}
				`;
			}
			// Clean up pre-rendered DOM trees inside islands to avoid duplicate mounts and lost event listeners
			const parser = new DOMParser();
			const cleanDoc = parser.parseFromString(iframeDocContent, 'text/html');
			cleanDoc.querySelectorAll('.pphlx-island, #threejs-container').forEach(el => {
				el.innerHTML = '';
			});
			iframeDocContent = cleanDoc.documentElement.outerHTML;
			lastCompiledHtml = iframeDocContent;

			// Re-create the iframe from scratch to ensure a 100% clean global window and script context
			const oldIframe = document.getElementById('preview-iframe');
			const wrapper = document.getElementById('preview-iframe-wrapper');
			if (oldIframe && wrapper) {
				oldIframe.remove();
				const newIframe = document.createElement('iframe');
				newIframe.id = 'preview-iframe';
				newIframe.className = 'w-full h-full border-0 bg-white';
				wrapper.appendChild(newIframe);
				writeToIframe(newIframe, iframeDocContent);
			}

			// Sync with detached preview window in real-time
			broadcastIframeContent();
		}

		let compileTimeout = null;
		function triggerCompile() {
			if (compileTimeout) clearTimeout(compileTimeout);
			compileTimeout = setTimeout(doCompile, 10);
		}

		// Initialize Monaco safely
		function initMonaco() {
			if (typeof require === 'undefined') {
				setTimeout(initMonaco, 100);
				return;
			}
			try {
				require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs' } });
			} catch (e) {}

			require(['vs/editor/editor.main'], function () {
			// Themes Setup
			monaco.editor.defineTheme('pphlxDark', {
				base: 'vs-dark',
				inherit: true,
				rules: [
					{ token: 'comment', foreground: '545864', fontStyle: 'italic' },
					{ token: 'keyword', foreground: '54b9ff' },
					{ token: 'string', foreground: 'ffd493' },
					{ token: 'variable', foreground: '4bf3c8' },
					{ token: 'tag', foreground: '54b9ff' },
					{ token: 'attribute.name', foreground: 'acafff' },
					{ token: 'attribute.value', foreground: 'ffd493' },
					{ token: 'type.identifier', foreground: 'ffd493' },
					{ token: 'identifier', foreground: 'eef0f9' },
					{ token: 'delimiter.embedded', foreground: '4bf3c8', fontStyle: 'bold' } // Style for pphx brackets
				],
				colors: {
					'editor.background': '#0c0e12',
					'editor.lineHighlightBackground': '#17191e',
					'editorLineNumber.foreground': '#545864',
					'editorLineNumber.activeForeground': '#eef0f9'
				}
			});

			monaco.editor.defineTheme('pphlxPHPTheme', {
				base: 'vs-dark',
				inherit: true,
				rules: [],
				colors: {
					'editor.background': '#0f1115',
					'editor.lineHighlightBackground': '#1c1f26',
					'editorLineNumber.foreground': '#545864',
					'editorLineNumber.activeForeground': '#eef0f9'
				}
			});

			// Register pphlx language statically so it is always available immediately
			const isPphlxRegistered = monaco.languages.getLanguages().some(l => l.id === 'pphlx');
			if (!isPphlxRegistered) {
				monaco.languages.register({
					id: 'pphlx',
					extensions: ['.pphx']
				});
			}
			
			// Define the Monarch tokens provider statically for 'pphlx' using high-fidelity HTML/PHP hybrid definitions
			monaco.languages.setMonarchTokensProvider('pphlx', {
				defaultToken: '',
				tokenPostfix: '.pphlx',
				keywords: [
					'abstract', 'and', 'array', 'as', 'break', 'callable', 'case', 'catch', 
					'class', 'clone', 'const', 'continue', 'declare', 'default', 'die', 
					'do', 'echo', 'else', 'elseif', 'empty', 'enddeclare', 'endfor', 
					'endforeach', 'endif', 'endswitch', 'endwhile', 'eval', 'exit', 
					'extends', 'final', 'finally', 'for', 'foreach', 'function', 'global', 
					'goto', 'if', 'implements', 'include', 'include_once', 'instanceof', 
					'insteadof', 'interface', 'isset', 'list', 'namespace', 'new', 'or', 
					'print', 'private', 'protected', 'public', 'require', 'require_once', 
					'return', 'static', 'switch', 'throw', 'trait', 'try', 'unset', 'use', 
					'var', 'while', 'xor', 'yield', 'import', 'from'
				],
				tokenizer: {
					root: [
						// Import directives: @import BuyButton from '../components/BuyButton.jsx'
						[/^\s*@@import\s+[A-Z]\w*\s+from\s+['"][^'"]+['"]/, 'keyword'],
						
						// Match embedded PPHLX/PHP code
						[/\{\|=?/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
						[/<\?php/, { token: 'delimiter.embedded', next: '@phpEmbedded' }],
						
						// Match HTML comments
						[/<!--/, 'comment', '@htmlComment'],
						
						// Match HTML tag openings & declarations
						[/<!DOCTYPE/, 'metatag', '@doctype'],
						[/<\/[a-zA-Z0-9\-:]+>/, 'tag'],
						[/<[a-zA-Z0-9\-:]+/, 'tag', '@htmlTag'],
						
						// Fallback text
						[/[^<{]+/, ''],
						[/./, '']
					],
					doctype: [
						[/[^>]+/, 'metatag'],
						[/>/, 'metatag', '@pop']
					],
					htmlComment: [
						[/-->/, 'comment', '@pop'],
						[/[^-->]+/, 'comment'],
						[/./, 'comment']
					],
					htmlTag: [
						[/>/, 'tag', '@pop'],
						[/\/>/, 'tag', '@pop'],
						[/[a-zA-Z0-9\-:]+\s*=/, 'attribute.name'],
						[/"([^"\\]|\\.)*"/, 'string'],
						[/'([^'\\]|\\.)*'/, 'string'],
						[/[a-zA-Z0-9\-:]+/, 'attribute.value'],
						[/[ \t\r\n]+/, '']
					],
					phpEmbedded: [
						[/\|\}/, { token: 'delimiter.embedded', next: '@pop' }],
						[/\?>/, { token: 'delimiter.embedded', next: '@pop' }],
						
						// PHP Variables
						[/\$[a-zA-Z_]\w*/, 'variable'],
						
						// PHP Keywords
						[/[a-zA-Z_]\w*/, {
							cases: {
								'@keywords': 'keyword',
								'@default': 'identifier'
							}
						}],
						
						// PHP Strings
						[/"([^"\\]|\\.)*"/, 'string'],
						[/'([^'\\]|\\.)*'/, 'string'],
						
						// PHP Numbers
						[/\d+/, 'number'],
						
						// PHP Comments
						[/\/\/(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
						[/#(?:(?!\|\})(?!\?>)[^\r\n])*/, 'comment'],
						[/\/\*/, 'comment', '@phpComment'],
						
						// Delimiters & operators
						[/[{}()\[\],;+\-*\/%=&|^!<>]/, 'delimiter'],
						[/[ \t\r\n]+/, '']
					],
					phpComment: [
						[/\*\//, 'comment', '@pop'],
						[/[^*]+/, 'comment'],
						[/./, 'comment']
					]
				}
			});

			// Re-register any custom extensions cached in local storage
			let cachedLangs = JSON.parse(localStorage.getItem(CUSTOM_LANGS_KEY) || '[]');
			
			// Clear any old cached definitions to force compilation of the updated Monarch grammar
			cachedLangs = cachedLangs.filter(l => l.id !== 'pphx' && l.id !== 'pphlx');
			localStorage.setItem(CUSTOM_LANGS_KEY, JSON.stringify(cachedLangs));

			cachedLangs.forEach(lang => {
				const isRegistered = monaco.languages.getLanguages().some(l => l.id === lang.id);
				if (!isRegistered) {
					monaco.languages.register({ id: lang.id, extensions: lang.extensions });
				}
				monaco.languages.setMonarchTokensProvider(lang.id, lang.monarch);
			});

			// Automatically preload/preinstall PPHLX vsix extension if not already present
			if (!cachedLangs.some(l => l.id === 'pphlx')) {
				loadExtensionFromVsix(`/extensions/pphlx-${latestVersion}.vsix`).then(res => {
					if (res && res.length > 0) {
						console.log("PPHLX vsix extension preinstalled successfully.");
						// Force theme re-render of active file using the actual registered language ID
						if (activeFile.endsWith('.pphx')) {
							const matched = res.find(r => r.extensions && r.extensions.includes('.pphx'));
							const langId = matched ? matched.id : 'pphlx';
							monaco.editor.setModelLanguage(inputEditor.getModel(), 'plaintext');
							monaco.editor.setModelLanguage(inputEditor.getModel(), langId);
						}
					}
				});
			}

			// Left Input Editor
			inputEditor = monaco.editor.create(document.getElementById('input-editor'), {
				value: files[activeFile] || '',
				language: activeFile.endsWith('.pphx') ? 'pphlx' : 'html',
				theme: 'pphlxDark',
				fontSize: 14,
				fontFamily: 'Fira Code, monospace',
				minimap: { enabled: false },
				automaticLayout: true,
				lineHeight: 22,
				scrollbar: {
					verticalScrollbarSize: 15,
					horizontalScrollbarSize: 15,
					verticalHasArrows: true,
					horizontalHasArrows: true,
					arrowSize: 15
				}
			});

			// Right Output Editor
			outputEditor = monaco.editor.create(document.getElementById('output-editor'), {
				value: '',
				language: 'php',
				theme: 'pphlxPHPTheme',
				readOnly: true,
				fontSize: 14,
				fontFamily: 'Fira Code, monospace',
				minimap: { enabled: false },
				automaticLayout: true,
				lineHeight: 22,
				scrollbar: {
					verticalScrollbarSize: 15,
					horizontalScrollbarSize: 15,
					verticalHasArrows: true,
					horizontalHasArrows: true,
					arrowSize: 15
				}
			});

			// Compile on content change and save to Vfs
