---
import '~/styles/tailwind.css';
import PPHLXLogo from '~/components/PPHLXLogo.astro';

// Default templates for unified multi-framework hydration demo
const defaultCode = `@import ProductImage from 'components/ProductImage.js'
@import StarRating from 'components/StarRating.solid.jsx'
@import BuyButton from 'components/BuyButton.svelte'

{|
// Establish database mock state (simulated PHP backend)
$productName = "MacBook Pro";
$productDesc = "Our most advanced series of chips ever built for a pro laptop. Each chip in the M5 family delivers phenomenal CPU performance, faster unified memory, and up to twice as fast SSD storage, allowing you to fly through AI tasks at mind-bending speeds.";
$priceUSD = 2599.00;
$availableStock = 3;
$initialStars = 5;
$badgeText = "Pro Choice";
$imageUrl = "/assets/mac-macbook-pro.webp";
|}

<!-- Multi-Framework Hydrated Product Card (React + Solid + Svelte + PHP) -->
<div class="max-w-sm mx-auto my-6 bg-[#0f1115]/95 border border-[#1f2430] rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] overflow-hidden relative group hover:border-[#4bf3c8]/50 transition-all duration-500">
  
  <!-- React Component: ProductImage (Handles product image and badge) -->
  <ProductImage url={$imageUrl} badge={$badgeText} client:load />

  <!-- PHP server-side data interpolation -->
  <div class="p-6">
    <div class="flex items-center justify-between mb-3.5">
      <span class="text-[10px] font-bold uppercase tracking-wider text-[#4bf3c8] bg-[#4bf3c8]/10 border border-[#4bf3c8]/20 px-2.5 py-1 rounded-full shadow-[0_0_12px_rgba(75,243,200,0.1)]">Developer Edition</span>
      <span class="text-xs font-medium text-gray-400 font-mono">Stock: <span class="text-[#4bf3c8]">{|= $availableStock |}</span> left</span>
    </div>

    <h2 class="text-xl font-bold text-white mb-2 font-sans tracking-tight hover:text-[#4bf3c8] transition-colors">{|= $productName |}</h2>
    <p class="text-xs text-gray-400 leading-relaxed mb-4 font-sans">{|= $productDesc |}</p>
    
    <!-- Solid Component: StarRating (Interactive star ratings widget) -->
    <StarRating initialRating={$initialStars} client:load />

    <div class="h-[1px] bg-gradient-to-r from-transparent via-gray-800 to-transparent my-4"></div>
    
    <div class="flex items-center justify-between mt-4">
      <div>
        <p class="text-[9px] text-gray-500 uppercase font-semibold tracking-wider">Special Offer Price</p>
        <p class="text-2xl font-extrabold text-white font-sans tracking-tight">\${|= number_format($priceUSD, 2) |}</p>
      </div>
      
      <!-- Svelte Component: BuyButton (Add-to-cart button tracking count) -->
      <BuyButton stock={$availableStock} client:load />
    </div>
  </div>
</div>
`;

const defaultProductImage = `import React from 'react';
export default function ProductImage({ url, badge }) {
    return (
        <div className="relative overflow-hidden rounded-t-3xl bg-gradient-to-b from-[#1b202e] to-[#0d0f14] h-52 flex items-center justify-center border-b border-[#1f2430]">
            <img src={url} alt="Product" className="object-cover w-4/5 h-auto hover:scale-105 transition-transform duration-500" />
            {badge && (
                <span className="absolute top-4 left-4 bg-[#4bf3c8]/15 border border-[#4bf3c8]/30 text-[#4bf3c8] backdrop-blur-md text-[9px] font-bold px-2.5 py-1 rounded-lg shadow-[0_0_15px_rgba(75,243,200,0.15)] uppercase tracking-wider">
                    {badge}
                </span>
            )}
        </div>
    );
}
`;

const defaultStarRating = `import { createSignal, For } from 'solid-js';
export default function StarRating({ initialRating }) {
    const [rating, setRating] = createSignal(initialRating);
    return (
        <div class="flex items-center gap-1.5 my-3 select-none">
            <For each={[1, 2, 3, 4, 5]}>
                {(star) => (
                    <button onClick={() => setRating(star)} class="focus:outline-none transition-transform hover:scale-125 active:scale-95">
                        <svg class="w-4 h-4 transition-all" fill={star <= rating() ? "#4bf3c8" : "none"} stroke="#4bf3c8" stroke-width="1.8" style={star <= rating() ? "filter: drop-shadow(0 0 4px rgba(75, 243, 200, 0.45))" : ""} viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.969 0 1.371 1.24.588 1.81l-3.97 2.883a1 1 0 00-.364 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.971-2.883a1 1 0 00-1.18 0l-3.97 2.883c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.364-1.118l-3.97-2.883c-.783-.57-.38-1.81.588-1.81h4.906a1 1 0 00.95-.69l1.519-4.674z" />
                        </svg>
                    </button>
                )}
            </For>
            <span class="text-[#4bf3c8]/80 text-[10px] ml-1.5 px-1.5 py-0.5 rounded bg-[#4bf3c8]/10 border border-[#4bf3c8]/20 font-mono">({rating()}/5)</span>
        </div>
    );
}
`;

const defaultBuyButton = `<script>
  export let stock = 0;
  let count = 0;
  function handleAdd() {
    if (count < stock) {
      count++;
    }
  }
</script>
<div class="flex flex-col items-center gap-1.5">
  <button on:click={handleAdd} class="bg-gradient-to-r from-[#4bf3c8] to-[#00d2a0] hover:from-[#00d2a0] hover:to-[#4bf3c8] text-[#080a0d] text-[11px] font-extrabold py-2 px-4 rounded-xl transition-all shadow-[0_4px_20px_rgba(75,243,200,0.35)] flex items-center gap-1.5 select-none active:scale-95 hover:scale-105 border-none">
    <svg class="w-3.5 h-3.5 stroke-[#080a0d]" fill="none" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
    Add {count > 0 ? \`(\${count})\` : ''}
  </button>
  {#if count >= stock}
    <span class="text-[#ef4444] text-[9px] font-bold mt-1 shadow-[0_0_8px_rgba(239,68,68,0.2)] bg-[#ef4444]/10 border border-[#ef4444]/20 px-2 py-0.5 rounded-md">Max stock reached</span>
  {/if}
</div>
`;
---
<!DOCTYPE html>
<html lang="en" class="h-full overflow-hidden bg-astro-dark-950 text-astro-gray-100 [color-scheme:dark]">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>PPHLX Playground</title>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	
	<!-- Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
	
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs/loader.min.js"></script>
	
	<style>
		body {
			font-family: 'Inter', sans-serif;
			margin: 0;
			padding: 0;
			height: 100vh;
			width: 100vw;
			overflow: hidden;
			background-color: #0c0e12;
		}
		
		/* Custom Scrollbar */
		::-webkit-scrollbar {
			width: 8px;
			height: 8px;
		}
		::-webkit-scrollbar-track {
			background: #0c0e12;
		}
		::-webkit-scrollbar-thumb {
			background: #23262d;
			border-radius: 4px;
		}
		::-webkit-scrollbar-thumb:hover {
			background: #343841;
		}
	</style>
</head>
<body class="flex flex-col h-screen w-screen overflow-hidden">

	<!-- Header Bar (Integrated Minimal IDE Title Bar) -->
	<header class="flex items-center justify-between px-6 py-2 border-b border-[#1b1f27] bg-[#0c0e12] select-none h-12">
		<div class="flex items-center gap-3">
			<a href="/" class="flex items-center hover:opacity-85 transition-opacity text-white">
				<PPHLXLogo class="h-8 w-auto" />
			</a>
			<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#1b1f27] text-astro-gray-400 border border-[#2e3440] font-mono">REPL Playground</span>
		</div>
		<div class="flex items-center gap-4">
			<!-- Reset Example Code -->
			<button id="btn-reset-code" class="text-xs font-semibold px-3 py-1 rounded bg-[#1b1f27] hover:bg-[#de4343] border border-[#2e3440] text-astro-gray-200 hover:text-white transition-all flex items-center gap-1.5" title="Reset all files to default example code">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18" />
				</svg>
				Reset Code
			</button>

			<!-- VSIX Installation Trigger -->
			<button id="btn-install-vsix" class="text-xs font-semibold px-3 py-1 rounded bg-[#1b1f27] hover:bg-[#282d38] border border-[#2e3440] text-astro-gray-200 hover:text-white transition-all flex items-center gap-1.5">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
				</svg>
				Install VSIX Extension
			</button>
			<input type="file" id="vsix-uploader" class="hidden" accept=".vsix" />

			<a href="/blog/PPHLX-live-database-queries-deep-dive/" class="text-xs font-semibold text-[#acafff] hover:text-white transition-colors">
				Back to Blog
			</a>
		</div>
	</header>

	<!-- Main Workspace -->
	<div class="w-full flex-1 min-h-0 flex flex-row overflow-hidden bg-[#0c0e12]">
		<!-- VS Code Activity Bar (Leftmost) -->
		<div class="w-12 bg-[#090b0e] border-r border-[#1b1f27] flex flex-col items-center py-3 gap-4 flex-shrink-0 select-none">
			<!-- Explorer Icon Button -->
			<button id="activity-btn-explorer" class="p-2 rounded-lg text-[#4bf3c8] hover:text-white transition-colors bg-[#111318] border border-[#1b1f27]" title="Toggle Explorer Sidebar">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
				</svg>
			</button>
		</div>

		<!-- Sidebar File Explorer (Left) -->
		<div id="explorer-sidebar" class="w-60 flex flex-col border-r border-[#1b1f27] bg-[#0c0e12] h-full flex-shrink-0 select-none">
			<div class="flex items-center justify-between px-4 py-2 border-b border-[#1b1f27] h-10 bg-[#0c0e12]">
				<span class="text-[10px] font-bold tracking-wider text-astro-gray-400 uppercase">Explorer</span>
				<div class="flex gap-1">
					<button id="btn-root-upload-file" title="Upload Files" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-300 hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
						</svg>
					</button>
					<button id="btn-root-new-file" title="New File" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-300 hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
						</svg>
					</button>
					<button id="btn-root-new-folder" title="New Folder" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-300 hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
						</svg>
					</button>
				</div>
			</div>
			
			<!-- Collapsible Pane Header (VS Code style) -->
			<div class="flex items-center gap-1.5 px-4 py-1.5 bg-[#111318] border-b border-[#1b1f27] cursor-pointer hover:bg-[#17191e] select-none text-astro-gray-300 hover:text-white transition-colors" id="btn-toggle-tree-pane">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-150" id="chevron-tree-pane" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
				</svg>
				<span class="text-[9px] font-bold tracking-wider uppercase font-mono">WORKSPACE</span>
			</div>
			
			<!-- File List Container -->
			<div id="file-list" class="flex-1 overflow-y-auto py-2 px-1 flex flex-col gap-0.5">
				<!-- Dynamically filled by JS -->
			</div>
		</div>

		<!-- Editor & Preview Available Workspace (Subtracts left sidebar Explorer width) -->
		<div class="flex-1 flex flex-row min-h-0 h-full">
			<!-- Editor Workspace (Left) -->
			<div class="w-1/2 flex flex-col border-r border-[#1b1f27] h-full">
				<div class="flex items-center justify-between px-4 py-2 bg-[#0c0e12] border-b border-[#1b1f27] h-10">
					<div class="flex items-center gap-2">
						<button id="btn-toggle-sidebar" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-400 hover:text-white transition-colors" title="Toggle Explorer Sidebar">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
						<span id="active-file-title" class="text-xs font-semibold tracking-wider text-astro-gray-300 font-mono">index.pphx</span>
					</div>
					<div class="flex items-center gap-2">
						<span class="text-[10px] text-[#4bf3c8] font-mono flex items-center gap-1.5 font-semibold">
							<span class="w-1.5 h-1.5 rounded-full bg-[#4bf3c8] animate-pulse"></span> LOCAL SANDBOX
						</span>
						<button id="btn-copy-input" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-400 hover:text-white transition-colors" title="Copy code to clipboard">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-input-normal">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
							</svg>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-green-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-input-success">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
						</button>
					</div>
				</div>
				<div id="input-editor" class="flex-1 w-full bg-[#0c0e12]"></div>
				<div id="image-preview-container" class="flex-1 w-full bg-[#0c0e12] flex flex-col items-center justify-center p-6 text-astro-gray-400 hidden select-none">
					<div class="max-w-md w-full flex flex-col items-center gap-4 bg-[#111318] p-6 border border-[#1b1f27] rounded-xl">
						<img id="image-preview-element" class="max-h-64 object-contain rounded-lg border border-[#232731] bg-grid-pattern p-2" src="" alt="Selected Preview" />
						<div class="w-full text-center space-y-1.5 font-mono text-xs text-astro-gray-300">
							<p>File Path: <span id="image-preview-path" class="text-white"></span></p>
							<p>Dimensions: <span id="image-preview-dimensions" class="text-[#4bf3c8]">-</span></p>
							<p>File Size: <span id="image-preview-size" class="text-[#54b9ff]">-</span></p>
						</div>
					</div>
				</div>
			</div>

			<!-- Preview Pane (Right) -->
			<div class="w-1/2 flex flex-col h-full bg-[#0f1115]">
				<!-- Output Tabs -->
				<div class="flex items-center justify-between px-2 bg-[#0c0e12] border-b border-[#1b1f27] h-10">
					<div class="flex gap-1">
						<button id="tab-php" class="px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-[#54b9ff] text-white bg-[#0f1115] transition-all rounded-t-md">
							Compiled PHP
						</button>
						<button id="tab-preview" class="px-4 py-2 text-xs font-semibold tracking-wide border-b-2 border-transparent text-[#858B98] hover:text-white transition-all rounded-t-md">
							HTML Preview
						</button>
					</div>
					<div class="flex items-center gap-2 mr-2">
						<span class="text-[10px] text-astro-gray-300 font-mono font-semibold animate-pulse" id="compile-time">Compiled in 0ms</span>
						<button id="btn-copy-output" class="p-1 hover:bg-[#1b1f27] rounded text-astro-gray-400 hover:text-white transition-colors" title="Copy output to clipboard">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-output-normal">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
							</svg>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-green-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="svg-copy-output-success">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
						</button>
						<button id="btn-download-output" class="p-1 hover:bg-[#1b1f27] rounded text-[#4bf3c8] hover:text-white transition-colors" title="Download compiled standalone PHP page">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
							</svg>
						</button>
					</div>
				</div>
				
				<!-- Tab Content Areas -->
				<div class="flex-1 relative overflow-hidden h-full">
					<!-- PHP Output Area -->
					<div id="output-container-php" class="absolute inset-0 w-full h-full">
						<div id="output-editor" class="w-full h-full bg-[#0f1115]"></div>
					</div>
					<!-- HTML Preview Area -->
					<div id="output-container-preview" class="absolute inset-0 w-full h-full hidden bg-white">
						<iframe id="preview-iframe" class="w-full h-full border-0 bg-white"></iframe>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Premium Custom IDE Modals -->
	<div id="ide-modal-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-[2px] flex items-center justify-center z-[9999] hidden animate-fade-in">
		<div id="ide-modal-card" class="w-96 rounded-lg bg-[#111318] border border-[#232731] shadow-2xl p-5 select-none transform scale-95 opacity-0 transition-all duration-200">
			<h3 id="ide-modal-title" class="text-sm font-bold text-white mb-2 font-sans">Title</h3>
			<p id="ide-modal-message" class="text-xs text-[#858b98] mb-4 font-sans leading-relaxed">Message description.</p>
			<div id="ide-modal-input-container" class="mb-4 hidden">
				<input type="text" id="ide-modal-input" class="w-full px-3 py-2 text-xs rounded bg-[#171a21] border border-[#2e3440] text-white focus:outline-none focus:border-[#54b9ff] font-mono" placeholder="..." />
			</div>
			<div class="flex items-center justify-end gap-2.5">
				<button id="ide-modal-btn-cancel" class="px-3.5 py-1.5 rounded text-xs font-semibold text-[#858b98] hover:text-white hover:bg-[#1b1f27] border border-transparent transition-all">Cancel</button>
				<button id="ide-modal-btn-confirm" class="px-3.5 py-1.5 rounded text-xs font-semibold text-white bg-[#54b9ff] hover:bg-[#45a4eb] transition-all">Confirm</button>
			</div>
		</div>
	</div>

	<!-- Custom Explorer Context Menu -->
	<div id="explorer-context-menu" class="fixed bg-[#111318] border border-[#232731] rounded-lg shadow-2xl py-1 z-[10000] hidden min-w-[160px] select-none text-astro-gray-300 font-sans text-xs">
		<!-- New sub-menu -->
		<div class="relative group">
