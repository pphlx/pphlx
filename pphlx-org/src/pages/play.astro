		// Shared helper function to package and download the project ZIP
		async function triggerZipDownload(phpCode, activeCode, filesData, activeFileId, activePlaybookIdVal) {
			try {
				const zip = new JSZip();
				
				// 1. Add compiled index.php to dist/index.php
				zip.file("dist/index.php", phpCode);
				
				const excludedPaths = new Set();
				excludedPaths.add(activeFileId);
				
				// Also add active file to zip with current editor content
				zip.file(activeFileId, activeCode);
				
				// 2. Add source and other files to ZIP from VFS
				for (let path in filesData) {
					if (path.startsWith("dist/dist/")) continue;
					
					// Skip files we are going to write/overwrite dynamically
					if (path === "index.php" || path === "dist/index.php") continue;
					if (path === "dist/assets/css/app.css" || path === "dist/assets/js/app.js" || path === "dist/assets/css/tailwind.css") continue;
					if (path === "assets/css/app.css" || path === "assets/js/app.js" || path === "assets/css/tailwind.css") continue;
					
					// Skip the active file since we write it with current editor content above
					if (path === activeFileId) continue;
					
					const content = filesData[path];
					if (typeof content === 'string' && content.startsWith('data:image/')) {
						const base64Content = content.split(',')[1];
						zip.file(path, base64Content, { base64: true });
					} else {
						zip.file(path, content);
					}
				}
				
				// 3. Fetch pre-compiled styling stylesheet and bundle it inside dist/assets/css
				const tailwindCssResponse = await fetch('/styles/tailwind.css');
				if (tailwindCssResponse.ok) {
					const cssContent = await tailwindCssResponse.text();
					zip.file("dist/assets/css/tailwind.css", cssContent);
				}

				// 4. Fetch playbook-specific compiled assets (if they exist) and add to dist/assets/
				try {
					const playbookCssResp = await fetch(`/playbooks/${activePlaybookIdVal}/dist/assets/css/app.css`);
					if (playbookCssResp.ok) {
						const cssContent = await playbookCssResp.text();
						zip.file("dist/assets/css/app.css", cssContent);
					}
				} catch (e) {
					console.error("Playbook CSS fetch failed:", e);
				}

				try {
					const playbookJsResp = await fetch(`/playbooks/${activePlaybookIdVal}/dist/assets/js/app.js`);
					if (playbookJsResp.ok) {
						const jsContent = await playbookJsResp.text();
						zip.file("dist/assets/js/app.js", jsContent);
					}
				} catch (e) {
					console.error("Playbook JS fetch failed:", e);
				}
				
				// Generate zip blob and trigger download
				const contentBlob = await zip.generateAsync({ type: "blob" });
				const url = URL.createObjectURL(contentBlob);
				const a = document.createElement('a');
				a.href = url;
				a.download = "PPHLX-project.zip";
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				URL.revokeObjectURL(url);
			} catch (err) {
				console.error("ZIP Generation failed: ", err);
				const blob = new Blob([phpCode], { type: 'text/plain' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = "index.php";
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				URL.revokeObjectURL(url);
			}
		}

