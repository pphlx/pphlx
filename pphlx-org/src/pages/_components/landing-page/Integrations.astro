---
import Link from '../Link.astro';
import SectionCopy from '../SectionCopy.astro';
import IntegrationTab from './IntegrationTab.astro';
import CodeExample from './integrations-tabs/CodeExample.astro';
import InterfaceExample from './integrations-tabs/InterfaceExample.astro';
---

<section class="mt-20 md:mt-24 lg:mt-28 xl:mt-36 relative">
	<div class="w-full max-w-screen-xl mx-auto px-4 sm:px-8">
		<SectionCopy
			label="Maximum Flexibility"
			title="20+ Frameworks. Zero Lock-in."
			description="PPHLX compiles components from 20+ major JavaScript & 3D UI frameworks into standalone, statically-hydrated PHP pages. Bring your existing React, Vue, Svelte, SolidJS, or Three.js codebases directly."
		>
			<Link
				slot="call-to-action"
				href="#docs"
				class="secondary">Explore 20+ supported frameworks</Link
			>
		</SectionCopy>
	</div>

	<div class="w-full max-w-screen-xl mx-auto px-4 sm:px-8">
		<div
			role="tablist"
			id="tab-container"
			aria-label="Ecosystem Tabs"
			class="mt-4 py-1 sm:mt-8 w-full max-w-[650px] flex items-center overflow-x-auto text-nowrap no-scrollbar gap-4 sm:gap-6 scroll-smooth"
		>
			<IntegrationTab
				label="Three.js"
				logoSrc="/assets/integrations/threejs.svg"
				isActive
				background="group-aria-selected:bg-[#ffffff]"
				innerBackground="group-aria-selected:bg-[#ffffff]/20"
				text="group-aria-selected:text-[#ffffff]"
			/>
			<IntegrationTab
				label="R3F"
				logoSrc="/assets/integrations/react.svg"
				background="group-aria-selected:bg-[#61DAFB]"
				innerBackground="group-aria-selected:bg-[#61DAFB]/20"
				text="group-aria-selected:text-[#61DAFB]"
			/>
			<IntegrationTab
				label="Threlte"
				logoSrc="/assets/integrations/threlte.svg"
				background="group-aria-selected:bg-[#FF3E00]"
				innerBackground="group-aria-selected:bg-[#FF3E00]/20"
				text="group-aria-selected:text-[#FF3E00]"
			/>
			<IntegrationTab
				label="TresJS"
				logoSrc="/assets/integrations/tresjs.svg"
				background="group-aria-selected:bg-[#41B883]"
				innerBackground="group-aria-selected:bg-[#41B883]/20"
				text="group-aria-selected:text-[#41B883]"
			/>
			<IntegrationTab
				label="React"
				logoSrc="/assets/integrations/react.svg"
				background="group-aria-selected:bg-[#61DAFB]"
				innerBackground="group-aria-selected:bg-[#61DAFB]/20"
				text="group-aria-selected:text-[#61DAFB]"
			/>
			<IntegrationTab
				label="Vue"
				logoSrc="/assets/integrations/vue.svg"
				size="size-5 lg:size-6"
				background="group-aria-selected:bg-[#41B883]"
				innerBackground="group-aria-selected:bg-[#41B883]/20"
				text="group-aria-selected:text-[#41B883]"
			/>
			<IntegrationTab
				label="Preact"
				logoSrc="/assets/integrations/preact.svg"
				background="group-aria-selected:bg-[#673AB8]"
				innerBackground="group-aria-selected:bg-[#673AB8]/20"
				text="group-aria-selected:text-[#673AB8]"
			/>
			<IntegrationTab
				label="Svelte"
				logoSrc="/assets/integrations/svelte.svg"
				background="group-aria-selected:bg-[#FF3E00]"
				innerBackground="group-aria-selected:bg-[#FF3E00]/20"
				text="group-aria-selected:text-[#FF3E00]"
			/>
			<IntegrationTab
				label="Solid"
				logoSrc="/assets/integrations/solid.svg"
				size="size-5 lg:size-7"
				background="group-aria-selected:bg-[#76B3E1]"
				innerBackground="group-aria-selected:bg-[#76B3E1]/20"
				text="group-aria-selected:text-[#76B3E1]"
			/>
			<IntegrationTab
				label="Angular"
				logoSrc="/assets/integrations/angular.svg"
				background="group-aria-selected:bg-[#DD0031]"
				innerBackground="group-aria-selected:bg-[#DD0031]/20"
				text="group-aria-selected:text-[#DD0031]"
			/>
			<IntegrationTab
				label="Alpine"
				logoSrc="/assets/integrations/alpinejs.svg"
				background="group-aria-selected:bg-[#77C1D2]"
				innerBackground="group-aria-selected:bg-[#77C1D2]/20"
				text="group-aria-selected:text-[#77C1D2]"
			/>
			<IntegrationTab
				label="Next.js"
				logoSrc="/assets/integrations/nextjs.svg"
				background="group-aria-selected:bg-[#f1f1f1]"
				innerBackground="group-aria-selected:bg-[#f1f1f1]/20"
				text="group-aria-selected:text-[#f1f1f1]"
			/>
			<IntegrationTab
				label="Nuxt"
				logoSrc="/assets/integrations/nuxt.svg"
				background="group-aria-selected:bg-[#00DC82]"
				innerBackground="group-aria-selected:bg-[#00DC82]/20"
				text="group-aria-selected:text-[#00DC82]"
			/>
			<IntegrationTab
				label="Qwik"
				logoSrc="/assets/integrations/qwik.svg"
				background="group-aria-selected:bg-[#18B6F6]"
				innerBackground="group-aria-selected:bg-[#18B6F6]/20"
				text="group-aria-selected:text-[#18B6F6]"
			/>
			<IntegrationTab
				label="Lit"
				logoSrc="/assets/integrations/lit.svg"
				background="group-aria-selected:bg-[#324FFF]"
				innerBackground="group-aria-selected:bg-[#324FFF]/20"
				text="group-aria-selected:text-[#324FFF]"
			/>
			<IntegrationTab
				label="Mithril"
				logoSrc="/assets/integrations/astro-mithril.svg"
				background="group-aria-selected:bg-[#0F80C1]"
				innerBackground="group-aria-selected:bg-[#0F80C1]/20"
				text="group-aria-selected:text-[#0F80C1]"
			/>
			<IntegrationTab
				label="Elm"
				logoSrc="/assets/integrations/astro-integration-elm.svg"
				background="group-aria-selected:bg-[#60B5CC]"
				innerBackground="group-aria-selected:bg-[#60B5CC]/20"
				text="group-aria-selected:text-[#60B5CC]"
			/>
			<IntegrationTab
				label="Ember"
				logoSrc="/assets/integrations/ember-astro.svg"
				background="group-aria-selected:bg-[#E04E39]"
				innerBackground="group-aria-selected:bg-[#E04E39]/20"
				text="group-aria-selected:text-[#E04E39]"
			/>
			<IntegrationTab
				label="Ziko"
				logoSrc="/assets/integrations/zikojs.svg"
				background="group-aria-selected:bg-[#FFB800]"
				innerBackground="group-aria-selected:bg-[#FFB800]/20"
				text="group-aria-selected:text-[#FFB800]"
			/>
			<IntegrationTab
				label="MDX"
				logoSrc="/assets/integrations/mdx.svg"
				background="group-aria-selected:bg-[#E00073]"
				innerBackground="group-aria-selected:bg-[#E00073]/20"
				text="group-aria-selected:text-[#E00073]"
			/>
			<IntegrationTab
				label="Markdoc"
				logoSrc="/assets/integrations/markdoc.svg"
				background="group-aria-selected:bg-[#635BFF]"
				innerBackground="group-aria-selected:bg-[#635BFF]/20"
				text="group-aria-selected:text-[#635BFF]"
			/>
			<IntegrationTab
				label="Bootstrap"
				logoSrc="/assets/integrations/astro-bootstrap-icons.svg"
				background="group-aria-selected:bg-[#7952B3]"
				innerBackground="group-aria-selected:bg-[#7952B3]/20"
				text="group-aria-selected:text-[#7952B3]"
			/>
			<IntegrationTab
				label="Tailwind"
				logoSrc="/assets/integrations/tailwind.svg"
				background="group-aria-selected:bg-[#38BDF8]"
				innerBackground="group-aria-selected:bg-[#38BDF8]/20"
				text="group-aria-selected:text-[#38BDF8]"
			/>
			<IntegrationTab
				label="Uno"
				logoSrc="/assets/integrations/astro-uno.svg"
				background="group-aria-selected:bg-[#A3E635]"
				innerBackground="group-aria-selected:bg-[#A3E635]/20"
				text="group-aria-selected:text-[#A3E635]"
			/>
		</div>
	</div>

	<div class="my-4 sm:my-8 w-full border-t border-t-astro-gray-600"></div>

	<div class="mx-auto w-full max-w-screen-xl px-4 sm:px-8">
		<section
			role="tabpanel"
			aria-labelledby="react"
			class:list={['mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4']}
		>
			<div class="lg:col-span-2">
				<CodeExample />
			</div>

			{/* Browser window frame */}
			<div
				class="order-first sm:order-last h-fit lg:-mt-[4.5rem] bg-[#07040F] border border-astro-gray-600 rounded-2xl"
			>
				{/* Fake browser window control bar */}
				<div
					class="h-[2.438rem] px-3 flex items-center whitespace-no-wrap pointer-events-none select-none border-b border-b-astro-gray-600"
				>
					<span class="mx-1 inline-block h-3 w-3 rounded-full bg-astro-gray-600"></span>
					<span class="mx-1 inline-block h-3 w-3 rounded-full bg-astro-gray-600"></span>
					<span class="mx-1 inline-block h-3 w-3 rounded-full bg-astro-gray-600"></span>
				</div>

				<div class="h-[21.5rem] md:max-lg:h-[18rem] xl:h-[26.3rem] overflow-hidden">
					<InterfaceExample />
				</div>
			</div>
		</section>
	</div>
</section>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.integration-tab');
	const panel = document.querySelector<HTMLElement>('[role="tabpanel"]')!;
	let activeTabIndex = 0;

	function updateTabSelection(index: number, shouldFocus = true) {
		const nextTab = tabs[index];
		const activeTab = tabs[activeTabIndex];

		activeTab.setAttribute('aria-selected', 'false');
		activeTab.setAttribute('tabindex', '-1');

		nextTab.setAttribute('aria-selected', 'true');
		nextTab.setAttribute('tabindex', '0');

		// Auto-center active tab within its horizontal scroll container
		const container = nextTab.parentElement;
		if (container) {
			const scrollLeft = nextTab.offsetLeft - (container.clientWidth / 2) + (nextTab.clientWidth / 2);
			container.scrollTo({ left: scrollLeft, behavior: 'smooth' });
		}

		// Update panel association
		panel.setAttribute('aria-labelledby', nextTab.id);

		const is3d = ['three.js', 'r3f', 'threlte', 'tresjs'].includes(nextTab.id);
		const standardContainer = document.getElementById('code-standard-container')!;
		const threeDContainer = document.getElementById('code-3d-container')!;

		if (is3d) {
			standardContainer.classList.add('hidden');
			threeDContainer.classList.remove('hidden');

			const canvasSpan = Array.from(threeDContainer.querySelectorAll<HTMLSpanElement>('.expressive-code span'))
				.find((span) => span.textContent?.startsWith("'../components/ProductCanvas."));
			if (canvasSpan) {
				let ext = 'js';
				if (nextTab.id === 'r3f') ext = 'jsx';
				else if (nextTab.id === 'threlte') ext = 'svelte';
				else if (nextTab.id === 'tresjs') ext = 'vue';
				canvasSpan.textContent = `'../components/ProductCanvas.${ext}'`;
			}

			const buyButtonSpan3d = Array.from(threeDContainer.querySelectorAll<HTMLSpanElement>('.expressive-code span'))
				.find((span) => span.textContent?.startsWith("'../components/BuyButton."));
			if (buyButtonSpan3d) {
				let ext = 'js';
				if (nextTab.id === 'r3f') ext = 'jsx';
				else if (nextTab.id === 'threlte') ext = 'svelte';
				else if (nextTab.id === 'tresjs') ext = 'vue';
				buyButtonSpan3d.textContent = `'../components/BuyButton.${ext}'`;
			}
		} else {
			threeDContainer.classList.add('hidden');
			standardContainer.classList.remove('hidden');

			const buyButtonSpan = Array.from(standardContainer.querySelectorAll<HTMLSpanElement>('.expressive-code span'))
				.find((span) => span.textContent?.startsWith("'../components/BuyButton."));
			if (buyButtonSpan) {
				let ext = 'jsx';
				if (nextTab.id === 'vue' || nextTab.id === 'nuxt') ext = 'vue';
				else if (nextTab.id === 'svelte') ext = 'svelte';
				else if (nextTab.id === 'angular') ext = 'ts';
				else if (nextTab.id === 'alpine' || nextTab.id === 'lit' || nextTab.id === 'mithril' || nextTab.id === 'ember' || nextTab.id === 'ziko') ext = 'js';
				else if (nextTab.id === 'elm') ext = 'elm';
				else if (nextTab.id === 'mdx') ext = 'mdx';
				else if (nextTab.id === 'markdoc') ext = 'md';
				else if (nextTab.id === 'bootstrap') ext = 'html';
				else if (nextTab.id === 'tailwind' || nextTab.id === 'uno') ext = 'css';
				buyButtonSpan.textContent = `'../components/BuyButton.${ext}'`;
			}
		}

		if (shouldFocus) {
			tabs[index].focus();
		}
		activeTabIndex = index;
	}

	tabs.forEach((tab, index) => {
		tab.addEventListener('click', () => updateTabSelection(index));

		tab.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				const nextIndex = (activeTabIndex + 1) % tabs.length;
				updateTabSelection(nextIndex);
			} else if (event.key === 'ArrowLeft') {
				event.preventDefault();
				const prevIndex = (activeTabIndex - 1 + tabs.length) % tabs.length;
				updateTabSelection(prevIndex);
			}
		});
	});

	// Initialize first tab state on page load
	updateTabSelection(0, false);
</script>
