---
import BaseHead, { type Props as HeadProps } from '~/components/BaseHead.astro';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import HeaderDrawerContent from '~/components/HeaderDrawerContent.astro';
import HeaderNav from '~/components/HeaderNav.astro';
import SkipLink from '~/components/SkipLink.astro';
import '~/styles/tailwind.css';

interface Props extends HeadProps {
	class?: string;
	bgClass?: string;
}

const { bgClass = 'bg-black', ...head } = Astro.props;
---

<!doctype html>
<html
	lang="en"
	class:list={[
		'astro-gray-700 overflow-x-clip break-words text-astro-gray-100 [color-scheme:dark] [word-break:break-word]',
		bgClass,
		Astro.props.class,
	]}
>
	<head>
		<BaseHead {...head} />
	</head>
	<body class="flex min-h-screen max-w-screen flex-col overflow-x-clip">
		<SkipLink />
		<div
			id="nav"
			class:list={{
				'inset-x-0 top-0 z-20 max-h-screen': true,
				'bg-black/30': true,
			}}
		>
			<Header>
				<HeaderNav />
				<HeaderDrawerContent slot="drawer" />
			</Header>
		</div>

		<slot name="subnav" />

		<main id="main" class="relative z-10 flex flex-1 flex-col">
			<slot />
		</main>
		<Footer {bgClass} />
	</body>
</html>

<style>
	:root.disclosure-open {
		overflow-y: hidden;
	}
	body::before {
		content: '';
		position: fixed;
		display: block;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 11;
		background: #0d0f14;
		pointer-events: none;
		opacity: 0;
		transition: opacity 400ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	:root.disclosure-open body::before {
		opacity: 1;
	}

	:root.disclosure-open #nav {
		overflow-y: auto;
	}

	/* Custom Standardized Scrollbar */
	:global(::-webkit-scrollbar) {
		width: 15px;
		height: 15px;
	}
	:global(::-webkit-scrollbar-track) {
		background: #2c2c2c;
	}
	:global(::-webkit-scrollbar-thumb) {
		background: #9f9f9f;
		border-radius: 9999px;
		border: 3px solid #2c2c2c;
	}
	:global(::-webkit-scrollbar-thumb:hover) {
		background: #d1d1d1;
	}

	/* Scrollbar Buttons (Arrows) */
	:global(::-webkit-scrollbar-button) {
		display: none; /* Hide by default */
		background-color: #2c2c2c;
		background-repeat: no-repeat;
		background-position: center;
		background-size: contain;
		height: 15px;
		width: 15px;
		border: 2px solid #2c2c2c;
	}

	/* Show only single buttons at start and end of scrollbar */
	:global(::-webkit-scrollbar-button:single-button) {
		display: block;
	}

	/* Up Arrow (Rounded Triangle - 60% size centered) */
	:global(::-webkit-scrollbar-button:vertical:decrement) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f'><path d='M 50 15 A 10 10 0 0 1 59 20 L 89 71 A 10 10 0 0 1 80 85 L 20 85 A 10 10 0 0 1 11 71 L 41 20 A 10 10 0 0 1 50 15 Z'/></svg>");
	}
	:global(::-webkit-scrollbar-button:vertical:decrement:hover) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1'><path d='M 50 15 A 10 10 0 0 1 59 20 L 89 71 A 10 10 0 0 1 80 85 L 20 85 A 10 10 0 0 1 11 71 L 41 20 A 10 10 0 0 1 50 15 Z'/></svg>");
	}
	/* Down Arrow (Rounded Triangle - 60% size centered) */
	:global(::-webkit-scrollbar-button:vertical:increment) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f'><path d='M 50 85 A 10 10 0 0 1 41 80 L 11 29 A 10 10 0 0 1 20 15 L 80 15 A 10 10 0 0 1 89 29 L 59 80 A 10 10 0 0 1 50 85 Z'/></svg>");
	}
	:global(::-webkit-scrollbar-button:vertical:increment:hover) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1'><path d='M 50 85 A 10 10 0 0 1 41 80 L 11 29 A 10 10 0 0 1 20 15 L 80 15 A 10 10 0 0 1 89 29 L 59 80 A 10 10 0 0 1 50 85 Z'/></svg>");
	}
	/* Left Arrow (Rounded Triangle - 60% size centered) */
	:global(::-webkit-scrollbar-button:horizontal:decrement) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f'><path d='M 15 50 A 10 10 0 0 1 20 41 L 71 11 A 10 10 0 0 1 85 20 L 85 80 A 10 10 0 0 1 71 89 L 20 59 A 10 10 0 0 1 15 50 Z'/></svg>");
	}
	:global(::-webkit-scrollbar-button:horizontal:decrement:hover) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1'><path d='M 15 50 A 10 10 0 0 1 20 41 L 71 11 A 10 10 0 0 1 85 20 L 85 80 A 10 10 0 0 1 71 89 L 20 59 A 10 10 0 0 1 15 50 Z'/></svg>");
	}
	/* Right Arrow (Rounded Triangle - 60% size centered) */
	:global(::-webkit-scrollbar-button:horizontal:increment) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%239f9f9f'><path d='M 85 50 A 10 10 0 0 1 80 59 L 29 89 A 10 10 0 0 1 15 80 L 15 20 A 10 10 0 0 1 29 11 L 80 41 A 10 10 0 0 1 85 50 Z'/></svg>");
	}
	:global(::-webkit-scrollbar-button:horizontal:increment:hover) {
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23d1d1d1'><path d='M 85 50 A 10 10 0 0 1 80 59 L 29 89 A 10 10 0 0 1 15 80 L 15 20 A 10 10 0 0 1 29 11 L 80 41 A 10 10 0 0 1 85 50 Z'/></svg>");
	}
</style>
