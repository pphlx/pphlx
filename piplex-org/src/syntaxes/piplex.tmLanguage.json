{
  "name": "pphx",
  "scopeName": "text.html.pphx",
  "fileTypes": [".pphx"],
  "patterns": [
    {
      "comment": "Piplex import directives: @import Name from 'path'",
      "match": "^\\s*(@import)\\s+([A-Z][a-zA-Z0-9_]*)\\s+(from)\\s+(['\"])([^'\"]+)\\4",
      "captures": {
        "1": { "name": "keyword.control.import.pphx" },
        "2": { "name": "entity.name.class.pphx" },
        "3": { "name": "keyword.control.from.pphx" },
        "4": { "name": "string.quoted.single.pphx" },
        "5": { "name": "string.quoted.single.pphx" }
      }
    },
    {
      "comment": "Piplex output block: {|= ... |}",
      "begin": "\\{\\|=",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.php" }
      },
      "end": "\\|\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.php" }
      },
      "name": "meta.embedded.line.php",
      "contentName": "source.php",
      "patterns": [
        {
          "name": "comment.line.double-slash.php",
          "match": "//.*$"
        },
        {
          "name": "string.quoted.single.php",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.php",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.php",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.php",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "keyword.control.php",
          "match": "\\b(try|catch|new|if|else|foreach|endforeach|as|return|ob_start|ob_get_clean|add_shortcode|add_action)\\b"
        },
        {
          "name": "variable.other.php",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.function.php",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    {
      "comment": "Piplex statement block: {| ... |}",
      "begin": "\\{\\|",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.php" }
      },
      "end": "\\|\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.php" }
      },
      "name": "meta.embedded.block.php",
      "contentName": "source.php",
      "patterns": [
        {
          "name": "comment.line.double-slash.php",
          "match": "//.*$"
        },
        {
          "name": "string.quoted.single.php",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.php",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.php",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.php",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "keyword.control.php",
          "match": "\\b(try|catch|new|if|else|foreach|endforeach|as|return|ob_start|ob_get_clean|add_shortcode|add_action)\\b"
        },
        {
          "name": "variable.other.php",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.function.php",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    {
      "include": "text.html.basic"
    }
  ]
}