---
import { Icon } from 'astro-icon/components';
import SectionCopy from '../SectionCopy.astro';
import ContentCollections from './feature-cards/ContentCollections.astro';
import Card from './feature-cards/FeatureCard.astro';
import FileBasedRouting from './feature-cards/FileBasedRouting.astro';
import ImageOptimization from './feature-cards/ImageOptimization.astro';
import ServerTemplating from './feature-cards/ServerTemplating.astro';
import ViewTransitions from './feature-cards/ViewTransitions.astro';
import ZeroJS from './feature-cards/ZeroJS.astro';
---

<section class="mt-20 md:mt-24 lg:mt-28 xl:mt-36 w-full max-w-screen-xl mx-auto px-4 sm:px-8">
	<SectionCopy
		label="Everything you need"
		title="Fully Featured"
		description="Piplex comes with everything you need to build high-performance monolithic PHP software. Easily extend your pipeline with custom component resolver adapters."
	/>

	<div
		class="mt-4 sm:mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-4 grid-flow-dense"
	>
		<ContentCollections />

		<ZeroJS />

		<ViewTransitions />

		<ImageOptimization />

		<Card
			title="UI Integrations"
			href="#docs"
			description="Bring your favorite UI frameworks and component libraries with Piplex's flexible island architecture."
			flip
		>
			<div
				class="px-4 pb-4 xl:px-6 flex gap-4 xl:gap-6 items-center grayscale opacity-65 group-hocus:opacity-100 group-hocus:grayscale-0 transition duration-500"
			>
				{
					[
						{ name: 'React', icon: 'logos/react-logomark' },
						{ name: 'Vue', icon: 'logos/vue-logomark' },
						{ name: 'Svelte', icon: 'logos/svelte-logomark' },
						{ name: 'Angular', icon: 'logos/angular' },
						{ name: 'Preact', icon: 'logos/preact-logomark' },
						{ name: 'Solid', icon: 'logos/solidjs-icon' },
						{ name: 'Qwik', icon: 'logos/qwik' },
					].map(({ name, icon }) => (
						<>
							<Icon name={icon} class="w-7 h-auto" aria-hidden="true" />
							<span class="sr-only">{name}</span>
						</>
					))
				}
			</div>
		</Card>

		<FileBasedRouting />

		<Card
			title="Middleware"
			href="#docs"
			description="Wrap incoming monolithic requests with custom logic like authentication checks, permissions, or session states."
		/>

		<Card
			title="Actions"
			href="#docs"
			description="Call backend PHP controllers and models directly from your client-side JavaScript/UI framework functions."
		/>

		<Card
			title="Platform Compatibility"
			href="#docs"
			description="Deploy anywhere. Seamlessly runs inside WHMCS, WordPress plugins, standard cPanel hosts, or modern server infrastructures."
			flip
		>
			<div
				class="px-4 pb-4 xl:px-6 flex gap-4 xl:gap-6 items-center grayscale opacity-65 group-hocus:opacity-100 group-hocus:grayscale-0 transition duration-500"
			>
				{
					[
						{ name: 'Node.js', icon: 'logos/node' },
						{ name: 'Cloudflare', icon: 'logos/cloudflare-logomark' },
						{ name: 'Vercel', icon: 'logos/vercel-logomark' },
						{ name: 'Netlify', icon: 'logos/netlify-logomark' },
						{ name: 'SST', icon: 'logos/sst' },
						{ name: 'Deno', icon: 'logos/deno' },
						{ name: 'AWS', icon: 'logos/aws' },
					].map(({ name, icon }) => (
						<>
							<Icon name={icon} class="w-7 h-auto" aria-hidden="true" />
							<span class="sr-only">{name}</span>
						</>
					))
				}
			</div>
		</Card>

		<ServerTemplating />

		<Card
			title="Instant Page Loads"
			href="#docs"
			description="Optimize page loading with intelligent automatic prefetching. Pick from the built-in presets or tailor a strategy perfect for your site."
		/>

		<Card
			title="AI-Ready"
			href="#docs"
			description="Integrate Piplex's compiler context with your favorite AI assistants and IDE tools for a best-in-class coding workflow."
		/>

		<Card
			title="Environment Variables"
			href="#docs"
			description="Avoid common configuration mistakes with a built-in API to manage your environment variables."
		/>

		<Card
			title="Dev Watcher"
			href="#docs"
			description="Run the native file watcher daemon locally to recompile template changes and sync assets in under 500ms."
		/>
	</div>
</section>
