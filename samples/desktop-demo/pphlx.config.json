{
  "srcDir": "src",
  "outDir": "dist",
  "cssOut": "dist/assets/css/app.css",
  "jsOut": "dist/assets/js/app.js",
  "output": {
    "target": "desktop"
  },
  "environments": {
    "web": {
      "outDir": "dist/web",
      "output": { "target": "php" }
    },
    "desktop": {
      "outDir": "dist/desktop",
      "output": { "target": "desktop" }
    },
    "android": {
      "outDir": "dist/android",
      "output": { "target": "android" }
    }
  }
}
